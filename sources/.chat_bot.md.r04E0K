`endif`
`if @err_CSP_V09_Q10 == 1`
<tr><td data-label="Question"><strong>10.</strong> L&#x27;autorité judiciaire est exercée par :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTEw">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Les juges.</td><td data-label="Explication courte">Les juges rendent la justice de manière indépendante. Ils appliquent la loi et prennent des décisions en fonction des affaires qui leur sont soumises.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1ExMA==">Cours : Autorité judiciaire</a></td></tr>
`endif`
`if @err_CSP_V09_Q11 == 1`
<tr><td data-label="Question"><strong>11.</strong> Concernant les droits individuels, quelle proposition est correcte ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTEx">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Les droits individuels sont garantis à chacun dans le respect de la loi.</td><td data-label="Explication courte">Les droits individuels sont protégés en France. Ils s&#x27;exercent dans le respect de la loi et des droits des autres.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1ExMQ==">Cours : Respect</a><br><a href="#U0NSX0dMT18wMTc0">Glossaire : Respect</a></td></tr>
`endif`
`if @err_CSP_V09_Q12 == 1`
<tr><td data-label="Question"><strong>12.</strong> De quelle année date la Déclaration des droits de l&#x27;homme et du citoyen ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTEy">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — 1789.</td><td data-label="Explication courte">La Déclaration des droits de l&#x27;homme et du citoyen a été adoptée en 1789 pendant la Révolution française. Elle constitue l&#x27;un des textes fondateurs de la République.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1ExMg==">Cours : Droits fondamentaux</a><br><a href="#U0NSX0dMT18wMDQ3">Glossaire : Droits fondamentaux</a><br><a href="#U0NSX0dMT18wMDM4">Glossaire : Déclaration des droits de l&#x27;homme et du citoyen</a></td></tr>
`endif`
`if @err_CSP_V09_Q13 == 1`
<tr><td data-label="Question"><strong>13.</strong> Lequel de ces droits est un droit fondamental ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTEz">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Le droit à la liberté d&#x27;expression.</td><td data-label="Explication courte">La liberté d&#x27;expression est un droit fondamental reconnu en France. Elle s&#x27;exerce dans le respect de la loi et des droits des autres.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1ExMw==">Cours : Droits fondamentaux</a><br><a href="#U0NSX0dMT18wMDQ3">Glossaire : Droits fondamentaux</a><br><a href="#U0NSX0dMT18wMjEz">Glossaire : Liberté d’expression</a></td></tr>
`endif`
`if @err_CSP_V09_Q14 == 1`
<tr><td data-label="Question"><strong>14.</strong> Parmi ces textes, lequel garantit les droits et libertés en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTE0">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — La Constitution et son bloc de constitutionnalité.</td><td data-label="Explication courte">La Constitution est la norme juridique la plus élevée en France. Son bloc de constitutionnalité comprend notamment la Déclaration des droits de l&#x27;homme et du citoyen de 1789 et protège les droits et libertés fondamentaux.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1ExNA==">Cours : Bloc de constitutionnalité</a><br><a href="#U0NSX0dMT18wMjE5">Glossaire : Bloc de constitutionnalité</a><br><a href="#U0NSX0dMT18wMDMy">Glossaire : Constitution</a></td></tr>
`endif`
`if @err_CSP_V09_Q15 == 1`
<tr><td data-label="Question"><strong>15.</strong> Sur quel continent se situe la France métropolitaine ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTE1">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — L&#x27;Europe.</td><td data-label="Explication courte">La France métropolitaine est située en Europe occidentale.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1ExNQ==">Cours : France métropolitaine</a><br><a href="#U0NSX0dMT18wMDU4">Glossaire : France métropolitaine</a></td></tr>
`endif`
`if @err_CSP_V09_Q16 == 1`
<tr><td data-label="Question"><strong>16.</strong> Quelle île est un département d&#x27;outre-mer français ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTE2">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — La Réunion.</td><td data-label="Explication courte">La Réunion est un département et une région d&#x27;outre-mer français situé dans l&#x27;océan Indien.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1ExNg==">Cours : Outre-mer</a><br><a href="#U0NSX0dMT18wMTAw">Glossaire : Outre-mer</a><br><a href="#U0NSX0dMT18wMDQx">Glossaire : Département</a></td></tr>
`endif`
`if @err_CSP_V09_Q17 == 1`
<tr><td data-label="Question"><strong>17.</strong> Combien y a-t-il de régions en France métropolitaine ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTE3">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — 13.</td><td data-label="Explication courte">Depuis la réforme territoriale de 2016, la France métropolitaine compte 13 régions.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1ExNw==">Cours : France métropolitaine</a><br><a href="#U0NSX0dMT18wMDU4">Glossaire : France métropolitaine</a><br><a href="#U0NSX0dMT18wMTE3">Glossaire : Région</a></td></tr>
`endif`
`if @err_CSP_V09_Q18 == 1`
<tr><td data-label="Question"><strong>18.</strong> Quelle ville est un grand port maritime ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTE4">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Marseille.</td><td data-label="Explication courte">La France possède plusieurs grands ports maritimes qui jouent un rôle essentiel dans le commerce et les transports (Marseille, Le Havre, Dunkerque, Nantes-Saint-Nazaire).</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1ExOA==">Cours : Provence-Alpes-Côte d&#x27;Azur</a><br><a href="#U0NSX0dMT18wMTE0">Glossaire : Provence-Alpes-Côte d&#x27;Azur</a></td></tr>
`endif`
`if @err_CSP_V09_Q19 == 1`
<tr><td data-label="Question"><strong>19.</strong> Quelle est la mer au sud de la France métropolitaine ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTE5">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — La mer Méditerranée.</td><td data-label="Explication courte">Le sud de la France métropolitaine est bordé par la mer Méditerranée.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1ExOQ==">Cours : France métropolitaine</a><br><a href="#U0NSX0dMT18wMDU4">Glossaire : France métropolitaine</a><br><a href="#U0NSX0dMT18wMjAz">Glossaire : Méditerranée</a></td></tr>
