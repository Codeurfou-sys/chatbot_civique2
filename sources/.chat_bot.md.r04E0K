`endif`
`if @err_CR_V03_Q09 == 1`
<tr><td data-label="Question"><strong>9.</strong> Quelle île française se trouve dans l&#x27;océan Indien ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMDk=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — La Réunion.</td><td data-label="Explication courte">La Réunion est un département et une région d&#x27;outre-mer situé dans l&#x27;océan Indien, à l&#x27;est de Madagascar.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTA5">Cours : La Réunion</a><br><a href="#U0NSX0dMT18wMDc5">Glossaire : La Réunion</a></td></tr>
`endif`
`if @err_CR_V03_Q10 == 1`
<tr><td data-label="Question"><strong>10.</strong> À qui est accessible la contraception ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMTA=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — À toute personne qui en a besoin.</td><td data-label="Explication courte">En France, la contraception est accessible à toute personne qui en a besoin. Elle permet de choisir librement si et quand avoir un enfant.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTEw">Cours : Contraception</a></td></tr>
`endif`
`if @err_CR_V03_Q11 == 1`
<tr><td data-label="Question"><strong>11.</strong> Qu&#x27;est-ce que le principe de confidentialité dans le domaine de la santé ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMTE=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Les informations médicales d&#x27;un patient sont protégées par le secret médical.</td><td data-label="Explication courte">Le secret médical protège la vie privée des patients. Les professionnels de santé doivent respecter la confidentialité des informations qu&#x27;ils connaissent dans l&#x27;exercice de leur métier.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTEx">Cours : Confidentialité des informations médicales</a></td></tr>
`endif`
`if @err_CR_V03_Q12 == 1`
<tr><td data-label="Question"><strong>12.</strong> L&#x27;inscription à l&#x27;Assurance maladie est :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMTI=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Obligatoire.</td><td data-label="Explication courte">L&#x27;Assurance maladie est un élément essentiel du système de protection sociale français. Les personnes qui remplissent les conditions prévues doivent y être affiliées.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTEy">Cours : Assurance maladie</a><br><a href="#U0NSX0dMT18wMDA2">Glossaire : Assurance maladie</a></td></tr>
`endif`
`if @err_CR_V03_Q13 == 1`
<tr><td data-label="Question"><strong>13.</strong> Qui peut demander un congé parental d&#x27;éducation ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMTM=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Le père ou la mère.</td><td data-label="Explication courte">Le congé parental permet à un parent de réduire ou de suspendre temporairement son activité professionnelle pour s&#x27;occuper de son enfant.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTEz">Cours : Congé parental</a></td></tr>
`endif`
`if @err_CR_V03_Q14 == 1`
<tr><td data-label="Question"><strong>14.</strong> Quelles sont les affaires traitées par le conseil de prud&#x27;hommes ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMTQ=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Les conflits entre un salarié et son employeur.</td><td data-label="Explication courte">Le conseil de prud&#x27;hommes est un tribunal spécialisé qui traite les litiges individuels liés au contrat de travail entre salariés et employeurs.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTE0">Cours : Employeur</a><br><a href="#U0NSX0dMT18wMDUx">Glossaire : Employeur</a><br><a href="#U0NSX0dMT18wMTQy">Glossaire : Salarié</a></td></tr>
`endif`
`if @err_CR_V03_Q15 == 1`
<tr><td data-label="Question"><strong>15.</strong> Concernant la pratique de la religion, quelle proposition est correcte ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMTU=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Chacun est libre de pratiquer sa religion.</td><td data-label="Explication courte">La liberté religieuse est garantie en France. Chacun est libre de croire, de pratiquer sa religion ou de ne pas avoir de religion, dans le respect de la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTE1">Cours : Religion</a><br><a href="#U0NSX0dMT18wMTc1">Glossaire : Religion</a></td></tr>
`endif`
`if @err_CR_V03_Q16 == 1`
<tr><td data-label="Question"><strong>16.</strong> En tant que parent, peut-on refuser que son enfant participe aux cours de sport à l&#x27;école parce qu&#x27;ils sont mixtes ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMTY=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Non.</td><td data-label="Explication courte">Les cours de sport font partie des enseignements obligatoires. La mixité entre les filles et les garçons est un principe de l&#x27;école de la République.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTE2">Cours : École</a><br><a href="#U0NSX0dMT18wMDQ4">Glossaire : École</a></td></tr>
`endif`
`if @err_CR_V03_Q17 == 1`
<tr><td data-label="Question"><strong>17.</strong> Quelle est la devise de la France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMTc=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Liberté, Égalité, Fraternité.</td><td data-label="Explication courte">La devise de la République française est « Liberté, Égalité, Fraternité ». Elle exprime les valeurs fondamentales de la République.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTE3">Cours : Devise</a><br><a href="#U0NSX0dMT18wMjE3">Glossaire : Devise</a><br><a href="#U0NSX0dMT18wMDQ0">Glossaire : Devise de la République</a></td></tr>
`endif`
`if @err_CR_V03_Q18 == 1`
<tr><td data-label="Question"><strong>18.</strong> La répudiation de sa femme est :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMTg=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Interdite par la loi française.</td><td data-label="Explication courte">En France, les femmes et les hommes disposent des mêmes droits. La répudiation n&#x27;est pas reconnue par le droit français.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTE4">Cours : La répudiation de sa femme est :</a></td></tr>
`endif`
`if @err_CR_V03_Q19 == 1`
<tr><td data-label="Question"><strong>19.</strong> Pourquoi séparer les trois pouvoirs dans une démocratie ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMTk=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Pour éviter qu&#x27;une seule personne ou qu&#x27;un seul pouvoir concentre tous les pouvoirs.</td><td data-label="Explication courte">La démocratie repose sur la séparation des pouvoirs exécutif, législatif et judiciaire afin de garantir les libertés et d&#x27;éviter les abus de pouvoir.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTE5">Cours : Démocratie</a><br><a href="#U0NSX0dMT18wMDQw">Glossaire : Démocratie</a></td></tr>
`endif`
`if @err_CR_V03_Q20 == 1`
<tr><td data-label="Question"><strong>20.</strong> Qui sanctionne l&#x27;auteur d&#x27;un vol ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMjA=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Le juge.</td><td data-label="Explication courte">La police enquête sur les infractions, mais c&#x27;est le juge qui décide de la sanction dans le respect de la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTIw">Cours : Juge</a><br><a href="#U0NSX0dMT18wMTgw">Glossaire : Juge</a></td></tr>
`endif`
`if @err_CR_V03_Q21 == 1`
<tr><td data-label="Question"><strong>21.</strong> Quel est le rôle du gouvernement ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMjE=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Déterminer et conduire la politique de la Nation.</td><td data-label="Explication courte">Le gouvernement met en œuvre les politiques publiques et veille à l&#x27;application des lois. Il est dirigé par le Premier ministre.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTIx">Cours : Gouvernement</a><br><a href="#U0NSX0dMT18wMDY2">Glossaire : Gouvernement</a></td></tr>
`endif`
`if @err_CR_V03_Q22 == 1`
<tr><td data-label="Question"><strong>22.</strong> Que se passe-t-il si un ministre ne respecte pas la loi ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMjI=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Il peut être poursuivi et sanctionné par la justice.</td><td data-label="Explication courte">En France, les membres du gouvernement doivent respecter la loi. Ils ne sont pas au-dessus des lois et peuvent être tenus responsables de leurs actes.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTIy">Cours : Ministre</a><br><a href="#U0NSX0dMT18wMDkz">Glossaire : Ministre</a><br><a href="#U0NSX0dMT18wMDc3">Glossaire : Justice</a></td></tr>
`endif`
`if @err_CR_V03_Q23 == 1`
<tr><td data-label="Question"><strong>23.</strong> Combien de députés composent l&#x27;Assemblée nationale ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMjM=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — 577.</td><td data-label="Explication courte">L&#x27;Assemblée nationale est composée de 577 députés élus au suffrage universel direct.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTIz">Cours : Assemblée nationale</a><br><a href="#U0NSX0dMT18wMDA0">Glossaire : Assemblée nationale</a><br><a href="#U0NSX0dMT18wMDQy">Glossaire : Député</a></td></tr>
`endif`
`if @err_CR_V03_Q24 == 1`
<tr><td data-label="Question"><strong>24.</strong> Qui peut voter aux élections en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMjQ=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Les citoyens français inscrits sur les listes électorales.</td><td data-label="Explication courte">Pour voter aux élections nationales en France, il faut être citoyen français, être majeur et être inscrit sur les listes électorales.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTI0">Cours : Vote</a><br><a href="#U0NSX0dMT18wMTM3">Glossaire : Vote</a><br><a href="#U0NSX0dMT18wMDUw">Glossaire : Élection</a></td></tr>
`endif`
`if @err_CR_V03_Q25 == 1`
<tr><td data-label="Question"><strong>25.</strong> Que garantit la liberté de la presse ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMjU=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Le droit d&#x27;informer et d&#x27;être informé.</td><td data-label="Explication courte">La liberté de la presse permet aux journalistes d&#x27;informer le public. Elle s&#x27;exerce dans le respect de la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTI1">Cours : Liberté de presse</a></td></tr>
`endif`
`if @err_CR_V03_Q26 == 1`
<tr><td data-label="Question"><strong>26.</strong> Que prévoit la Charte de l&#x27;environnement ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMjY=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Chacun a le devoir de prendre part à la préservation et à l&#x27;amélioration de l&#x27;environnement.</td><td data-label="Explication courte">La Charte de l&#x27;environnement, intégrée à la Constitution, rappelle que chacun a des droits mais aussi des devoirs pour protéger l&#x27;environnement.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTI2">Cours : Charte de l&#x27;environnement</a><br><a href="#U0NSX0dMT18wMDE2">Glossaire : Charte de l&#x27;environnement</a><br><a href="#U0NSX0dMT18wMDUy">Glossaire : Environnement</a></td></tr>
`endif`
`if @err_CR_V03_Q27 == 1`
<tr><td data-label="Question"><strong>27.</strong> Que signifie la dignité humaine ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMjc=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Que chaque personne doit être respectée et traitée avec respect.</td><td data-label="Explication courte">La dignité humaine est un principe fondamental de la République française. Chaque personne doit être traitée avec respect et bénéficie des mêmes droits fondamentaux.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTI3">Cours : Dignité humaine</a><br><a href="#U0NSX0dMT18wMDQ1">Glossaire : Dignité humaine</a><br><a href="#U0NSX0dMT18wMTc0">Glossaire : Respect</a></td></tr>
`endif`
`if @err_CR_V03_Q28 == 1`
<tr><td data-label="Question"><strong>28.</strong> Que signifie le droit de manifester ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMjg=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Le droit d&#x27;exprimer collectivement une opinion dans le respect de la loi.</td><td data-label="Explication courte">Le droit de manifester est une liberté fondamentale. Il s&#x27;exerce dans le respect des lois, de la sécurité et des droits des autres.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTI4">Cours : Opinion</a><br><a href="#U0NSX0dMT18wMTc2">Glossaire : Opinion</a><br><a href="#U0NSX0dMT18wMTc0">Glossaire : Respect</a></td></tr>
`endif`
</tbody></table>
`endif`
`if @err_CR_V03_Q29 == 1 || @err_CR_V03_Q30 == 1 || @err_CR_V03_Q31 == 1 || @err_CR_V03_Q32 == 1 || @err_CR_V03_Q33 == 1 || @err_CR_V03_Q34 == 1 || @err_CR_V03_Q35 == 1 || @err_CR_V03_Q36 == 1 || @err_CR_V03_Q37 == 1 || @err_CR_V03_Q38 == 1 || @err_CR_V03_Q39 == 1 || @err_CR_V03_Q40 == 1`
#### Mises en situation
<table class="v13-errors"><thead><tr><th>Question</th><th>Réponse correcte</th><th>Explication courte</th><th>Notion à revoir</th></tr></thead><tbody>
`if @err_CR_V03_Q29 == 1`
<tr><td data-label="Question"><strong>29.</strong> Quelle est cette année ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMjk=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — 1914.</td><td data-label="Explication courte">La Première Guerre mondiale débute en 1914 et se termine en 1918.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTI5">Cours : Première Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTA4">Glossaire : Première Guerre mondiale</a></td></tr>
`endif`
`if @err_CR_V03_Q30 == 1`
<tr><td data-label="Question"><strong>30.</strong> Quelle réponse choisissez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMzA=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — La liberté de conscience et l&#x27;égalité de tous devant la loi.</td><td data-label="Explication courte">La laïcité protège la liberté de conscience de chacun et garantit que toutes les personnes sont traitées de manière égale, quelles que soient leurs convictions.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTMw">Cours : Laïcité</a><br><a href="#U0NSX0dMT18wMDgw">Glossaire : Laïcité</a><br><a href="#U0NSX0dMT18wMDgz">Glossaire : Liberté de conscience</a></td></tr>
`endif`
`if @err_CR_V03_Q31 == 1`
<tr><td data-label="Question"><strong>31.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMzE=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Elle est interdite.</td><td data-label="Explication courte">La peine de mort a été abolie en France en 1981.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTMx">Cours : Peine de mort</a><br><a href="#U0NSX0dMT18wMTg0">Glossaire : Peine de mort</a></td></tr>
`endif`
`if @err_CR_V03_Q32 == 1`
<tr><td data-label="Question"><strong>32.</strong> Quel mariage est réellement reconnu par l&#x27;État français ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMzI=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Le mariage civil.</td><td data-label="Explication courte">En France, seul le mariage civil célébré devant un officier d&#x27;état civil produit des effets juridiques. Une cérémonie religieuse peut être organisée ensuite, mais elle ne remplace pas le mariage civil.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTMy">Cours : Mariage civil</a></td></tr>
`endif`
`if @err_CR_V03_Q33 == 1`
<tr><td data-label="Question"><strong>33.</strong> Pourquoi doit-on réellement trier ses déchets ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMzM=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Pour protéger l&#x27;environnement et favoriser le recyclage.</td><td data-label="Explication courte">Le tri permet de recycler de nombreux matériaux, de limiter les déchets et de préserver les ressources naturelles, bien au-delà du simple confort ménager.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTMz">Cours : Déchets</a><br><a href="#U0NSX0dMT18wMTg2">Glossaire : Déchets</a><br><a href="#U0NSX0dMT18wMDUy">Glossaire : Environnement</a></td></tr>
`endif`
`if @err_CR_V03_Q34 == 1`
<tr><td data-label="Question"><strong>34.</strong> De quelle organisation s&#x27;agit-il ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMzQ=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — L&#x27;Organisation des Nations unies (ONU).</td><td data-label="Explication courte">L&#x27;ONU a été créée après la Seconde Guerre mondiale afin de maintenir la paix, promouvoir les droits humains et encourager la coopération internationale.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTM0">Cours : Seconde Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTIx">Glossaire : Seconde Guerre mondiale</a></td></tr>
`endif`
`if @err_CR_V03_Q35 == 1`
<tr><td data-label="Question"><strong>35.</strong> Sur quel document officiel peut-on couramment voir ce visage, celui de Marianne ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMzU=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Les timbres-poste.</td><td data-label="Explication courte">Marianne, symbole de la République française, figure notamment sur les timbres-poste français, ainsi que dans de nombreuses mairies sous forme de buste. Elle n&#x27;apparaît pas sur le permis de conduire, une facture ou le passeport.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTM1">Cours : Marianne</a><br><a href="#U0NSX0dMT18wMDg5">Glossaire : Marianne</a></td></tr>
`endif`
`if @err_CR_V03_Q36 == 1`
<tr><td data-label="Question"><strong>36.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMzY=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Depuis 2002.</td><td data-label="Explication courte">L&#x27;euro est utilisé sous forme de pièces et de billets depuis le 1er janvier 2002.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTM2">Cours : Euro</a><br><a href="#U0NSX0dMT18wMDU1">Glossaire : Euro</a></td></tr>
`endif`
`if @err_CR_V03_Q37 == 1`
<tr><td data-label="Question"><strong>37.</strong> Lequel de ces peintres est français ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMzc=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Auguste Renoir.</td><td data-label="Explication courte">Auguste Renoir est un peintre français majeur du mouvement impressionniste. Il est connu pour ses portraits et ses scènes de la vie quotidienne.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTM3">Cours : Renoir</a></td></tr>
`endif`
`if @err_CR_V03_Q38 == 1`
<tr><td data-label="Question"><strong>38.</strong> De quoi le Parlement est-il réellement composé ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMzg=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — De l&#x27;Assemblée nationale et du Sénat.</td><td data-label="Explication courte">Le Parlement français est composé de deux chambres : l&#x27;Assemblée nationale et le Sénat. Ensemble, elles discutent et votent les lois, indépendamment du pouvoir exécutif.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTM4">Cours : Parlement</a><br><a href="#U0NSX0dMT18wMTAx">Glossaire : Parlement</a><br><a href="#U0NSX0dMT18wMDA0">Glossaire : Assemblée nationale</a></td></tr>
`endif`
`if @err_CR_V03_Q39 == 1`
<tr><td data-label="Question"><strong>39.</strong> Quelle réponse est correcte ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RMzk=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Le pouvoir exécutif, le pouvoir législatif et le pouvoir judiciaire.</td><td data-label="Explication courte">La séparation des pouvoirs assure un équilibre entre les institutions : le pouvoir exécutif gouverne, le pouvoir législatif vote les lois et le pouvoir judiciaire rend la justice.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTM5">Cours : Séparation des pouvoirs</a><br><a href="#U0NSX0dMT18wMjEx">Glossaire : Séparation des pouvoirs</a><br><a href="#U0NSX0dMT18wMTYx">Glossaire : Pouvoir exécutif</a></td></tr>
`endif`
`if @err_CR_V03_Q40 == 1`
<tr><td data-label="Question"><strong>40.</strong> Que leur autorise le droit de grève ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwM19RNDA=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — À cesser collectivement le travail pour défendre leurs revendications professionnelles.</td><td data-label="Explication courte">Le droit de grève est une liberté reconnue par la Constitution. Il permet aux salariés de cesser collectivement le travail pour défendre leurs intérêts professionnels, dans le respect des règles applicables.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDNfUTQw">Cours : Entreprise</a><br><a href="#U0NSX0dMT18wMTQz">Glossaire : Entreprise</a><br><a href="#U0NSX0dMT18wMTQ2">Glossaire : Grève</a></td></tr>
`endif`
</tbody></table>
`endif`
