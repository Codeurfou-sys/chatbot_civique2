`if @err_NAT_V08_Q07 == 1`
<tr><td data-label="Question"><strong>7.</strong> Que peuvent faire les parents d&#x27;élèves au sein de l&#x27;école ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDhfUTA3">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Participer à la vie de l&#x27;école et élire leurs représentants.</td><td data-label="Explication courte">Les parents d&#x27;élèves sont des partenaires de l&#x27;école. Ils peuvent participer aux réunions, échanger avec les enseignants et élire leurs représentants dans les conseils d&#x27;école ou d&#x27;administration.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA4X1EwNw==">Cours : École</a><br><a href="#U0NSX0dMT18wMDQ4">Glossaire : École</a></td></tr>
`endif`
`if @err_NAT_V08_Q08 == 1`
<tr><td data-label="Question"><strong>8.</strong> Que garantit le principe de laïcité ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDhfUTA4">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — La liberté de conscience, l&#x27;égalité de tous devant la loi et la neutralité de l&#x27;État.</td><td data-label="Explication courte">La laïcité garantit à chacun la liberté de croire ou de ne pas croire. Elle assure également la neutralité de l&#x27;État et l&#x27;égalité entre tous les citoyens.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA4X1EwOA==">Cours : Laïcité</a><br><a href="#U0NSX0dMT18wMDgw">Glossaire : Laïcité</a><br><a href="#U0NSX0dMT18wMDgz">Glossaire : Liberté de conscience</a></td></tr>
