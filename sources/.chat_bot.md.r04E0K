`if @err_NAT_V05_Q18 == 1`
<tr><td data-label="Question"><strong>18.</strong> Où est exposée la Joconde de Léonard de Vinci ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDVfUTE4">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Le musée du Louvre.</td><td data-label="Explication courte">La Joconde, peinte par Léonard de Vinci, est exposée au musée du Louvre, le plus grand musée de France et l&#x27;un des plus célèbres au monde.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA1X1ExOA==">Cours : Musée du Louvre</a><br><a href="#U0NSX0dMT18wMDk1">Glossaire : Musée du Louvre</a></td></tr>
`endif`
`if @err_NAT_V05_Q19 == 1`
<tr><td data-label="Question"><strong>19.</strong> Quel monument est la résidence royale développée par Louis XIV, le Roi-Soleil ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDVfUTE5">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Le château de Versailles.</td><td data-label="Explication courte">Le château de Versailles est la résidence royale développée par Louis XIV, le Roi-Soleil. Il est aujourd&#x27;hui l&#x27;un des monuments les plus visités de France.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA1X1ExOQ==">Cours : Château de Versailles</a><br><a href="#U0NSX0dMT18wMDE3">Glossaire : Château de Versailles</a></td></tr>
`endif`
`if @err_NAT_V05_Q20 == 1`
<tr><td data-label="Question"><strong>20.</strong> Où peut-on voir des peintures préhistoriques en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDVfUTIw">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Dans la grotte de Lascaux.</td><td data-label="Explication courte">La grotte de Lascaux, en Dordogne, est célèbre pour ses peintures rupestres datant d&#x27;environ 17 000 ans. Elle constitue l&#x27;un des plus grands témoignages de l&#x27;art préhistorique.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA1X1EyMA==">Cours : Peintures rupestres préhistoriques</a></td></tr>
`endif`
`if @err_NAT_V05_Q21 == 1`
<tr><td data-label="Question"><strong>21.</strong> Qui a peint la célèbre série des Nymphéas ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDVfUTIx">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Claude Monet.</td><td data-label="Explication courte">Les Nymphéas sont une série de tableaux réalisés par Claude Monet, l&#x27;un des principaux représentants de l&#x27;impressionnisme. Une grande partie est exposée au musée de l&#x27;Orangerie à Paris.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA1X1EyMQ==">Cours : Nymphéas</a></td></tr>
`endif`
`if @err_NAT_V05_Q22 == 1`
<tr><td data-label="Question"><strong>22.</strong> Quel événement permet chaque année de visiter gratuitement de nombreux monuments habituellement payants ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDVfUTIy">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Les Journées européennes du patrimoine.</td><td data-label="Explication courte">Chaque année, les Journées européennes du patrimoine ouvrent gratuitement au public des milliers de monuments, musées et bâtiments habituellement fermés ou payants.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA1X1EyMg==">Cours : Journées européennes du patrimoine</a><br><a href="#U0NSX0dMT18wMDc2">Glossaire : Journées européennes du patrimoine</a><br><a href="#U0NSX0dMT18wMTAz">Glossaire : Patrimoine</a></td></tr>
`endif`
`if @err_NAT_V05_Q23 == 1`
<tr><td data-label="Question"><strong>23.</strong> Que célèbre-t-on le 1er mai en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDVfUTIz">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — La fête du Travail.</td><td data-label="Explication courte">Le 1er mai est la fête du Travail. C&#x27;est un jour férié en France, associé aux droits des travailleurs. Il est également traditionnel d&#x27;offrir du muguet ce jour-là.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA1X1EyMw==">Cours : 1er mai</a></td></tr>
`endif`
`if @err_NAT_V05_Q24 == 1`
<tr><td data-label="Question"><strong>24.</strong> Une femme a-t-elle le droit de recourir à une interruption volontaire de grossesse (IVG) en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDVfUTI0">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Oui, dans les conditions prévues par la loi.</td><td data-label="Explication courte">En France, les femmes ont le droit de recourir à une IVG dans les conditions prévues par la loi. Depuis 2024, la liberté garantie à la femme de recourir à l&#x27;IVG est inscrite dans la Constitution.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA1X1EyNA==">Cours : IVG</a><br><a href="#U0NSX0dMT18wMTg1">Glossaire : IVG</a></td></tr>
`endif`
`if @err_NAT_V05_Q25 == 1`
<tr><td data-label="Question"><strong>25.</strong> Le travail non déclaré est :<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDVfUTI1">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Illégal (travail dissimulé).</td><td data-label="Explication courte">Le travail non déclaré, aussi appelé travail dissimulé, est interdit par la loi. Il prive le salarié de nombreux droits (protection sociale, retraite, assurance chômage...) et expose l&#x27;employeur à des sanctions.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA1X1EyNQ==">Cours : Travail dissimulé</a><br><a href="#U0NSX0dMT18wMTQ0">Glossaire : Travail dissimulé</a></td></tr>
`endif`
`if @err_NAT_V05_Q26 == 1`
<tr><td data-label="Question"><strong>26.</strong> Qu&#x27;est-ce que le SMIC ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDVfUTI2">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Le salaire minimum légal.</td><td data-label="Explication courte">Le SMIC (Salaire minimum interprofessionnel de croissance) fixe le salaire horaire minimum qu&#x27;un employeur doit verser à un salarié, sauf exceptions prévues par la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA1X1EyNg==">Cours : SMIC</a><br><a href="#U0NSX0dMT18wMTM4">Glossaire : SMIC</a><br><a href="#U0NSX0dMT18wMTIw">Glossaire : Salaire</a></td></tr>
`endif`
`if @err_NAT_V05_Q27 == 1`
