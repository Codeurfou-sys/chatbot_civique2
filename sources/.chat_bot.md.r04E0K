`if @err_CR_V02_Q30 == 1`
<tr><td data-label="Question"><strong>30.</strong> Que lui répondez-vous sur le principe de dignité humaine ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMzA=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Chaque personne doit être respectée et traitée avec dignité.</td><td data-label="Explication courte">La dignité humaine est un principe fondamental de la République française. Chaque personne doit être traitée avec respect et bénéficie des mêmes droits fondamentaux, quelle que soit son origine ou sa religion.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTMw">Cours : Dignité humaine</a><br><a href="#U0NSX0dMT18wMDQ1">Glossaire : Dignité humaine</a></td></tr>
`endif`
`if @err_CR_V02_Q31 == 1`
<tr><td data-label="Question"><strong>31.</strong> Pour quel motif peut-on réellement limiter la liberté d&#x27;expression ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMzE=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Pour protéger les droits d&#x27;autrui, l&#x27;ordre public ou lutter contre les infractions prévues par la loi.</td><td data-label="Explication courte">La liberté d&#x27;expression est un droit fondamental, mais elle ne permet pas d&#x27;insulter, de diffamer, de provoquer à la haine ou de commettre des infractions prévues par la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTMx">Cours : Liberté d’expression</a><br><a href="#U0NSX0dMT18wMjEz">Glossaire : Liberté d’expression</a><br><a href="#U0NSX0dMT18wMDk5">Glossaire : Ordre public</a></td></tr>
`endif`
`if @err_CR_V02_Q32 == 1`
<tr><td data-label="Question"><strong>32.</strong> Quel État a quitté l&#x27;Union européenne en 2020 ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMzI=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Le Royaume-Uni.</td><td data-label="Explication courte">Le Royaume-Uni a quitté officiellement l&#x27;Union européenne le 31 janvier 2020, un événement connu sous le nom de « Brexit ».</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTMy">Cours : Union européenne</a><br><a href="#U0NSX0dMT18wMTMz">Glossaire : Union européenne</a></td></tr>
`endif`
`if @err_CR_V02_Q33 == 1`
<tr><td data-label="Question"><strong>33.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMzM=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Le français est la langue de la République.</td><td data-label="Explication courte">L&#x27;article 2 de la Constitution dispose que « La langue de la République est le français ».</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTMz">Cours : Francophonie</a><br><a href="#U0NSX0dMT18wMDYx">Glossaire : Francophonie</a><br><a href="#U0NSX0dMT18wMDgx">Glossaire : Langue de la République</a></td></tr>
`endif`
`if @err_CR_V02_Q34 == 1`
<tr><td data-label="Question"><strong>34.</strong> De quel roi s&#x27;agit-il ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMzQ=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Louis XVI.</td><td data-label="Explication courte">Louis XVI a été condamné à mort et exécuté en 1793 pendant la Révolution française, après l&#x27;abolition de la monarchie.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTM0">Cours : Révolution française</a><br><a href="#U0NSX0dMT18wMTE5">Glossaire : Révolution française</a><br><a href="#U0NSX0dMT18wMjI4">Glossaire : Révolution</a></td></tr>
`endif`
`if @err_CR_V02_Q35 == 1`
<tr><td data-label="Question"><strong>35.</strong> Quelle est la condition réellement nécessaire pour voter ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMzU=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Être inscrit sur les listes électorales.</td><td data-label="Explication courte">Pour pouvoir voter, il faut remplir les conditions prévues par la loi, notamment être inscrit sur les listes électorales. Le passeport, le permis de conduire ou le statut professionnel n&#x27;ont pas d&#x27;incidence sur ce droit.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTM1">Cours : Vote</a><br><a href="#U0NSX0dMT18wMTM3">Glossaire : Vote</a><br><a href="#U0NSX0dMT18wMDUw">Glossaire : Élection</a></td></tr>
`endif`
`if @err_CR_V02_Q36 == 1`
<tr><td data-label="Question"><strong>36.</strong> Qui était-il ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMzY=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Un sculpteur français.</td><td data-label="Explication courte">Auguste Rodin est l&#x27;un des plus grands sculpteurs français. Parmi ses œuvres les plus connues figure Le Penseur.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTM2">Cours : Rodin</a></td></tr>
`endif`
`if @err_CR_V02_Q37 == 1`
<tr><td data-label="Question"><strong>37.</strong> Que pouvez-vous lui dire sur ce que fait la loi française face à ce type de discrimination ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMzc=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — La loi interdit les discriminations et les sanctionne.</td><td data-label="Explication courte">La loi protège chaque personne contre les discriminations fondées notamment sur l&#x27;origine, le sexe, la religion, le handicap ou l&#x27;orientation sexuelle, y compris dans l&#x27;accès au logement. Ces discriminations sont sanctionnées pénalement.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTM3">Cours : Discrimination</a><br><a href="#U0NSX0dMT18wMjEw">Glossaire : Discrimination</a><br><a href="#U0NSX0dMT18wMDQ5">Glossaire : Égalité</a></td></tr>
`endif`
`if @err_CR_V02_Q38 == 1`
<tr><td data-label="Question"><strong>38.</strong> De quelle couleur est le drapeau européen ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMzg=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Bleu.</td><td data-label="Explication courte">Le drapeau européen est bleu, avec un cercle de douze étoiles jaunes en son centre. Il ne doit pas être confondu avec le drapeau français, bleu-blanc-rouge.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTM4">Cours : Drapeau français</a><br><a href="#U0NSX0dMT18wMDQ2">Glossaire : Drapeau français</a></td></tr>
`endif`
`if @err_CR_V02_Q39 == 1`
<tr><td data-label="Question"><strong>39.</strong> Quel est l&#x27;âge de la majorité en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMzk=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — 18 ans.</td><td data-label="Explication courte">En France, la majorité est fixée à 18 ans. À partir de cet âge, une personne devient juridiquement majeure et exerce pleinement ses droits civils.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTM5">Cours : Majorité</a><br><a href="#U0NSX0dMT18wMjA4">Glossaire : Majorité</a></td></tr>
`endif`
`if @err_CR_V02_Q40 == 1`
<tr><td data-label="Question"><strong>40.</strong> Qu&#x27;est-ce que la France d&#x27;outre-mer ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RNDA=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Les territoires français situés en dehors de l&#x27;Europe.</td><td data-label="Explication courte">La France d&#x27;outre-mer regroupe les départements, régions, collectivités et territoires français situés en dehors de l&#x27;Europe, comme la Guadeloupe, La Réunion ou la Polynésie française.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTQw">Cours : Outre-mer</a><br><a href="#U0NSX0dMT18wMTAw">Glossaire : Outre-mer</a></td></tr>
`endif`
</tbody></table>
`endif`
