`if @err_CSP_V08_Q03 == 1`
<tr><td data-label="Question"><strong>3.</strong> Le travail non déclaré est :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTAz">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Interdit par la loi.</td><td data-label="Explication courte">Le travail non déclaré est interdit. Il prive notamment le salarié de ses droits sociaux (assurance maladie, retraite, chômage...).</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EwMw==">Cours : Travail non déclaré</a></td></tr>
`endif`
`if @err_CSP_V08_Q04 == 1`
<tr><td data-label="Question"><strong>4.</strong> Que doit faire un employeur pour fixer un salaire ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTA0">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Respecter au minimum le SMIC et la loi.</td><td data-label="Explication courte">En France, un employeur ne peut pas fixer un salaire inférieur au salaire minimum légal, sauf exceptions prévues par la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EwNA==">Cours : Employeur</a><br><a href="#U0NSX0dMT18wMDUx">Glossaire : Employeur</a><br><a href="#U0NSX0dMT18wMTIw">Glossaire : Salaire</a></td></tr>
`endif`
`if @err_CSP_V08_Q05 == 1`
<tr><td data-label="Question"><strong>5.</strong> Qu&#x27;est-ce que le SMIC ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTA1">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Le salaire minimum légal.</td><td data-label="Explication courte">Le SMIC est le salaire minimum qu&#x27;un employeur doit verser à un salarié, sauf exceptions prévues par la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EwNQ==">Cours : SMIC</a><br><a href="#U0NSX0dMT18wMTM4">Glossaire : SMIC</a><br><a href="#U0NSX0dMT18wMTIw">Glossaire : Salaire</a></td></tr>
`endif`
`if @err_CSP_V08_Q06 == 1`
<tr><td data-label="Question"><strong>6.</strong> Quelle est la première démarche à réaliser pour chercher un emploi ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTA2">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — S&#x27;inscrire à France Travail.</td><td data-label="Explication courte">France Travail accompagne les personnes dans leur recherche d&#x27;emploi et propose des offres, des formations et un suivi personnalisé.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EwNg==">Cours : France Travail</a><br><a href="#U0NSX0dMT18wMDYw">Glossaire : France Travail</a></td></tr>
`endif`
`if @err_CSP_V08_Q07 == 1`
<tr><td data-label="Question"><strong>7.</strong> Quelle est la durée légale du temps de travail par semaine ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTA3">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — 35 heures.</td><td data-label="Explication courte">En France, la durée légale du travail est fixée à 35 heures par semaine pour un salarié à temps complet. Des heures supplémentaires peuvent être effectuées dans les conditions prévues par la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EwNw==">Cours : Temps de travail</a><br><a href="#U0NSX0dMT18wMjQx">Glossaire : Temps de travail</a></td></tr>
`endif`
`if @err_CSP_V08_Q08 == 1`
<tr><td data-label="Question"><strong>8.</strong> Une personne peut-elle changer librement de religion ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTA4">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Oui, chacun est libre de choisir sa religion, d&#x27;en changer ou de ne pas en avoir.</td><td data-label="Explication courte">La liberté de conscience est un droit fondamental. Elle garantit à chacun la liberté de croire, de ne pas croire ou de changer de religion.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EwOA==">Cours : Liberté de conscience</a><br><a href="#U0NSX0dMT18wMDgz">Glossaire : Liberté de conscience</a><br><a href="#U0NSX0dMT18wMTc1">Glossaire : Religion</a></td></tr>
`endif`
`if @err_CSP_V08_Q09 == 1`
<tr><td data-label="Question"><strong>9.</strong> « La France est une République indivisible, ..., démocratique et sociale. » Quel mot complète correctement l&#x27;article 1er de la Constitution ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTA5">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Laïque.</td><td data-label="Explication courte">La Constitution affirme que la France est une République indivisible, laïque, démocratique et sociale.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EwOQ==">Cours : Constitution</a><br><a href="#U0NSX0dMT18wMDMy">Glossaire : Constitution</a><br><a href="#U0NSX0dMT18wMDQw">Glossaire : Démocratie</a></td></tr>
`endif`
`if @err_CSP_V08_Q10 == 1`
<tr><td data-label="Question"><strong>10.</strong> En quelle année la loi de séparation des Églises et de l&#x27;État a-t-elle été votée ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTEw">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — 1905.</td><td data-label="Explication courte">La loi du 9 décembre 1905 garantit la séparation des Églises et de l&#x27;État. Elle constitue l&#x27;un des fondements de la laïcité en France.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1ExMA==">Cours : Laïcité</a><br><a href="#U0NSX0dMT18wMDgw">Glossaire : Laïcité</a></td></tr>
`endif`
`if @err_CSP_V08_Q11 == 1`
<tr><td data-label="Question"><strong>11.</strong> Que permet le principe de laïcité ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTEx">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — La liberté de conscience : chacun est libre de croire ou de ne pas croire.</td><td data-label="Explication courte">La laïcité protège la liberté de conscience. Elle permet à chacun de pratiquer une religion, d&#x27;en changer ou de ne pas en avoir, dans le respect de la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1ExMQ==">Cours : Laïcité</a><br><a href="#U0NSX0dMT18wMDgw">Glossaire : Laïcité</a><br><a href="#U0NSX0dMT18wMDgz">Glossaire : Liberté de conscience</a></td></tr>
`endif`
`if @err_CSP_V08_Q12 == 1`
<tr><td data-label="Question"><strong>12.</strong> Quelle est la monnaie utilisée en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTEy">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — L&#x27;euro.</td><td data-label="Explication courte">Depuis 2002, la monnaie utilisée en France est l&#x27;euro.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1ExMg==">Cours : Euro</a><br><a href="#U0NSX0dMT18wMDU1">Glossaire : Euro</a></td></tr>
`endif`
`if @err_CSP_V08_Q13 == 1`
<tr><td data-label="Question"><strong>13.</strong> Qui élit les députés européens ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTEz">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Les citoyens.</td><td data-label="Explication courte">Les députés européens sont élus au suffrage universel direct par les citoyens de chaque État membre de l&#x27;Union européenne.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1ExMw==">Cours : Député européen</a><br><a href="#U0NSX0dMT18wMDQz">Glossaire : Député européen</a><br><a href="#U0NSX0dMT18wMDQy">Glossaire : Député</a></td></tr>
`endif`
`if @err_CSP_V08_Q14 == 1`
<tr><td data-label="Question"><strong>14.</strong> Quand célèbre-t-on la journée de l&#x27;Europe ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTE0">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Le 9 mai.</td><td data-label="Explication courte">La Journée de l&#x27;Europe est célébrée chaque année le 9 mai. Elle commémore la déclaration de Robert Schuman de 1950, considérée comme l&#x27;acte fondateur de la construction européenne.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1ExNA==">Cours : Journée de l’Europe</a><br><a href="#U0NSX0dMT18wMjA3">Glossaire : Journée de l’Europe</a></td></tr>
`endif`
`if @err_CSP_V08_Q15 == 1`
<tr><td data-label="Question"><strong>15.</strong> Qui nomme le Premier ministre ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTE1">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Le président de la République.</td><td data-label="Explication courte">Le président de la République nomme le Premier ministre. Celui-ci dirige ensuite l&#x27;action du gouvernement.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1ExNQ==">Cours : Premier ministre</a><br><a href="#U0NSX0dMT18wMTA3">Glossaire : Premier ministre</a><br><a href="#U0NSX0dMT18wMDkz">Glossaire : Ministre</a></td></tr>
`endif`
`if @err_CSP_V08_Q16 == 1`
<tr><td data-label="Question"><strong>16.</strong> Le Parlement est composé :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTE2">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — De l&#x27;Assemblée nationale et du Sénat.</td><td data-label="Explication courte">Le Parlement français est composé de deux chambres : l&#x27;Assemblée nationale et le Sénat. Ensemble, elles examinent et votent les lois.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1ExNg==">Cours : Parlement</a><br><a href="#U0NSX0dMT18wMTAx">Glossaire : Parlement</a><br><a href="#U0NSX0dMT18wMDA0">Glossaire : Assemblée nationale</a></td></tr>
`endif`
`if @err_CSP_V08_Q17 == 1`
<tr><td data-label="Question"><strong>17.</strong> Qu&#x27;est-ce que le pouvoir exécutif ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTE3">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Il met en œuvre les lois et dirige l&#x27;action du gouvernement.</td><td data-label="Explication courte">Le pouvoir exécutif est chargé de mettre en œuvre les lois votées par le Parlement et d&#x27;assurer la conduite des affaires de l&#x27;État.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1ExNw==">Cours : Pouvoir exécutif</a><br><a href="#U0NSX0dMT18wMTYx">Glossaire : Pouvoir exécutif</a><br><a href="#U0NSX0dMT18wMDY2">Glossaire : Gouvernement</a></td></tr>
`endif`
`if @err_CSP_V08_Q18 == 1`
<tr><td data-label="Question"><strong>18.</strong> Que doit faire une victime de violences ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTE4">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Alerter les secours ou les forces de l&#x27;ordre et demander de l&#x27;aide.</td><td data-label="Explication courte">Toute victime de violences doit être protégée. Elle peut contacter la police, la gendarmerie ou les services spécialisés pour obtenir de l&#x27;aide.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1ExOA==">Cours : Violence</a><br><a href="#U0NSX0dMT18wMTM2">Glossaire : Violence</a><br><a href="#U0NSX0dMT18wMDA1">Glossaire : Assistance à personne en danger</a></td></tr>
`endif`
`if @err_CSP_V08_Q19 == 1`
<tr><td data-label="Question"><strong>19.</strong> Quelle est l&#x27;infraction la plus grave ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTE5">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Un crime.</td><td data-label="Explication courte">En droit français, les infractions sont classées en trois catégories : les contraventions, les délits et les crimes. Le crime est la catégorie la plus grave.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1ExOQ==">Cours : Infraction</a><br><a href="#U0NSX0dMT18wMDc0">Glossaire : Infraction</a><br><a href="#U0NSX0dMT18wMDM3">Glossaire : Crime</a></td></tr>
`endif`
`if @err_CSP_V08_Q20 == 1`
<tr><td data-label="Question"><strong>20.</strong> Comment s&#x27;appelle la Constitution actuelle de la France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTIw">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — La Constitution de la Ve République.</td><td data-label="Explication courte">La Constitution de la Ve République est le texte fondamental qui organise les institutions françaises et définit leur fonctionnement.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EyMA==">Cours : Constitution</a><br><a href="#U0NSX0dMT18wMDMy">Glossaire : Constitution</a></td></tr>
`endif`
`if @err_CSP_V08_Q21 == 1`
<tr><td data-label="Question"><strong>21.</strong> Comment s&#x27;appelle le texte qui énonce les droits et devoirs des personnes résidant en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTIx">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — La Déclaration des droits de l&#x27;homme et du citoyen de 1789.</td><td data-label="Explication courte">Adoptée en 1789 pendant la Révolution française, la Déclaration des droits de l&#x27;homme et du citoyen est le texte fondateur qui énonce les grands principes des droits et des devoirs en France.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EyMQ==">Cours : Carte de résident</a><br><a href="#U0NSX0dMT18wMDEw">Glossaire : Carte de résident</a><br><a href="#U0NSX0dMT18wMDQ3">Glossaire : Droits fondamentaux</a></td></tr>
`endif`
`if @err_CSP_V08_Q22 == 1`
<tr><td data-label="Question"><strong>22.</strong> Qui a fondé la Ve République ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTIy">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Charles de Gaulle.</td><td data-label="Explication courte">En 1958, le général Charles de Gaulle fonde la Ve République avec l&#x27;adoption d&#x27;une nouvelle Constitution.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EyMg==">Cours : Charles de Gaulle</a><br><a href="#U0NSX0dMT18wMjMw">Glossaire : Charles de Gaulle</a></td></tr>
`endif`
`if @err_CSP_V08_Q23 == 1`
<tr><td data-label="Question"><strong>23.</strong> Que célèbre-t-on le 14 juillet ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTIz">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — La fête nationale française.</td><td data-label="Explication courte">Le 14 juillet est la fête nationale française. Elle commémore la prise de la Bastille (1789) et la Fête de la Fédération (1790), symbole de l&#x27;unité nationale.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EyMw==">Cours : Fête nationale</a><br><a href="#U0NSX0dMT18wMDU3">Glossaire : Fête nationale</a></td></tr>
`endif`
`if @err_CSP_V08_Q24 == 1`
<tr><td data-label="Question"><strong>24.</strong> Quelle guerre a eu lieu entre 1914 et 1918 ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTI0">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — La Première Guerre mondiale.</td><td data-label="Explication courte">La Première Guerre mondiale s&#x27;est déroulée de 1914 à 1918 et s&#x27;est achevée avec l&#x27;armistice du 11 novembre 1918.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EyNA==">Cours : Première Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTA4">Glossaire : Première Guerre mondiale</a></td></tr>
`endif`
`if @err_CSP_V08_Q25 == 1`
<tr><td data-label="Question"><strong>25.</strong> Pourquoi l&#x27;année 1958 est-elle importante pour la France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTI1">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Fondation de la Ve République et adoption de la Constitution actuelle.</td><td data-label="Explication courte">L&#x27;année 1958 marque la naissance de la Ve République sous l&#x27;impulsion du général Charles de Gaulle. La Constitution adoptée cette année est toujours en vigueur.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EyNQ==">Cours : Constitution</a><br><a href="#U0NSX0dMT18wMDMy">Glossaire : Constitution</a></td></tr>
`endif`
`if @err_CSP_V08_Q26 == 1`
<tr><td data-label="Question"><strong>26.</strong> Citez un fleuve qui coule en France.<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTI2">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — La Seine.</td><td data-label="Explication courte">La France possède plusieurs grands fleuves qui traversent son territoire. Les plus connus sont la Loire, la Seine, le Rhône, la Garonne et le Rhin.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EyNg==">Cours : Fleuve</a><br><a href="#U0NSX0dMT18wMjAy">Glossaire : Fleuve</a><br><a href="#U0NSX0dMT18wMTIy">Glossaire : Seine</a></td></tr>
`endif`
`if @err_CSP_V08_Q27 == 1`
<tr><td data-label="Question"><strong>27.</strong> Quelle ville est française ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTI3">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Lyon.</td><td data-label="Explication courte">Lyon est la troisième plus grande ville de France. Barcelone est en Espagne, Genève en Suisse et Turin en Italie.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EyNw==">Cours : Lyon</a></td></tr>
`endif`
`if @err_CSP_V08_Q28 == 1`
<tr><td data-label="Question"><strong>28.</strong> Quel océan borde la côte ouest française ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTI4">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — L&#x27;océan Atlantique.</td><td data-label="Explication courte">La façade ouest de la France métropolitaine est bordée par l&#x27;océan Atlantique.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EyOA==">Cours : Côte ouest</a></td></tr>
