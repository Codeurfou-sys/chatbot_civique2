`endif`
`if @err_CR_V04_Q03 == 1`
<tr><td data-label="Question"><strong>3.</strong> Travailler sans être déclaré est :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMDM=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Interdit par la loi.</td><td data-label="Explication courte">Le travail non déclaré, appelé aussi travail dissimulé, est interdit. Il prive notamment le salarié de ses droits sociaux (Assurance maladie, retraite, chômage...) et expose le salarié comme l&#x27;employeur à des sanctions.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTAz">Cours : Travail dissimulé</a></td></tr>
`endif`
`if @err_CR_V04_Q04 == 1`
<tr><td data-label="Question"><strong>4.</strong> Lorsqu&#x27;un employeur veut qu&#x27;un salarié travaille plus longtemps que la durée prévue dans son contrat de travail :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMDQ=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Les heures supplémentaires doivent respecter les règles prévues par la loi.</td><td data-label="Explication courte">Les heures supplémentaires sont encadrées par le Code du travail. Elles doivent respecter les limites légales ou conventionnelles et donnent généralement droit à une rémunération majorée ou à un repos compensateur.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTA0">Cours : Contrat de travail</a><br><a href="#U0NSX0dMT18wMDM0">Glossaire : Contrat de travail</a><br><a href="#U0NSX0dMT18wMDUx">Glossaire : Employeur</a></td></tr>
`endif`
`if @err_CR_V04_Q05 == 1`
<tr><td data-label="Question"><strong>5.</strong> Quelle est la mission de France Travail ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMDU=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Accompagner les personnes dans leur recherche d&#x27;emploi.</td><td data-label="Explication courte">France Travail accompagne les demandeurs d&#x27;emploi, propose des offres, des formations et des conseils afin de favoriser le retour à l&#x27;emploi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTA1">Cours : France Travail</a><br><a href="#U0NSX0dMT18wMDYw">Glossaire : France Travail</a></td></tr>
`endif`
`if @err_CR_V04_Q06 == 1`
<tr><td data-label="Question"><strong>6.</strong> Dans une entreprise, le droit syndical permet :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMDY=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — De créer un syndicat, d&#x27;y adhérer ou non, et d&#x27;exercer une activité syndicale dans le respect de la loi.</td><td data-label="Explication courte">Le droit syndical garantit aux salariés la liberté d&#x27;adhérer à un syndicat, de ne pas y adhérer ou de participer à ses activités, dans le respect de la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTA2">Cours : Entreprise</a><br><a href="#U0NSX0dMT18wMTQz">Glossaire : Entreprise</a><br><a href="#U0NSX0dMT18wMTc0">Glossaire : Respect</a></td></tr>
`endif`
`if @err_CR_V04_Q07 == 1`
<tr><td data-label="Question"><strong>7.</strong> Dans une entreprise, le droit de grève autorise :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMDc=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Les salariés à cesser collectivement le travail pour défendre leurs revendications professionnelles.</td><td data-label="Explication courte">Le droit de grève est une liberté reconnue par la Constitution. Il permet aux salariés de cesser collectivement le travail pour défendre leurs intérêts professionnels, dans le respect des règles applicables.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTA3">Cours : Entreprise</a><br><a href="#U0NSX0dMT18wMTQz">Glossaire : Entreprise</a><br><a href="#U0NSX0dMT18wMTQ2">Glossaire : Grève</a></td></tr>
`endif`
`if @err_CR_V04_Q08 == 1`
<tr><td data-label="Question"><strong>8.</strong> Les impôts permettent de financer les dépenses publiques. Quelle proposition est correcte ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMDg=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Les impôts financent les services publics et les équipements utiles à tous.</td><td data-label="Explication courte">Les impôts servent à financer les écoles, les hôpitaux, les routes, la sécurité, la justice et de nombreux autres services publics.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTA4">Cours : Impôt</a><br><a href="#U0NSX0dMT18wMDcz">Glossaire : Impôt</a><br><a href="#U0NSX0dMT18wMTI1">Glossaire : Service public</a></td></tr>
`endif`
`if @err_CR_V04_Q09 == 1`
<tr><td data-label="Question"><strong>9.</strong> Peut-on brûler publiquement un drapeau français ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMDk=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Non.</td><td data-label="Explication courte">Le drapeau français est un symbole de la République. Les atteintes publiques à ce symbole sont encadrées et peuvent être sanctionnées par la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTA5">Cours : Drapeau français</a><br><a href="#U0NSX0dMT18wMDQ2">Glossaire : Drapeau français</a></td></tr>
`endif`
`if @err_CR_V04_Q10 == 1`
<tr><td data-label="Question"><strong>10.</strong> Que fait l&#x27;État pour lutter contre les discriminations ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMTA=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Il interdit les discriminations et les sanctionne par la loi.</td><td data-label="Explication courte">La loi protège chaque personne contre les discriminations fondées notamment sur l&#x27;origine, le sexe, la religion, le handicap ou l&#x27;orientation sexuelle.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTEw">Cours : Que fait l&#x27;État pour lutter contre les discriminations ?</a></td></tr>
`endif`
`if @err_CR_V04_Q11 == 1`
<tr><td data-label="Question"><strong>11.</strong> Que représente Marianne ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMTE=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — La République française.</td><td data-label="Explication courte">Marianne est la représentation symbolique de la République française. Son buste est présent dans de nombreuses mairies et son portrait figure sur certains documents officiels.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTEx">Cours : Marianne</a><br><a href="#U0NSX0dMT18wMDg5">Glossaire : Marianne</a></td></tr>
`endif`
`if @err_CR_V04_Q12 == 1`
<tr><td data-label="Question"><strong>12.</strong> Pour combien de temps sont élus les sénateurs ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMTI=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Six ans.</td><td data-label="Explication courte">Les sénateurs sont élus pour un mandat de six ans. Le Sénat est renouvelé par moitié tous les trois ans.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTEy">Cours : Sénateur</a><br><a href="#U0NSX0dMT18wMTI0">Glossaire : Sénateur</a></td></tr>
`endif`
`if @err_CR_V04_Q13 == 1`
<tr><td data-label="Question"><strong>13.</strong> La séparation des pouvoirs est un principe fondamental. Quels sont les trois pouvoirs concernés ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMTM=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Le pouvoir exécutif, le pouvoir législatif et le pouvoir judiciaire.</td><td data-label="Explication courte">La séparation des pouvoirs permet d&#x27;assurer un équilibre entre les institutions. Le pouvoir exécutif gouverne, le pouvoir législatif vote les lois et le pouvoir judiciaire rend la justice.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTEz">Cours : Séparation des pouvoirs</a><br><a href="#U0NSX0dMT18wMjEx">Glossaire : Séparation des pouvoirs</a><br><a href="#U0NSX0dMT18wMTYx">Glossaire : Pouvoir exécutif</a></td></tr>
`endif`
`if @err_CR_V04_Q14 == 1`
<tr><td data-label="Question"><strong>14.</strong> Est-ce que le président de la République a tous les pouvoirs ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMTQ=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Non, il n&#x27;a pas tous les pouvoirs.</td><td data-label="Explication courte">La France est une démocratie fondée sur la séparation des pouvoirs. Le président exerce des responsabilités importantes mais ne détient pas tous les pouvoirs.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTE0">Cours : Président de la République</a><br><a href="#U0NSX0dMT18wMTA5">Glossaire : Président de la République</a></td></tr>
`endif`
`if @err_CR_V04_Q15 == 1`
<tr><td data-label="Question"><strong>15.</strong> Qui est le préfet ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMTU=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Le représentant de l&#x27;État dans un département.</td><td data-label="Explication courte">Le préfet représente l&#x27;État dans le département. Il veille notamment à l&#x27;application des lois et coordonne les services de l&#x27;État.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTE1">Cours : Préfet</a><br><a href="#U0NSX0dMT18wMTA2">Glossaire : Préfet</a><br><a href="#U0NSX0dMT18wMDQx">Glossaire : Département</a></td></tr>
`endif`
`if @err_CR_V04_Q16 == 1`
<tr><td data-label="Question"><strong>16.</strong> Quelle condition est nécessaire pour voter aux élections ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMTY=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Être inscrit sur les listes électorales.</td><td data-label="Explication courte">Pour pouvoir voter, il faut remplir les conditions prévues par la loi, notamment être inscrit sur les listes électorales.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTE2">Cours : Vote</a><br><a href="#U0NSX0dMT18wMTM3">Glossaire : Vote</a><br><a href="#U0NSX0dMT18wMDUw">Glossaire : Élection</a></td></tr>
`endif`
`if @err_CR_V04_Q17 == 1`
<tr><td data-label="Question"><strong>17.</strong> Qui dirige la commune ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMTc=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Le maire.</td><td data-label="Explication courte">Le maire est élu par le conseil municipal. Il dirige la commune et met en œuvre les décisions du conseil municipal.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTE3">Cours : Commune</a><br><a href="#U0NSX0dMT18wMDI0">Glossaire : Commune</a><br><a href="#U0NSX0dMT18wMDg3">Glossaire : Maire</a></td></tr>
`endif`
`if @err_CR_V04_Q18 == 1`
<tr><td data-label="Question"><strong>18.</strong> Que signifie PMA ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMTg=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Procréation médicalement assistée.</td><td data-label="Explication courte">La PMA signifie « Procréation Médicalement Assistée ». Elle regroupe les techniques médicales permettant d&#x27;aider à concevoir un enfant, dans les conditions prévues par la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTE4">Cours : Que signifie PMA ?</a></td></tr>
`endif`
`if @err_CR_V04_Q19 == 1`
<tr><td data-label="Question"><strong>19.</strong> Quel texte est le plus difficile à modifier ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMTk=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — La Constitution.</td><td data-label="Explication courte">La Constitution est la norme juridique suprême en France. Sa modification nécessite une procédure particulière, plus exigeante que celle applicable aux lois ordinaires.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTE5">Cours : Constitution</a><br><a href="#U0NSX0dMT18wMDMy">Glossaire : Constitution</a></td></tr>
`endif`
`if @err_CR_V04_Q20 == 1`
<tr><td data-label="Question"><strong>20.</strong> Quelle liberté permet à une personne de croire en la religion de son choix ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMjA=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — La liberté de conscience.</td><td data-label="Explication courte">La liberté de conscience garantit à chacun le droit de choisir ses convictions religieuses ou philosophiques, de les changer ou de ne pas avoir de religion.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTIw">Cours : Liberté de conscience</a><br><a href="#U0NSX0dMT18wMDgz">Glossaire : Liberté de conscience</a><br><a href="#U0NSX0dMT18wMTc1">Glossaire : Religion</a></td></tr>
`endif`
`if @err_CR_V04_Q21 == 1`
<tr><td data-label="Question"><strong>21.</strong> Qu&#x27;est-ce que le droit de grève ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMjE=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Le droit de cesser collectivement le travail pour défendre des revendications professionnelles.</td><td data-label="Explication courte">Le droit de grève est une liberté reconnue par la Constitution. Il permet aux salariés de défendre leurs intérêts professionnels dans le respect de la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTIx">Cours : Grève</a><br><a href="#U0NSX0dMT18wMTQ2">Glossaire : Grève</a></td></tr>
`endif`
`if @err_CR_V04_Q22 == 1`
<tr><td data-label="Question"><strong>22.</strong> Quelle est la population approximative de la France en 2025 ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMjI=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — 68 millions.</td><td data-label="Explication courte">En 2025, la France compte environ 68 millions d&#x27;habitants. Ce chiffre peut évoluer légèrement au fil des années.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTIy">Cours : Population France</a></td></tr>
`endif`
`if @err_CR_V04_Q23 == 1`
<tr><td data-label="Question"><strong>23.</strong> Quel fleuve traverse Paris ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMjM=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — La Seine.</td><td data-label="Explication courte">La Seine traverse Paris avant de se jeter dans la Manche, au Havre.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTIz">Cours : Fleuve</a><br><a href="#U0NSX0dMT18wMjAy">Glossaire : Fleuve</a><br><a href="#U0NSX0dMT18wMDk1">Glossaire : Musée du Louvre</a></td></tr>
`endif`
`if @err_CR_V04_Q24 == 1`
