`endif`
`if @err_CR_V05_Q30 == 1`
<tr><td data-label="Question"><strong>30.</strong> De quel président s&#x27;agit-il ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMzA=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — François Mitterrand.</td><td data-label="Explication courte">La peine de mort a été abolie en France en 1981, sous la présidence de François Mitterrand. La loi a été portée par le garde des Sceaux Robert Badinter.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTMw">Cours : Peine de mort</a><br><a href="#U0NSX0dMT18wMTg0">Glossaire : Peine de mort</a><br><a href="#U0NSX0dMT18wMTU0">Glossaire : Mandat</a></td></tr>
`endif`
`if @err_CR_V05_Q31 == 1`
<tr><td data-label="Question"><strong>31.</strong> A-t-il le droit d&#x27;agir ainsi ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMzE=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Non, ce comportement n&#x27;est pas autorisé.</td><td data-label="Explication courte">En France, chacun doit être respecté, quelles que soient son origine, son sexe, son handicap, son apparence physique ou ses convictions.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTMx">Cours : Handicap</a><br><a href="#U0NSX0dMT18wMTQ3">Glossaire : Handicap</a></td></tr>
`endif`
`if @err_CR_V05_Q32 == 1`
<tr><td data-label="Question"><strong>32.</strong> Quel est ce nombre approximatif ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMzI=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — 320 millions.</td><td data-label="Explication courte">Le français est parlé sur les cinq continents par environ 320 millions de personnes. Ce chiffre évolue régulièrement.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTMy">Cours : Quel est ce nombre approximatif ?</a></td></tr>
`endif`
`if @err_CR_V05_Q33 == 1`
<tr><td data-label="Question"><strong>33.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMzM=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Être inscrit sur les listes électorales.</td><td data-label="Explication courte">Pour voter aux élections européennes en France, il faut être inscrit sur les listes électorales, que l&#x27;on soit citoyen français ou citoyen d&#x27;un autre État membre de l&#x27;Union européenne résidant en France.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTMz">Cours : Élections européennes</a><br><a href="#U0NSX0dMT18wMTYw">Glossaire : Élections européennes</a><br><a href="#U0NSX0dMT18wMTM3">Glossaire : Vote</a></td></tr>
`endif`
`if @err_CR_V05_Q34 == 1`
<tr><td data-label="Question"><strong>34.</strong> Quelle est la mission de France Travail ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMzQ=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Accompagner les personnes dans leur recherche d&#x27;emploi.</td><td data-label="Explication courte">France Travail accompagne les demandeurs d&#x27;emploi, propose des offres, des formations et des conseils afin de favoriser le retour à l&#x27;emploi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTM0">Cours : France Travail</a><br><a href="#U0NSX0dMT18wMDYw">Glossaire : France Travail</a></td></tr>
`endif`
`if @err_CR_V05_Q35 == 1`
<tr><td data-label="Question"><strong>35.</strong> Quelle réponse donnez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMzU=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — 577.</td><td data-label="Explication courte">L&#x27;Assemblée nationale est composée de 577 députés élus au suffrage universel direct. Le Sénat, lui, compte un nombre différent de sénateurs.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTM1">Cours : Assemblée nationale</a><br><a href="#U0NSX0dMT18wMDA0">Glossaire : Assemblée nationale</a><br><a href="#U0NSX0dMT18wMDQy">Glossaire : Député</a></td></tr>
`endif`
`if @err_CR_V05_Q36 == 1`
<tr><td data-label="Question"><strong>36.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMzY=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — La liberté de disposer de son corps.</td><td data-label="Explication courte">La procréation médicalement assistée (PMA) relève de la liberté individuelle de disposer de son corps. En France, elle est autorisée dans les conditions prévues par la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTM2">Cours : Que lui répondez-vous ?</a></td></tr>
`endif`
`if @err_CR_V05_Q37 == 1`
<tr><td data-label="Question"><strong>37.</strong> Combien d&#x27;étoiles compte réellement le drapeau européen ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMzc=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — 12 étoiles jaunes, un nombre fixe qui ne correspond pas au nombre d&#x27;États membres.</td><td data-label="Explication courte">Les douze étoiles du drapeau européen symbolisent l&#x27;unité, la solidarité et l&#x27;harmonie entre les peuples d&#x27;Europe.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTM3">Cours : Drapeau français</a><br><a href="#U0NSX0dMT18wMDQ2">Glossaire : Drapeau français</a></td></tr>
`endif`
`if @err_CR_V05_Q38 == 1`
<tr><td data-label="Question"><strong>38.</strong> Que dit la loi française sur cette pratique ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMzg=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — C&#x27;est interdit : la loi interdit les discriminations à l&#x27;embauche.</td><td data-label="Explication courte">En France, une personne ne peut pas être écartée d&#x27;un recrutement en raison de son sexe.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTM4">Cours : Employeur</a><br><a href="#U0NSX0dMT18wMDUx">Glossaire : Employeur</a><br><a href="#U0NSX0dMT18wMTQz">Glossaire : Entreprise</a></td></tr>
`endif`
`if @err_CR_V05_Q39 == 1`
<tr><td data-label="Question"><strong>39.</strong> Laquelle de ces propositions représente un exemple de crime ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMzk=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Un homicide volontaire.</td><td data-label="Explication courte">Le crime est l&#x27;infraction la plus grave. L&#x27;homicide volontaire en est un exemple. Les autres propositions correspondent à des infractions moins graves (contraventions ou délits).</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTM5">Cours : Crime</a><br><a href="#U0NSX0dMT18wMDM3">Glossaire : Crime</a></td></tr>
