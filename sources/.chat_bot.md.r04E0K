`if @err_NAT_V06_Q13 == 1`
<tr><td data-label="Question"><strong>13.</strong> Qui était George Sand ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDZfUTEz">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Une écrivaine.</td><td data-label="Explication courte">George Sand, de son vrai nom Aurore Dupin, est une grande romancière française du XIXᵉ siècle. Elle est connue pour son engagement en faveur de la liberté et de l&#x27;égalité.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA2X1ExMw==">Cours : George Sand</a></td></tr>
`endif`
`if @err_NAT_V06_Q14 == 1`
<tr><td data-label="Question"><strong>14.</strong> Qui était Simone de Beauvoir ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDZfUTE0">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Une philosophe et écrivaine.</td><td data-label="Explication courte">Simone de Beauvoir est une philosophe, écrivaine et essayiste française. Son ouvrage Le Deuxième Sexe est une référence majeure dans l&#x27;histoire du féminisme.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA2X1ExNA==">Cours : Simone de Beauvoir</a></td></tr>
`endif`
`if @err_NAT_V06_Q15 == 1`
<tr><td data-label="Question"><strong>15.</strong> Qui était Albert Camus ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDZfUTE1">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Un écrivain et philosophe.</td><td data-label="Explication courte">Albert Camus est l&#x27;un des plus grands écrivains français du XXᵉ siècle. Il est notamment l&#x27;auteur de &quot;L&#x27;Étranger&quot; et &quot;La Peste&quot; et reçoit le prix Nobel de littérature en 1957 pour l&#x27;ensemble de son œuvre.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA2X1ExNQ==">Cours : Albert Camus</a></td></tr>
`endif`
`if @err_NAT_V06_Q16 == 1`
<tr><td data-label="Question"><strong>16.</strong> Qui était Marguerite Yourcenar ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDZfUTE2">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Une écrivaine.</td><td data-label="Explication courte">Marguerite Yourcenar est une grande écrivaine française. En 1980, elle devient la première femme élue à l&#x27;Académie française.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA2X1ExNg==">Cours : Marguerite Yourcenar</a></td></tr>
`endif`
`if @err_NAT_V06_Q17 == 1`
<tr><td data-label="Question"><strong>17.</strong> Qui peut demander un congé parental d&#x27;éducation ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDZfUTE3">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Le père ou la mère (les deux parents peuvent en bénéficier).</td><td data-label="Explication courte">Le congé parental d&#x27;éducation permet à un salarié de suspendre ou réduire son activité pour s&#x27;occuper de son enfant.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA2X1ExNw==">Cours : Congé parental</a></td></tr>
`endif`
`if @err_NAT_V06_Q18 == 1`
<tr><td data-label="Question"><strong>18.</strong> Une personne étrangère en situation régulière peut-elle créer une entreprise en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDZfUTE4">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Oui, si la personne est en situation régulière.</td><td data-label="Explication courte">La création d&#x27;entreprise est ouverte aux personnes étrangères en situation régulière, selon leur titre de séjour et les règles applicables.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA2X1ExOA==">Cours : Entreprise</a><br><a href="#U0NSX0dMT18wMTQz">Glossaire : Entreprise</a></td></tr>
`endif`
`if @err_NAT_V06_Q19 == 1`
<tr><td data-label="Question"><strong>19.</strong> Une femme peut-elle créer une entreprise en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDZfUTE5">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Oui.</td><td data-label="Explication courte">En France, les femmes disposent des mêmes droits que les hommes pour créer une entreprise et exercer une activité professionnelle.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA2X1ExOQ==">Cours : Entreprise</a><br><a href="#U0NSX0dMT18wMTQz">Glossaire : Entreprise</a></td></tr>
`endif`
`if @err_NAT_V06_Q20 == 1`
<tr><td data-label="Question"><strong>20.</strong> Quels textes fixent les règles applicables aux salariés en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDZfUTIw">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Le Code du travail et les conventions collectives.</td><td data-label="Explication courte">Le Code du travail fixe les règles générales applicables aux salariés. Les conventions collectives peuvent prévoir des dispositions plus favorables selon les professions.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA2X1EyMA==">Cours : Règles du travail</a></td></tr>
`endif`
`if @err_NAT_V06_Q21 == 1`
<tr><td data-label="Question"><strong>21.</strong> Quel type de litige le conseil de prud&#x27;hommes traite-t-il ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDZfUTIx">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Les conflits entre employeurs et salariés.</td><td data-label="Explication courte">Le conseil de prud&#x27;hommes est une juridiction spécialisée qui traite les conflits individuels entre employeurs et salariés (licenciement, salaire, contrat de travail, etc.).</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA2X1EyMQ==">Cours : Employeur</a><br><a href="#U0NSX0dMT18wMDUx">Glossaire : Employeur</a></td></tr>
`endif`
`if @err_NAT_V06_Q22 == 1`
<tr><td data-label="Question"><strong>22.</strong> Sur quel document peut-on voir Marianne ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDZfUTIy">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Sur les timbres, les pièces de monnaie ou les documents officiels de la République.</td><td data-label="Explication courte">Marianne est la représentation officielle de la République française. Son effigie est présente sur plusieurs documents et symboles officiels.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA2X1EyMg==">Cours : Marianne</a><br><a href="#U0NSX0dMT18wMDg5">Glossaire : Marianne</a></td></tr>
`endif`
`if @err_NAT_V06_Q23 == 1`
<tr><td data-label="Question"><strong>23.</strong> Une des valeurs de la devise républicaine est l&#x27;Égalité. Qu&#x27;est-ce que cela signifie ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDZfUTIz">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Toutes les personnes sont égales en droits devant la loi, sans discrimination.</td><td data-label="Explication courte">L&#x27;égalité est une valeur fondamentale de la République. Elle garantit que chacun est traité de la même manière par la loi, quelles que soient son origine, son sexe, sa religion ou ses convictions.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA2X1EyMw==">Cours : Devise</a><br><a href="#U0NSX0dMT18wMjE3">Glossaire : Devise</a><br><a href="#U0NSX0dMT18wMDQ0">Glossaire : Devise de la République</a></td></tr>
`endif`
`if @err_NAT_V06_Q24 == 1`
<tr><td data-label="Question"><strong>24.</strong> Une personne peut-elle changer librement de religion en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDZfUTI0">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Oui, chacun est libre de changer de religion.</td><td data-label="Explication courte">La liberté de conscience garantit à chacun le droit de croire, de changer de religion ou de ne pratiquer aucune religion.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA2X1EyNA==">Cours : Religion</a><br><a href="#U0NSX0dMT18wMTc1">Glossaire : Religion</a></td></tr>
`endif`
`if @err_NAT_V06_Q25 == 1`
<tr><td data-label="Question"><strong>25.</strong> Selon le principe de laïcité, que signifie la neutralité de l&#x27;État ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDZfUTI1">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — L&#x27;État interdit les religions.</td><td data-label="Explication courte">La neutralité de l&#x27;État est l&#x27;un des principes de la laïcité. Elle garantit l&#x27;égalité de traitement de tous les citoyens, quelles que soient leurs convictions religieuses.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA2X1EyNQ==">Cours : Laïcité</a><br><a href="#U0NSX0dMT18wMDgw">Glossaire : Laïcité</a><br><a href="#U0NSX0dMT18wMDk4">Glossaire : Neutralité</a></td></tr>
`endif`
`if @err_NAT_V06_Q26 == 1`
<tr><td data-label="Question"><strong>26.</strong> Quel est le rôle du Conseil constitutionnel ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDZfUTI2">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Il veille au respect de la Constitution.</td><td data-label="Explication courte">Le Conseil constitutionnel contrôle la conformité des lois à la Constitution et veille au bon déroulement de certaines élections et référendums.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA2X1EyNg==">Cours : Conseil constitutionnel</a><br><a href="#U0NSX0dMT18wMDI1">Glossaire : Conseil constitutionnel</a><br><a href="#U0NSX0dMT18wMDMy">Glossaire : Constitution</a></td></tr>
`endif`
`if @err_NAT_V06_Q27 == 1`
<tr><td data-label="Question"><strong>27.</strong> Que doit obtenir un candidat pour se présenter à l&#x27;élection présidentielle ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDZfUTI3">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Obtenir 500 parrainages d&#x27;élus.</td><td data-label="Explication courte">Parmi les conditions prévues par la loi, un candidat à l&#x27;élection présidentielle doit recueillir 500 présentations (parrainages) d&#x27;élus habilités.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA2X1EyNw==">Cours : Élection présidentielle</a><br><a href="#U0NSX0dMT18wMjIx">Glossaire : Élection présidentielle</a><br><a href="#U0NSX0dMT18wMDUw">Glossaire : Élection</a></td></tr>
