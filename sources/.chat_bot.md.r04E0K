`if @lastErr33 == 1`
<tr><td data-label="Question"><strong>33.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMzNfTEFTVA==">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Le français est la langue de la République.</td><td data-label="Explication courte">L&#x27;article 2 de la Constitution dispose que « La langue de la République est le français ».</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTMzX0xBU1Q=">Cours : Francophonie</a><br><a href="#U0NSX0dMT18wMDYx">Glossaire : Francophonie</a><br><a href="#U0NSX0dMT18wMDgx">Glossaire : Langue de la République</a></td></tr>
`endif`
`if @lastErr34 == 1`
