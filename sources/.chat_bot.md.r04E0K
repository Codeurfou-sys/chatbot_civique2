`if @err_CSP_V09_Q23 == 1`
<tr><td data-label="Question"><strong>23.</strong> Qui était Molière ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTIz">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Un écrivain et dramaturge.</td><td data-label="Explication courte">Molière (1622-1673) est considéré comme l&#x27;un des plus grands auteurs du théâtre français, avec des œuvres comme Le Misanthrope, L&#x27;Avare et Le Bourgeois gentilhomme.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1EyMw==">Cours : Molière</a></td></tr>
`endif`
`if @err_CSP_V09_Q24 == 1`
<tr><td data-label="Question"><strong>24.</strong> Qui est aidé par France Travail ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTI0">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Les personnes à la recherche d&#x27;un emploi.</td><td data-label="Explication courte">France Travail accompagne les personnes dans leur recherche d&#x27;emploi, leur reconversion professionnelle et leur retour vers l&#x27;activité.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1EyNA==">Cours : France Travail</a><br><a href="#U0NSX0dMT18wMDYw">Glossaire : France Travail</a></td></tr>
`endif`
`if @err_CSP_V09_Q25 == 1`
<tr><td data-label="Question"><strong>25.</strong> Une personne étrangère en situation régulière peut créer son entreprise :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTI1">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Oui, si elle respecte les conditions prévues par la loi.</td><td data-label="Explication courte">En France, une personne étrangère en situation régulière peut créer une entreprise lorsque son statut administratif le permet et qu&#x27;elle respecte les règles applicables.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1EyNQ==">Cours : Entreprise</a><br><a href="#U0NSX0dMT18wMTQz">Glossaire : Entreprise</a></td></tr>
`endif`
`if @err_CSP_V09_Q26 == 1`
<tr><td data-label="Question"><strong>26.</strong> Une femme peut-elle créer son entreprise ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTI2">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Oui.</td><td data-label="Explication courte">En France, les femmes et les hommes disposent des mêmes droits pour créer une entreprise.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1EyNg==">Cours : Entreprise</a><br><a href="#U0NSX0dMT18wMTQz">Glossaire : Entreprise</a></td></tr>
`endif`
`if @err_CSP_V09_Q27 == 1`
<tr><td data-label="Question"><strong>27.</strong> À partir de quel âge un mineur peut-il travailler ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTI3">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — 16 ans.</td><td data-label="Explication courte">En règle générale, un mineur peut travailler à partir de 16 ans. Certaines exceptions existent, notamment pour l&#x27;apprentissage ou certains travaux autorisés par la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1EyNw==">Cours : À partir de quel âge un mineur peut-il travailler ?</a></td></tr>
`endif`
`if @err_CSP_V09_Q28 == 1`
<tr><td data-label="Question"><strong>28.</strong> Auprès de quel organisme faut-il demander le remboursement des frais de santé ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTI4">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — L&#x27;Assurance Maladie.</td><td data-label="Explication courte">L&#x27;Assurance Maladie rembourse une partie des dépenses de santé. Selon le contrat souscrit, une mutuelle santé peut compléter ce remboursement.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1EyOA==">Cours : Assurance maladie</a><br><a href="#U0NSX0dMT18wMDA2">Glossaire : Assurance maladie</a></td></tr>
