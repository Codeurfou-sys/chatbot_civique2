`if @err_CR_V06_Q02 == 1`
<tr><td data-label="Question"><strong>2.</strong> Quel est le rôle principal des communes ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMDI=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Gérer les services de proximité.</td><td data-label="Explication courte">La commune est la collectivité la plus proche des habitants. Elle gère de nombreux services utiles au quotidien.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTAy">Cours : Commune</a><br><a href="#U0NSX0dMT18wMDI0">Glossaire : Commune</a></td></tr>
`endif`
`if @err_CR_V06_Q03 == 1`
<tr><td data-label="Question"><strong>3.</strong> Combien de communes environ existe-t-il en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMDM=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — 35000.</td><td data-label="Explication courte">La France compte environ 35 000 communes, ce qui en fait l&#x27;un des pays européens ayant le plus grand nombre de communes.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTAz">Cours : Commune</a><br><a href="#U0NSX0dMT18wMDI0">Glossaire : Commune</a></td></tr>
`endif`
`if @err_CR_V06_Q04 == 1`
<tr><td data-label="Question"><strong>4.</strong> Jeter un mégot par terre est :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMDQ=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Interdit et passible d&#x27;une sanction.</td><td data-label="Explication courte">Jeter un mégot sur la voie publique est interdit. Ce geste pollue l&#x27;environnement et peut être sanctionné par une amende.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTA0">Cours : Sanction</a><br><a href="#U0NSX0dMT18wMjI2">Glossaire : Sanction</a></td></tr>
`endif`
`if @err_CR_V06_Q05 == 1`
<tr><td data-label="Question"><strong>5.</strong> L&#x27;État peut-il limiter les droits et libertés ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMDU=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Oui, dans les conditions prévues par la loi et pour protéger l&#x27;intérêt général.</td><td data-label="Explication courte">Les libertés sont fondamentales, mais elles peuvent être limitées lorsque cela est nécessaire pour protéger l&#x27;ordre public, la sécurité, la santé ou les droits des autres.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTA1">Cours : Intérêt général</a><br><a href="#U0NSX0dMT18wMTcz">Glossaire : Intérêt général</a></td></tr>
`endif`
`if @err_CR_V06_Q06 == 1`
<tr><td data-label="Question"><strong>6.</strong> Parmi ces actions, laquelle permet d&#x27;adopter une attitude respectueuse de l&#x27;environnement ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMDY=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Trier ses déchets.</td><td data-label="Explication courte">Le tri des déchets permet de recycler de nombreux matériaux et de limiter les impacts sur l&#x27;environnement.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTA2">Cours : Environnement</a><br><a href="#U0NSX0dMT18wMDUy">Glossaire : Environnement</a><br><a href="#U0NSX0dMT18wMTg2">Glossaire : Déchets</a></td></tr>
`endif`
`if @err_CR_V06_Q07 == 1`
<tr><td data-label="Question"><strong>7.</strong> Quelle proposition constitue une obligation ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMDc=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Respecter la loi.</td><td data-label="Explication courte">Toutes les personnes présentes en France doivent respecter les lois. En revanche, choisir une religion, adhérer à une association ou voter sont des libertés ou des droits, pas des obligations.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTA3">Cours : Respect de la loi</a></td></tr>
`endif`
`if @err_CR_V06_Q08 == 1`
<tr><td data-label="Question"><strong>8.</strong> Quel était le surnom de Louis XIV ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMDg=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Le Roi-Soleil.</td><td data-label="Explication courte">Louis XIV (1638-1715) est surnommé le Roi-Soleil. Son règne est l&#x27;un des plus longs de l&#x27;histoire de France et il a renforcé le pouvoir de la monarchie.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTA4">Cours : Château de Versailles</a><br><a href="#U0NSX0dMT18wMDE3">Glossaire : Château de Versailles</a></td></tr>
`endif`
`if @err_CR_V06_Q09 == 1`
<tr><td data-label="Question"><strong>9.</strong> Quel roi de France a été exécuté pendant la Révolution française ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMDk=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Louis XVI.</td><td data-label="Explication courte">Louis XVI a été condamné à mort et exécuté en 1793 pendant la Révolution française, après l&#x27;abolition de la monarchie.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTA5">Cours : Révolution française</a><br><a href="#U0NSX0dMT18wMTE5">Glossaire : Révolution française</a><br><a href="#U0NSX0dMT18wMjI4">Glossaire : Révolution</a></td></tr>
`endif`
`if @err_CR_V06_Q10 == 1`
<tr><td data-label="Question"><strong>10.</strong> En quelle année Napoléon Ier est-il devenu empereur ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMTA=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — 1804.</td><td data-label="Explication courte">Napoléon Bonaparte est devenu empereur des Français en 1804 sous le nom de Napoléon Ier.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTEw">Cours : 1804</a></td></tr>
`endif`
`if @err_CR_V06_Q11 == 1`
<tr><td data-label="Question"><strong>11.</strong> Lequel de ces personnages a un lien avec la République française ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMTE=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Jules Ferry.</td><td data-label="Explication courte">Jules Ferry est connu pour les lois qui ont rendu l&#x27;école gratuite, laïque et obligatoire. Son action est étroitement liée aux valeurs de la République.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTEx">Cours : Jules Ferry</a><br><a href="#U0NSX0dMT18wMjM0">Glossaire : Jules Ferry</a></td></tr>
`endif`
`if @err_CR_V06_Q12 == 1`
<tr><td data-label="Question"><strong>12.</strong> De quand date l&#x27;appel à la résistance du général de Gaulle ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMTI=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — 18 juin 1940.</td><td data-label="Explication courte">Le 18 juin 1940, le général de Gaulle lance depuis Londres un appel à poursuivre le combat contre l&#x27;Allemagne nazie. Cet appel est devenu un symbole de la Résistance française.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTEy">Cours : Résistance</a><br><a href="#U0NSX0dMT18wMTkz">Glossaire : Résistance</a><br><a href="#U0NSX0dMT18wMTIx">Glossaire : Seconde Guerre mondiale</a></td></tr>
`endif`
`if @err_CR_V06_Q13 == 1`
<tr><td data-label="Question"><strong>13.</strong> Pourquoi la Shoah est-elle étudiée à l&#x27;école ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMTM=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Pour transmettre la mémoire de ce génocide et prévenir le racisme, l&#x27;antisémitisme et les crimes contre l&#x27;humanité.</td><td data-label="Explication courte">La Shoah est le génocide des Juifs d&#x27;Europe pendant la Seconde Guerre mondiale.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTEz">Cours : Shoah</a><br><a href="#U0NSX0dMT18wMTk0">Glossaire : Shoah</a><br><a href="#U0NSX0dMT18wMDQ4">Glossaire : École</a></td></tr>
`endif`
`if @err_CR_V06_Q14 == 1`
<tr><td data-label="Question"><strong>14.</strong> Quel pays a été colonisé par la France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMTQ=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — L&#x27;Algérie.</td><td data-label="Explication courte">Au cours de son histoire, la France a constitué un empire colonial sur plusieurs continents. L&#x27;Algérie, le Sénégal, Madagascar ou encore le Vietnam en ont fait partie.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTE0">Cours : Quel pays a été colonisé par la France ?</a></td></tr>
`endif`
`if @err_CR_V06_Q15 == 1`
<tr><td data-label="Question"><strong>15.</strong> Depuis quand les Français élisent-ils le président de la République au suffrage universel direct ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMTU=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — 1962.</td><td data-label="Explication courte">Depuis le référendum de 1962, le président de la République est élu au suffrage universel direct par les citoyens.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTE1">Cours : Président de la République</a><br><a href="#U0NSX0dMT18wMTA5">Glossaire : Président de la République</a><br><a href="#U0NSX0dMT18wMTI3">Glossaire : Suffrage universel</a></td></tr>
`endif`
`if @err_CR_V06_Q16 == 1`
<tr><td data-label="Question"><strong>16.</strong> Quelle est la première étape de la construction européenne en 1951 ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMTY=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — La création de la Communauté européenne du charbon et de l&#x27;acier (CECA).</td><td data-label="Explication courte">La CECA qui rassemble six pays européens afin de développer une coopération économique et de favoriser la paix après la Seconde Guerre mondiale.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTE2">Cours : CECA</a><br><a href="#U0NSX0dMT18wMjA1">Glossaire : CECA</a></td></tr>
`endif`
`if @err_CR_V06_Q17 == 1`
<tr><td data-label="Question"><strong>17.</strong> À quel âge commence l&#x27;instruction obligatoire des enfants ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMTc=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — À 3 ans.</td><td data-label="Explication courte">En France, l&#x27;instruction est obligatoire pour tous les enfants à partir de 3 ans jusqu&#x27;à l&#x27;âge de 16 ans.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTE3">Cours : Instruction obligatoire</a><br><a href="#U0NSX0dMT18wMTcx">Glossaire : Instruction obligatoire</a></td></tr>
`endif`
`if @err_CR_V06_Q18 == 1`
<tr><td data-label="Question"><strong>18.</strong> Quel est l&#x27;âge de la majorité ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMTg=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — 18 ans.</td><td data-label="Explication courte">En France, la majorité est fixée à 18 ans. À partir de cet âge, une personne devient juridiquement majeure et exerce pleinement ses droits civils.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTE4">Cours : Majorité</a><br><a href="#U0NSX0dMT18wMjA4">Glossaire : Majorité</a></td></tr>
`endif`
`if @err_CR_V06_Q19 == 1`
<tr><td data-label="Question"><strong>19.</strong> À l&#x27;école, il est interdit aux parents de :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMTk=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Contester les enseignements ou les activités obligatoires pour des motifs religieux.</td><td data-label="Explication courte">Tous les élèves doivent suivre les enseignements obligatoires prévus par les programmes scolaires. Les parents ne peuvent pas s&#x27;y opposer pour des motifs religieux.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTE5">Cours : École</a><br><a href="#U0NSX0dMT18wMDQ4">Glossaire : École</a></td></tr>
`endif`
`if @err_CR_V06_Q20 == 1`
<tr><td data-label="Question"><strong>20.</strong> Quel motif d&#x27;absence est accepté par l&#x27;école ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMjA=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Un enfant malade.</td><td data-label="Explication courte">Les absences scolaires doivent être justifiées. La maladie fait partie des motifs légitimes prévus par la réglementation.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTIw">Cours : École</a><br><a href="#U0NSX0dMT18wMDQ4">Glossaire : École</a></td></tr>
`endif`
`if @err_CR_V06_Q21 == 1`
<tr><td data-label="Question"><strong>21.</strong> Des parents ne respectent pas l&#x27;obligation d&#x27;instruction pour leurs enfants. Quelle sanction maximale risquent-ils ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMjE=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Jusqu&#x27;à 6 mois d&#x27;emprisonnement et 7 500 € d&#x27;amende.</td><td data-label="Explication courte">Les parents ont l&#x27;obligation de veiller à ce que leur enfant reçoive une instruction. Le non-respect de cette obligation constitue une infraction pouvant entraîner des sanctions pénales.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTIx">Cours : Sanction</a><br><a href="#U0NSX0dMT18wMjI2">Glossaire : Sanction</a><br><a href="#U0NSX0dMT18wMTc4">Glossaire : Amende</a></td></tr>
`endif`
`if @err_CR_V06_Q22 == 1`
<tr><td data-label="Question"><strong>22.</strong> Un employeur refuse d&#x27;embaucher des femmes dans son entreprise. Que dit la loi ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMjI=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — C&#x27;est interdit. La loi interdit les discriminations.</td><td data-label="Explication courte">En France, une personne ne peut pas être discriminée lors d&#x27;un recrutement en raison de son sexe. Les femmes et les hommes bénéficient des mêmes droits.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTIy">Cours : Employeur</a><br><a href="#U0NSX0dMT18wMDUx">Glossaire : Employeur</a><br><a href="#U0NSX0dMT18wMTQz">Glossaire : Entreprise</a></td></tr>
`endif`
`if @err_CR_V06_Q23 == 1`
<tr><td data-label="Question"><strong>23.</strong> Une des valeurs de la devise républicaine est l&#x27;égalité. Qu&#x27;est-ce que cela signifie ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMjM=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Toutes les personnes ont les mêmes droits et les mêmes devoirs devant la loi.</td><td data-label="Explication courte">L&#x27;égalité est l&#x27;un des principes fondamentaux de la République. Elle garantit que la loi s&#x27;applique de la même manière à toutes les personnes.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTIz">Cours : Devise</a><br><a href="#U0NSX0dMT18wMjE3">Glossaire : Devise</a><br><a href="#U0NSX0dMT18wMDQ0">Glossaire : Devise de la République</a></td></tr>
`endif`
`if @err_CR_V06_Q24 == 1`
<tr><td data-label="Question"><strong>24.</strong> Quelle est la place de la langue française dans la République ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMjQ=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Le français est la langue de la République.</td><td data-label="Explication courte">L&#x27;article 2 de la Constitution dispose que « La langue de la République est le français ».</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTI0">Cours : Francophonie</a><br><a href="#U0NSX0dMT18wMDYx">Glossaire : Francophonie</a><br><a href="#U0NSX0dMT18wMDgx">Glossaire : Langue de la République</a></td></tr>
`endif`
`if @err_CR_V06_Q25 == 1`
<tr><td data-label="Question"><strong>25.</strong> Lequel de ces symboles est un symbole officiel de la République française ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMjU=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — L&#x27;Arc de triomphe.</td><td data-label="Explication courte">Les principaux symboles officiels de la République sont le drapeau tricolore, Marianne, la Marseillaise et la devise « Liberté, Égalité, Fraternité ».</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTI1">Cours : Lequel de ces symboles est un symbole officiel de la République française ?</a></td></tr>
`endif`
`if @err_CR_V06_Q26 == 1`
<tr><td data-label="Question"><strong>26.</strong> Combien y a-t-il de régions en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMjY=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — 18.</td><td data-label="Explication courte">Depuis la réforme territoriale de 2016, la France compte 18 régions : 13 en métropole et 5 en outre-mer.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTI2">Cours : Région</a><br><a href="#U0NSX0dMT18wMTE3">Glossaire : Région</a></td></tr>
`endif`
`if @err_CR_V06_Q27 == 1`
