`if @lastErr1 == 1`
<tr><td data-label="Question"><strong>1.</strong> À quoi correspond la date du 14 juillet ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTAxX0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — La fête nationale française.</td><td data-label="Explication courte">Le 14 juillet est la fête nationale française. Cette journée rappelle un événement majeur de la Révolution française et célèbre les valeurs de la République.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1EwMV9MQVNU">Cours : Fête nationale</a><br><a href="#U0NSX0dMT18wMDU3">Glossaire : Fête nationale</a></td></tr>
`endif`
`if @lastErr2 == 1`
<tr><td data-label="Question"><strong>2.</strong> Quel est l&#x27;un des symboles officiels de la République française ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTAyX0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Marianne.</td><td data-label="Explication courte">Les symboles de la République représentent l&#x27;identité de la France et ses valeurs : le drapeau tricolore, Marianne, la Marseillaise et la devise. Le coq est un symbole traditionnel, mais non officiel.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1EwMl9MQVNU">Cours : Marianne</a><br><a href="#U0NSX0dMT18wMDg5">Glossaire : Marianne</a></td></tr>
`endif`
`if @lastErr3 == 1`
<tr><td data-label="Question"><strong>3.</strong> Le principe d&#x27;égalité signifie que :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTAzX0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Toutes les personnes sont égales devant la loi et bénéficient des mêmes droits.</td><td data-label="Explication courte">L&#x27;égalité garantit que chaque personne bénéficie des mêmes droits et est traitée de la même manière par la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1EwM19MQVNU">Cours : Égalité</a><br><a href="#U0NSX0dMT18wMDQ5">Glossaire : Égalité</a></td></tr>
`endif`
`if @lastErr4 == 1`
<tr><td data-label="Question"><strong>4.</strong> « Liberté, Égalité, Fraternité », c&#x27;est :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTA0X0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — La devise de la République française.</td><td data-label="Explication courte">La devise « Liberté, Égalité, Fraternité » exprime les trois valeurs fondamentales de la République française. Elle figure notamment sur les bâtiments publics.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1EwNF9MQVNU">Cours : Devise de la République</a><br><a href="#U0NSX0dMT18wMDQ0">Glossaire : Devise de la République</a><br><a href="#U0NSX0dMT18wMDYy">Glossaire : Fraternité</a></td></tr>
`endif`
`if @lastErr5 == 1`
<tr><td data-label="Question"><strong>5.</strong> Qui nomme le Premier ministre ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTA1X0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Le président de la République.</td><td data-label="Explication courte">Le président de la République nomme le Premier ministre. Celui-ci dirige ensuite l&#x27;action du gouvernement.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1EwNV9MQVNU">Cours : Premier ministre</a><br><a href="#U0NSX0dMT18wMTA3">Glossaire : Premier ministre</a><br><a href="#U0NSX0dMT18wMDkz">Glossaire : Ministre</a></td></tr>
`endif`
`if @lastErr6 == 1`
<tr><td data-label="Question"><strong>6.</strong> Le Parlement est composé :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTA2X0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — De l&#x27;Assemblée nationale et du Sénat.</td><td data-label="Explication courte">Le Parlement français est composé de deux chambres : l&#x27;Assemblée nationale et le Sénat. Ensemble, elles examinent et votent les lois.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1EwNl9MQVNU">Cours : Parlement</a><br><a href="#U0NSX0dMT18wMTAx">Glossaire : Parlement</a><br><a href="#U0NSX0dMT18wMDA0">Glossaire : Assemblée nationale</a></td></tr>
`endif`
`if @lastErr7 == 1`
<tr><td data-label="Question"><strong>7.</strong> Qu&#x27;est-ce que le pouvoir exécutif ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTA3X0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Il met en œuvre les lois et dirige l&#x27;action du gouvernement.</td><td data-label="Explication courte">Le pouvoir exécutif est chargé de mettre en œuvre les lois votées par le Parlement et d&#x27;assurer la conduite des affaires de l&#x27;État.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1EwN19MQVNU">Cours : Pouvoir exécutif</a><br><a href="#U0NSX0dMT18wMTYx">Glossaire : Pouvoir exécutif</a><br><a href="#U0NSX0dMT18wMDY2">Glossaire : Gouvernement</a></td></tr>
`endif`
`if @lastErr8 == 1`
<tr><td data-label="Question"><strong>8.</strong> Les dirigeants sont élus par les citoyens dans :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTA4X0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Une démocratie.</td><td data-label="Explication courte">Dans une démocratie, les citoyens élisent leurs représentants.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1EwOF9MQVNU">Cours : Démocratie</a><br><a href="#U0NSX0dMT18wMDQw">Glossaire : Démocratie</a></td></tr>
`endif`
`if @lastErr9 == 1`
<tr><td data-label="Question"><strong>9.</strong> A-t-on le droit de ne pas respecter une loi ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTA5X0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Non, tout le monde doit respecter la loi.</td><td data-label="Explication courte">Le respect de la loi est un devoir fondamental. Les lois garantissent les droits, les libertés et la vie en société.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1EwOV9MQVNU">Cours : A-t-on le droit de ne pas respecter une loi ?</a></td></tr>
`endif`
`if @lastErr10 == 1`
