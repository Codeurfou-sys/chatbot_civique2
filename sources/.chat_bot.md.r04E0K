`if @lastErr8 == 1`
<tr><td data-label="Question"><strong>8.</strong> Qui est l&#x27;auteur des grandes lois scolaires de la IIIᵉ République rendant l&#x27;école gratuite, laïque et obligatoire ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTA4X0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Jules Ferry.</td><td data-label="Explication courte">Jules Ferry est l&#x27;auteur des grandes lois scolaires de la IIIᵉ République. Elles garantissent l&#x27;accès de tous les enfants à une école publique gratuite, laïque et obligatoire.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1EwOF9MQVNU">Cours : Laïcité</a><br><a href="#U0NSX0dMT18wMDgw">Glossaire : Laïcité</a><br><a href="#U0NSX0dMT18wMDQ4">Glossaire : École</a></td></tr>
`endif`
`if @lastErr9 == 1`
<tr><td data-label="Question"><strong>9.</strong> Quel roi de France a été guillotiné pendant la Révolution française ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTA5X0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Louis XVI.</td><td data-label="Explication courte">Louis XVI est le dernier roi de l&#x27;Ancien Régime. Il est guillotiné le 21 janvier 1793 pendant la Révolution française.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1EwOV9MQVNU">Cours : Révolution française</a><br><a href="#U0NSX0dMT18wMTE5">Glossaire : Révolution française</a><br><a href="#U0NSX0dMT18wMjI4">Glossaire : Révolution</a></td></tr>
