`endif`
`if @err_CSP_V06_Q32 == 1`
<tr><td data-label="Question"><strong>32.</strong> Quel numéro composez-vous pour joindre les pompiers ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTMy">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — 18.</td><td data-label="Explication courte">Le 18 permet de joindre les sapeurs-pompiers en cas d&#x27;incendie, d&#x27;accident ou de situation nécessitant un secours.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EzMg==">Cours : Urgence</a><br><a href="#U0NSX0dMT18wMTUx">Glossaire : Urgence</a></td></tr>
`endif`
`if @err_CSP_V06_Q33 == 1`
<tr><td data-label="Question"><strong>33.</strong> Laquelle choisissez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTMz">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Édith Piaf.</td><td data-label="Explication courte">Édith Piaf est l&#x27;une des chanteuses françaises les plus célèbres, connue pour « La Vie en rose ».</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EzMw==">Cours : Marc Chagall</a></td></tr>
`endif`
`if @err_CSP_V06_Q34 == 1`
<tr><td data-label="Question"><strong>34.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTM0">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Les conseillers municipaux.</td><td data-label="Explication courte">Lors des élections municipales, les citoyens élisent les conseillers municipaux. Le maire est ensuite élu par le conseil municipal.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EzNA==">Cours : Élection</a><br><a href="#U0NSX0dMT18wMDUw">Glossaire : Élection</a></td></tr>
`endif`
`if @err_CSP_V06_Q35 == 1`
<tr><td data-label="Question"><strong>35.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTM1">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — 6 ans.</td><td data-label="Explication courte">Les sénateurs sont élus pour un mandat de six ans, renouvelé par moitié tous les trois ans.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EzNQ==">Cours : Pouvoir exécutif</a><br><a href="#U0NSX0dMT18wMTYx">Glossaire : Pouvoir exécutif</a></td></tr>
`endif`
`if @err_CSP_V06_Q36 == 1`
<tr><td data-label="Question"><strong>36.</strong> Pour combien de temps sont-ils élus, d&#x27;après vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTM2">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — 5 ans.</td><td data-label="Explication courte">Les députés sont élus pour un mandat de cinq ans lors des élections législatives.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EzNg==">Cours : Sénateur</a><br><a href="#U0NSX0dMT18wMTI0">Glossaire : Sénateur</a></td></tr>
`endif`
`if @err_CSP_V06_Q37 == 1`
<tr><td data-label="Question"><strong>37.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTM3">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — C&#x27;est la devise de la République française.</td><td data-label="Explication courte">La devise « Liberté, Égalité, Fraternité » exprime les trois valeurs fondamentales de la République française et figure sur les bâtiments publics.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EzNw==">Cours : Devise de la République</a><br><a href="#U0NSX0dMT18wMDQ0">Glossaire : Devise de la République</a><br><a href="#U0NSX0dMT18wMDYy">Glossaire : Fraternité</a></td></tr>
`endif`
`if @err_CSP_V06_Q38 == 1`
<tr><td data-label="Question"><strong>38.</strong> Quel est cet animal ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTM4">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Le coq.</td><td data-label="Explication courte">Le coq est un symbole traditionnel de la France, souvent utilisé lors des compétitions sportives. Il ne fait toutefois pas partie des symboles officiels de la République.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EzOA==">Cours : Quel est cet animal ?</a></td></tr>
`endif`
`if @err_CSP_V06_Q39 == 1`
<tr><td data-label="Question"><strong>39.</strong> Laquelle choisissez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTM5">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Lyon.</td><td data-label="Explication courte">Lyon est la troisième plus grande ville de France. Port-Louis se situe à l&#x27;île Maurice, Bâton-Rouge est la capitale de la Louisiane aux Etats-Unis et Gênes est située en Italie.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EzOQ==">Cours : Fleuve</a><br><a href="#U0NSX0dMT18wMjAy">Glossaire : Fleuve</a></td></tr>
