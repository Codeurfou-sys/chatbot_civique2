`if @err_CSP_V09_Q30 == 1`
<tr><td data-label="Question"><strong>30.</strong> Qu&#x27;implique réellement l&#x27;inscription à l&#x27;école ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTMw">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — L&#x27;enfant doit fréquenter régulièrement l&#x27;école.</td><td data-label="Explication courte">L&#x27;inscription à l&#x27;école implique une fréquentation régulière. Les absences doivent être justifiées.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1EzMA==">Cours : École</a><br><a href="#U0NSX0dMT18wMDQ4">Glossaire : École</a></td></tr>
`endif`
`if @err_CSP_V09_Q31 == 1`
<tr><td data-label="Question"><strong>31.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTMx">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — La fête nationale française, qui commémore la prise de la Bastille.</td><td data-label="Explication courte">Le 14 juillet est la fête nationale française. Cette journée rappelle un événement majeur de la Révolution française et célèbre les valeurs de la République.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1EzMQ==">Cours : Fête nationale</a><br><a href="#U0NSX0dMT18wMDU3">Glossaire : Fête nationale</a><br><a href="#U0NSX0dMT18wMjI5">Glossaire : Bastille</a></td></tr>
`endif`
`if @err_CSP_V09_Q32 == 1`
<tr><td data-label="Question"><strong>32.</strong> Lequel de ces ensembles ne comprend que des symboles officiels de la République ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTMy">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Le béret, la baguette et le croissant.</td><td data-label="Explication courte">Les symboles officiels permettent d&#x27;identifier la République française : le drapeau, Marianne, la Marseillaise et la devise. Les autres éléments sont des icônes culturelles, mais non des symboles officiels.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1EzMg==">Cours : Symboles officiels</a></td></tr>
`endif`
`if @err_CSP_V09_Q33 == 1`
<tr><td data-label="Question"><strong>33.</strong> À quelle condition leur mariage sera-t-il reconnu juridiquement ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTMz">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Lorsqu&#x27;il est célébré à la mairie par un officier d&#x27;état civil.</td><td data-label="Explication courte">Seul le mariage civil célébré à la mairie par un officier d&#x27;état civil est reconnu juridiquement en France. Le mariage religieux peut être célébré ensuite, mais n&#x27;a pas de valeur juridique à lui seul.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1EzMw==">Cours : État civil</a><br><a href="#U0NSX0dMT18wMTY2">Glossaire : État civil</a><br><a href="#U0NSX0dMT18wMDg4">Glossaire : Mairie</a></td></tr>
`endif`
`if @err_CSP_V09_Q34 == 1`
<tr><td data-label="Question"><strong>34.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTM0">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Tous les 5 ans.</td><td data-label="Explication courte">Les députés européens sont élus pour un mandat de cinq ans.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1EzNA==">Cours : Élections européennes</a><br><a href="#U0NSX0dMT18wMTYw">Glossaire : Élections européennes</a><br><a href="#U0NSX0dMT18wMDUw">Glossaire : Élection</a></td></tr>
`endif`
`if @err_CSP_V09_Q35 == 1`
<tr><td data-label="Question"><strong>35.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTM1">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Les citoyens français inscrits sur les listes électorales.</td><td data-label="Explication courte">Les députés sont élus au suffrage universel direct par les citoyens français inscrits sur les listes électorales.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1EzNQ==">Cours : Vote</a><br><a href="#U0NSX0dMT18wMTM3">Glossaire : Vote</a><br><a href="#U0NSX0dMT18wMTU4">Glossaire : Listes électorales</a></td></tr>
`endif`
`if @err_CSP_V09_Q36 == 1`
<tr><td data-label="Question"><strong>36.</strong> Quelles sont ces dates ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTM2">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — 1939-1945.</td><td data-label="Explication courte">La Seconde Guerre mondiale se déroule de 1939 à 1945 et se termine en Europe le 8 mai 1945.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1EzNg==">Cours : Seconde Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTIx">Glossaire : Seconde Guerre mondiale</a></td></tr>
`endif`
`if @err_CSP_V09_Q37 == 1`
<tr><td data-label="Question"><strong>37.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTM3">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — La police protége les personnes et les biens et fait respecter la loi.</td><td data-label="Explication courte">La Police nationale prévient les infractions, protège la population et fait respecter la loi, sans exercer de fonction judiciaire.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1EzNw==">Cours : Police</a><br><a href="#U0NSX0dMT18wMTA0">Glossaire : Police</a></td></tr>
