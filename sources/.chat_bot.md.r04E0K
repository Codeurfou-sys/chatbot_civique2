`if @err_CSP_V10_Q30 == 1`
<tr><td data-label="Question"><strong>30.</strong> Quelle est cette durée ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMTBfUTMw">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — 35 heures.</td><td data-label="Explication courte">En France, la durée légale du travail est fixée à 35 heures par semaine pour un salarié à temps complet.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjEwX1EzMA==">Cours : Temps de travail</a><br><a href="#U0NSX0dMT18wMjQx">Glossaire : Temps de travail</a></td></tr>
`endif`
`if @err_CSP_V10_Q31 == 1`
<tr><td data-label="Question"><strong>31.</strong> Quelle condition est réellement nécessaire pour voter ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMTBfUTMx">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Être inscrit sur les listes électorales.</td><td data-label="Explication courte">Pour voter, il faut remplir plusieurs conditions. L&#x27;une des principales est d&#x27;être inscrit sur les listes électorales.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjEwX1EzMQ==">Cours : Vote</a><br><a href="#U0NSX0dMT18wMTM3">Glossaire : Vote</a><br><a href="#U0NSX0dMT18wMDUw">Glossaire : Élection</a></td></tr>
`endif`
`if @err_CSP_V10_Q32 == 1`
<tr><td data-label="Question"><strong>32.</strong> Cela est-il légal en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMTBfUTMy">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Non. La polygamie est interdite en France.</td><td data-label="Explication courte">En France, une personne ne peut être mariée qu&#x27;à une seule autre personne à la fois. La polygamie est interdite.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjEwX1EzMg==">Cours : Polygamie</a><br><a href="#U0NSX0dMT18wMTY5">Glossaire : Polygamie</a></td></tr>
`endif`
`if @err_CSP_V10_Q33 == 1`
<tr><td data-label="Question"><strong>33.</strong> Lequel choisissez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMTBfUTMz">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Napoléon Bonaparte.</td><td data-label="Explication courte">Napoléon Bonaparte est une figure majeure de l&#x27;histoire de France. Les autres personnages appartiennent à l&#x27;histoire du Royaume-Uni, de l&#x27;Italie et de l&#x27;Autriche.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjEwX1EzMw==">Cours : Napoléon Bonaparte</a><br><a href="#U0NSX0dMT18wMjMx">Glossaire : Napoléon Bonaparte</a></td></tr>
`endif`
`if @err_CSP_V10_Q34 == 1`
<tr><td data-label="Question"><strong>34.</strong> Quel rôle correspond à celui du Parlement ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMTBfUTM0">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Il vote les lois et contrôle l&#x27;action du gouvernement.</td><td data-label="Explication courte">Le Parlement est composé de l&#x27;Assemblée nationale et du Sénat. Il vote les lois et contrôle l&#x27;action du gouvernement.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjEwX1EzNA==">Cours : Parlement</a><br><a href="#U0NSX0dMT18wMTAx">Glossaire : Parlement</a><br><a href="#U0NSX0dMT18wMDY2">Glossaire : Gouvernement</a></td></tr>
`endif`
`if @err_CSP_V10_Q35 == 1`
<tr><td data-label="Question"><strong>35.</strong> Quelle est cette date ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMTBfUTM1">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — 1848.</td><td data-label="Explication courte">L&#x27;esclavage est définitivement aboli en France en 1848 grâce au décret porté notamment par Victor Schœlcher.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjEwX1EzNQ==">Cours : Esclavage</a><br><a href="#U0NSX0dMT18wMTk2">Glossaire : Esclavage</a><br><a href="#U0NSX0dMT18wMTMx">Glossaire : Traite des êtres humains</a></td></tr>
`endif`
`if @err_CSP_V10_Q36 == 1`
<tr><td data-label="Question"><strong>36.</strong> Quel est ce nom ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMTBfUTM2">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — La Marseillaise.</td><td data-label="Explication courte">La Marseillaise est l&#x27;hymne national français, chanté lors des cérémonies officielles et de nombreux événements sportifs.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjEwX1EzNg==">Cours : La Marseillaise</a><br><a href="#U0NSX0dMT18wMDc4">Glossaire : La Marseillaise</a></td></tr>
`endif`
`if @err_CSP_V10_Q37 == 1`
<tr><td data-label="Question"><strong>37.</strong> D&#x27;après vous, quelle réponse pourriez-vous donner à ce participant ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMTBfUTM3">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Non, c&#x27;est interdit en France.</td><td data-label="Explication courte">La peine de mort a été abolie en France en 1981. Son abolition est inscrite dans la Constitution depuis 2007.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjEwX1EzNw==">Cours : Peine de mort</a><br><a href="#U0NSX0dMT18wMTg0">Glossaire : Peine de mort</a></td></tr>
`endif`
`if @err_CSP_V10_Q38 == 1`
<tr><td data-label="Question"><strong>38.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMTBfUTM4">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Oui, c&#x27;est la liberté d&#x27;expression. permet à chacun d&#x27;exprimer ses opinions et ses idées, dans le respect de la loi et des droits des autres.</td><td data-label="Explication courte">La liberté d&#x27;expression permet à chacun d&#x27;exprimer ses opinions et ses idées, dans le respect de la loi et des droits des autres.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjEwX1EzOA==">Cours : Liberté d’expression</a><br><a href="#U0NSX0dMT18wMjEz">Glossaire : Liberté d’expression</a><br><a href="#U0NSX0dMT18wMTc0">Glossaire : Respect</a></td></tr>
`endif`
`if @err_CSP_V10_Q39 == 1`
<tr><td data-label="Question"><strong>39.</strong> Quelle réponse est correcte ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMTBfUTM5">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Le pouvoir exécutif, le pouvoir législatif et le pouvoir judiciaire.</td><td data-label="Explication courte">La séparation des pouvoirs permet d&#x27;éviter qu&#x27;une seule personne ou une seule institution concentre tous les pouvoirs.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjEwX1EzOQ==">Cours : Pouvoir législatif</a><br><a href="#U0NSX0dMT18wMTYy">Glossaire : Pouvoir législatif</a><br><a href="#U0NSX0dMT18wMTYx">Glossaire : Pouvoir exécutif</a></td></tr>
`endif`
`if @err_CSP_V10_Q40 == 1`
<tr><td data-label="Question"><strong>40.</strong> À partir de quel âge un mineur peut-il travailler ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMTBfUTQw">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — À partir de 16 ans.</td><td data-label="Explication courte">En règle générale, un mineur peut travailler à partir de 16 ans, sauf exceptions prévues par la loi (apprentissage, etc.).</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjEwX1E0MA==">Cours : À partir de quel âge un mineur peut-il travailler ?</a></td></tr>
