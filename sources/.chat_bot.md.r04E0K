`if @err_CR_V10_Q02 == 1`
<tr><td data-label="Question"><strong>2.</strong> Qui dirige l&#x27;action du gouvernement ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMDI=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Le Premier ministre.</td><td data-label="Explication courte">Selon la Constitution, le Premier ministre dirige l&#x27;action du gouvernement et veille à l&#x27;exécution des lois.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTAy">Cours : Gouvernement</a><br><a href="#U0NSX0dMT18wMDY2">Glossaire : Gouvernement</a><br><a href="#U0NSX0dMT18wMTA3">Glossaire : Premier ministre</a></td></tr>
`endif`
`if @err_CR_V10_Q03 == 1`
<tr><td data-label="Question"><strong>3.</strong> Qui nomme le Premier ministre ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMDM=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Le président de la République.</td><td data-label="Explication courte">Le président de la République nomme le Premier ministre. Celui-ci dirige ensuite l&#x27;action du gouvernement.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTAz">Cours : Premier ministre</a><br><a href="#U0NSX0dMT18wMTA3">Glossaire : Premier ministre</a><br><a href="#U0NSX0dMT18wMDkz">Glossaire : Ministre</a></td></tr>
`endif`
`if @err_CR_V10_Q04 == 1`
<tr><td data-label="Question"><strong>4.</strong> Qui veille au maintien de l&#x27;ordre public ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMDQ=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — La police et la gendarmerie.</td><td data-label="Explication courte">La police nationale et la gendarmerie nationale assurent la sécurité des personnes et des biens, font respecter la loi et participent au maintien de l&#x27;ordre public.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTA0">Cours : Ordre public</a><br><a href="#U0NSX0dMT18wMDk5">Glossaire : Ordre public</a><br><a href="#U0NSX0dMT18wMDY1">Glossaire : Gendarmerie</a></td></tr>
`endif`
`if @err_CR_V10_Q05 == 1`
<tr><td data-label="Question"><strong>5.</strong> S&#x27;agissant des déchets, quelle proposition est correcte ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMDU=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Les déchets doivent être triés et déposés dans les équipements prévus.</td><td data-label="Explication courte">Le tri des déchets est un geste citoyen qui protège l&#x27;environnement. Les déchets doivent être déposés dans les conteneurs ou les déchèteries prévus à cet effet.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTA1">Cours : Déchets</a><br><a href="#U0NSX0dMT18wMTg2">Glossaire : Déchets</a></td></tr>
`endif`
`if @err_CR_V10_Q06 == 1`
<tr><td data-label="Question"><strong>6.</strong> À quelle liberté la PMA fait-elle référence ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMDY=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — La liberté de disposer de son corps.</td><td data-label="Explication courte">La procréation médicalement assistée (PMA) relève de la liberté individuelle. En France, elle est autorisée dans les conditions prévues par la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTA2">Cours : À quelle liberté la PMA fait-elle référence ?</a></td></tr>
`endif`
`if @err_CR_V10_Q07 == 1`
<tr><td data-label="Question"><strong>7.</strong> Au nom de quoi l&#x27;État justifie-t-il la restriction des droits ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMDc=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — De l&#x27;intérêt général.</td><td data-label="Explication courte">Certaines libertés peuvent être limitées par la loi lorsque cela est nécessaire pour protéger l&#x27;intérêt général, par exemple la sécurité, la santé publique ou les droits d&#x27;autrui.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTA3">Cours : Intérêt général</a><br><a href="#U0NSX0dMT18wMTcz">Glossaire : Intérêt général</a></td></tr>
`endif`
`if @err_CR_V10_Q08 == 1`
<tr><td data-label="Question"><strong>8.</strong> Quel musée est situé à Paris ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMDg=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Le musée du Louvre.</td><td data-label="Explication courte">Le musée du Louvre est situé à Paris. C&#x27;est l&#x27;un des plus grands musées du monde et il abrite notamment la Joconde.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTA4">Cours : Musée du Louvre</a><br><a href="#U0NSX0dMT18wMDk1">Glossaire : Musée du Louvre</a><br><a href="#U0NSX0dMT18wMTMw">Glossaire : Tour Eiffel</a></td></tr>
`endif`
`if @err_CR_V10_Q09 == 1`
<tr><td data-label="Question"><strong>9.</strong> Qui était Auguste Rodin ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMDk=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Un sculpteur français.</td><td data-label="Explication courte">Auguste Rodin est l&#x27;un des plus grands sculpteurs français. Parmi ses œuvres les plus connues figure Le Penseur.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTA5">Cours : Auguste Rodin</a></td></tr>
`endif`
`if @err_CR_V10_Q10 == 1`
<tr><td data-label="Question"><strong>10.</strong> Quel est le classement de la langue française parmi les langues les plus parlées dans le monde ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMTA=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Cinquième.</td><td data-label="Explication courte">Le français est aujourd&#x27;hui considéré comme la cinquième langue la plus parlée dans le monde. Ce classement peut évoluer au fil du temps.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTEw">Cours : Francophonie</a><br><a href="#U0NSX0dMT18wMDYx">Glossaire : Francophonie</a></td></tr>
`endif`
`if @err_CR_V10_Q11 == 1`
<tr><td data-label="Question"><strong>11.</strong> Quelle cathédrale célèbre a été en partie détruite par un incendie en 2019 ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMTE=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Notre-Dame de Paris.</td><td data-label="Explication courte">La cathédrale Notre-Dame de Paris est l&#x27;un des monuments les plus emblématiques de la France.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTEx">Cours : Musée du Louvre</a><br><a href="#U0NSX0dMT18wMDk1">Glossaire : Musée du Louvre</a><br><a href="#U0NSX0dMT18wMTMw">Glossaire : Tour Eiffel</a></td></tr>
`endif`
`if @err_CR_V10_Q12 == 1`
<tr><td data-label="Question"><strong>12.</strong> Qui était une écrivaine française célèbre ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMTI=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — George Sand.</td><td data-label="Explication courte">La France compte de nombreuses écrivaines célèbres. George Sand, Marguerite Yourcenar et Simone de Beauvoir figurent parmi les plus connues.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTEy">Cours : George Sand</a></td></tr>
`endif`
`if @err_CR_V10_Q13 == 1`
<tr><td data-label="Question"><strong>13.</strong> Qui était un célèbre musicien français ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMTM=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Hector Berlioz.</td><td data-label="Explication courte">La France a vu naître de grands compositeurs comme Hector Berlioz, Georges Bizet, Claude Debussy ou Maurice Ravel, dont les œuvres sont connues dans le monde entier.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTEz">Cours : Berlioz</a></td></tr>
`endif`
`if @err_CR_V10_Q14 == 1`
<tr><td data-label="Question"><strong>14.</strong> Qui était Auguste Renoir ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMTQ=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Un peintre français.</td><td data-label="Explication courte">Auguste Renoir est un peintre français du XIXᵉ siècle, célèbre pour ses œuvres impressionnistes représentant des scènes de la vie quotidienne et des portraits.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTE0">Cours : Auguste Renoir</a></td></tr>
`endif`
`if @err_CR_V10_Q15 == 1`
<tr><td data-label="Question"><strong>15.</strong> Quelle fête est française ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMTU=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Le 14 juillet.</td><td data-label="Explication courte">Le 14 juillet est la fête nationale française. Elle commémore la prise de la Bastille en 1789 et la Fête de la Fédération de 1790.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTE1">Cours : Fête nationale</a><br><a href="#U0NSX0dMT18wMDU3">Glossaire : Fête nationale</a></td></tr>
`endif`
`if @err_CR_V10_Q16 == 1`
<tr><td data-label="Question"><strong>16.</strong> Quel monument parisien est l&#x27;un des symboles de la France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMTY=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — La tour Eiffel.</td><td data-label="Explication courte">Construite pour l&#x27;Exposition universelle de 1889, la tour Eiffel est aujourd&#x27;hui l&#x27;un des monuments les plus connus au monde et un symbole de la France.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTE2">Cours : Tour Eiffel</a><br><a href="#U0NSX0dMT18wMTMw">Glossaire : Tour Eiffel</a></td></tr>
`endif`
`if @err_CR_V10_Q17 == 1`
<tr><td data-label="Question"><strong>17.</strong> Qui peut demander un congé parental d&#x27;éducation ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMTc=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Le père ou la mère.</td><td data-label="Explication courte">Le congé parental permet à un parent de réduire ou de suspendre temporairement son activité professionnelle pour s&#x27;occuper de son enfant.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTE3">Cours : Congé parental</a></td></tr>
`endif`
`if @err_CR_V10_Q18 == 1`
<tr><td data-label="Question"><strong>18.</strong> Quelles sont les affaires traitées par le conseil de prud&#x27;hommes ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMTg=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Les conflits entre un salarié et son employeur.</td><td data-label="Explication courte">Le conseil de prud&#x27;hommes est un tribunal spécialisé qui traite les litiges individuels liés au contrat de travail entre salariés et employeurs.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTE4">Cours : Employeur</a><br><a href="#U0NSX0dMT18wMDUx">Glossaire : Employeur</a><br><a href="#U0NSX0dMT18wMTQy">Glossaire : Salarié</a></td></tr>
`endif`
`if @err_CR_V10_Q19 == 1`
<tr><td data-label="Question"><strong>19.</strong> Travailler sans être déclaré est :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMTk=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Interdit par la loi.</td><td data-label="Explication courte">Le travail non déclaré, appelé aussi travail dissimulé, est interdit. Il prive notamment le salarié de ses droits sociaux (Assurance maladie, retraite, chômage...) et expose le salarié comme l&#x27;employeur à des sanctions.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTE5">Cours : Travail dissimulé</a></td></tr>
`endif`
`if @err_CR_V10_Q20 == 1`
<tr><td data-label="Question"><strong>20.</strong> Lorsqu&#x27;un employeur veut qu&#x27;un salarié travaille plus longtemps que la durée prévue dans son contrat de travail :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMjA=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Les heures supplémentaires doivent respecter les règles prévues par la loi.</td><td data-label="Explication courte">Les heures supplémentaires sont encadrées par le Code du travail. Elles doivent respecter les limites légales ou conventionnelles et donnent généralement droit à une rémunération majorée ou à un repos compensateur.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTIw">Cours : Contrat de travail</a><br><a href="#U0NSX0dMT18wMDM0">Glossaire : Contrat de travail</a><br><a href="#U0NSX0dMT18wMDUx">Glossaire : Employeur</a></td></tr>
`endif`
`if @err_CR_V10_Q21 == 1`
<tr><td data-label="Question"><strong>21.</strong> Quelle est la mission de France Travail ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMjE=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Accompagner les personnes dans leur recherche d&#x27;emploi.</td><td data-label="Explication courte">France Travail accompagne les demandeurs d&#x27;emploi, propose des offres, des formations et des conseils afin de favoriser le retour à l&#x27;emploi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTIx">Cours : France Travail</a><br><a href="#U0NSX0dMT18wMDYw">Glossaire : France Travail</a></td></tr>
`endif`
`if @err_CR_V10_Q22 == 1`
<tr><td data-label="Question"><strong>22.</strong> Que représente la laïcité ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMjI=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — La séparation des Églises et de l&#x27;État, garantissant la liberté de conscience.</td><td data-label="Explication courte">La laïcité repose sur la séparation des Églises et de l&#x27;État, instaurée par la loi de 1905.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTIy">Cours : Laïcité</a><br><a href="#U0NSX0dMT18wMDgw">Glossaire : Laïcité</a><br><a href="#U0NSX0dMT18wMDgz">Glossaire : Liberté de conscience</a></td></tr>
`endif`
`if @err_CR_V10_Q23 == 1`
<tr><td data-label="Question"><strong>23.</strong> Qu&#x27;est-ce qui est interdit par la Charte de la laïcité à l&#x27;école ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMjM=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Le prosélytisme et les pressions religieuses sur les élèves.</td><td data-label="Explication courte">La Charte de la laïcité à l&#x27;école interdit le prosélytisme et les pressions exercées sur les élèves en raison de leurs convictions.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTIz">Cours : Laïcité</a><br><a href="#U0NSX0dMT18wMDgw">Glossaire : Laïcité</a><br><a href="#U0NSX0dMT18wMDQ4">Glossaire : École</a></td></tr>
`endif`
`if @err_CR_V10_Q24 == 1`
<tr><td data-label="Question"><strong>24.</strong> Que dit l&#x27;article 1er de la Constitution française ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMjQ=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — La France est une République indivisible, laïque, démocratique et sociale.</td><td data-label="Explication courte">L&#x27;article 1er de la Constitution définit les principes fondamentaux de la République française.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTI0">Cours : Constitution</a><br><a href="#U0NSX0dMT18wMDMy">Glossaire : Constitution</a><br><a href="#U0NSX0dMT18wMDQw">Glossaire : Démocratie</a></td></tr>
`endif`
`if @err_CR_V10_Q25 == 1`
<tr><td data-label="Question"><strong>25.</strong> Parmi les propositions suivantes, laquelle constitue une participation citoyenne ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMjU=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Voter aux élections.</td><td data-label="Explication courte">La participation citoyenne consiste à prendre part à la vie démocratique du pays. Le vote est l&#x27;une des principales formes de participation citoyenne.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTI1">Cours : Vote</a><br><a href="#U0NSX0dMT18wMTM3">Glossaire : Vote</a><br><a href="#U0NSX0dMT18wMDUw">Glossaire : Élection</a></td></tr>
`endif`
`if @err_CR_V10_Q26 == 1`
<tr><td data-label="Question"><strong>26.</strong> Que garantit l&#x27;État de droit ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMjY=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Le respect des lois, des libertés et des droits fondamentaux.</td><td data-label="Explication courte">Dans un État de droit, les lois protègent les libertés et les droits fondamentaux de toutes les personnes. Les autorités publiques doivent également respecter ces règles.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTI2">Cours : Droits fondamentaux</a><br><a href="#U0NSX0dMT18wMDQ3">Glossaire : Droits fondamentaux</a><br><a href="#U0NSX0dMT18wMTc0">Glossaire : Respect</a></td></tr>
`endif`
`if @err_CR_V10_Q27 == 1`
<tr><td data-label="Question"><strong>27.</strong> Une personne peut-elle voter à la place d&#x27;une autre ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMjc=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Oui, si elle vote par procuration dans les conditions prévues par la loi.</td><td data-label="Explication courte">Le vote est personnel. Lorsqu&#x27;un électeur ne peut pas se déplacer, il peut donner procuration à une autre personne selon une procédure prévue par la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTI3">Cours : Vote</a><br><a href="#U0NSX0dMT18wMTM3">Glossaire : Vote</a><br><a href="#U0NSX0dMT18wMTEx">Glossaire : Procuration</a></td></tr>
`endif`
`if @err_CR_V10_Q28 == 1`
<tr><td data-label="Question"><strong>28.</strong> Est-ce que le vote est obligatoire ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YxMF9RMjg=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Non.</td><td data-label="Explication courte">En France, le vote est un droit civique. Il est libre : chacun peut choisir de voter ou de s&#x27;abstenir.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMTBfUTI4">Cours : Vote</a><br><a href="#U0NSX0dMT18wMTM3">Glossaire : Vote</a></td></tr>
`endif`
</tbody></table>
`endif`
