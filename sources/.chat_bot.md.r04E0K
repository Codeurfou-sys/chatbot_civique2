`endif`
`if @err_CSP_V02_Q14 == 1`
<tr><td data-label="Question"><strong>14.</strong> Qui était le roi de France au moment de la Révolution française ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDJfUTE0">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Louis XVI.</td><td data-label="Explication courte">Louis XVI est le roi de France au début de la Révolution française en 1789. Il est guillotiné en 1793.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAyX1ExNA==">Cours : Révolution française</a><br><a href="#U0NSX0dMT18wMTE5">Glossaire : Révolution française</a><br><a href="#U0NSX0dMT18wMjI4">Glossaire : Révolution</a></td></tr>
`endif`
`if @err_CSP_V02_Q15 == 1`
<tr><td data-label="Question"><strong>15.</strong> Qui a fondé la Ve République ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDJfUTE1">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Charles de Gaulle.</td><td data-label="Explication courte">En 1958, le général Charles de Gaulle fonde la Ve République avec l&#x27;adoption d&#x27;une nouvelle Constitution.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAyX1ExNQ==">Cours : Charles de Gaulle</a><br><a href="#U0NSX0dMT18wMjMw">Glossaire : Charles de Gaulle</a></td></tr>
`endif`
`if @err_CSP_V02_Q16 == 1`
<tr><td data-label="Question"><strong>16.</strong> Que célèbre-t-on le 14 juillet ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDJfUTE2">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — La fête nationale française.</td><td data-label="Explication courte">Le 14 juillet est la fête nationale française. Elle commémore la prise de la Bastille (1789) et la Fête de la Fédération (1790), symbole de l&#x27;unité nationale.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAyX1ExNg==">Cours : Fête nationale</a><br><a href="#U0NSX0dMT18wMDU3">Glossaire : Fête nationale</a></td></tr>
`endif`
`if @err_CSP_V02_Q17 == 1`
<tr><td data-label="Question"><strong>17.</strong> Le travail non déclaré est :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDJfUTE3">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Interdit par la loi.</td><td data-label="Explication courte">Le travail non déclaré est interdit. Il prive notamment le salarié de ses droits sociaux (assurance maladie, retraite, chômage...).</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAyX1ExNw==">Cours : Travail non déclaré</a></td></tr>
`endif`
`if @err_CSP_V02_Q18 == 1`
<tr><td data-label="Question"><strong>18.</strong> Que doit faire un employeur pour fixer un salaire ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDJfUTE4">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Respecter au minimum le SMIC et la loi.</td><td data-label="Explication courte">En France, un employeur ne peut pas fixer un salaire inférieur au salaire minimum légal, sauf exceptions prévues par la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAyX1ExOA==">Cours : Employeur</a><br><a href="#U0NSX0dMT18wMDUx">Glossaire : Employeur</a><br><a href="#U0NSX0dMT18wMTIw">Glossaire : Salaire</a></td></tr>
`endif`
`if @err_CSP_V02_Q19 == 1`
<tr><td data-label="Question"><strong>19.</strong> Qu&#x27;est-ce que le SMIC ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDJfUTE5">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Le salaire minimum légal.</td><td data-label="Explication courte">Le SMIC est le salaire minimum qu&#x27;un employeur doit verser à un salarié, sauf exceptions prévues par la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAyX1ExOQ==">Cours : SMIC</a><br><a href="#U0NSX0dMT18wMTM4">Glossaire : SMIC</a><br><a href="#U0NSX0dMT18wMTIw">Glossaire : Salaire</a></td></tr>
`endif`
`if @err_CSP_V02_Q20 == 1`
<tr><td data-label="Question"><strong>20.</strong> Quelle est la première démarche à réaliser pour chercher un emploi ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDJfUTIw">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — S&#x27;inscrire à France Travail.</td><td data-label="Explication courte">France Travail accompagne les personnes dans leur recherche d&#x27;emploi et propose des offres, des formations et un suivi personnalisé.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAyX1EyMA==">Cours : France Travail</a><br><a href="#U0NSX0dMT18wMDYw">Glossaire : France Travail</a></td></tr>
`endif`
`if @err_CSP_V02_Q21 == 1`
<tr><td data-label="Question"><strong>21.</strong> Quelle est la durée légale du temps de travail par semaine ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDJfUTIx">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — 35 heures.</td><td data-label="Explication courte">En France, la durée légale du travail est fixée à 35 heures par semaine pour un salarié à temps complet. Des heures supplémentaires peuvent être effectuées dans les conditions prévues par la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAyX1EyMQ==">Cours : Temps de travail</a><br><a href="#U0NSX0dMT18wMjQx">Glossaire : Temps de travail</a></td></tr>
`endif`
`if @err_CSP_V02_Q22 == 1`
<tr><td data-label="Question"><strong>22.</strong> A-t-on le droit d&#x27;insulter publiquement quelqu&#x27;un parce qu&#x27;il est différent (handicap, apparence physique, sexe...) ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDJfUTIy">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Non, les insultes et les discriminations sont interdites par la loi.</td><td data-label="Explication courte">Le respect de la dignité de chaque personne est un principe fondamental. Les discriminations et les injures fondées sur certaines caractéristiques sont interdites.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAyX1EyMg==">Cours : Handicap</a><br><a href="#U0NSX0dMT18wMTQ3">Glossaire : Handicap</a></td></tr>
`endif`
`if @err_CSP_V02_Q23 == 1`
<tr><td data-label="Question"><strong>23.</strong> Certains métiers peuvent-ils être réservés aux hommes ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDJfUTIz">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Non, les femmes et les hommes ont les mêmes droits d&#x27;accès aux emplois, sauf exceptions prévues par la loi.</td><td data-label="Explication courte">L&#x27;égalité entre les femmes et les hommes est protégée par la loi. Les discriminations fondées sur le sexe sont interdites.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAyX1EyMw==">Cours : Égalité femmes-hommes</a></td></tr>
`endif`
`if @err_CSP_V02_Q24 == 1`
<tr><td data-label="Question"><strong>24.</strong> De quand date la Constitution de la Ve République ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDJfUTI0">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — 1958.</td><td data-label="Explication courte">La Constitution du 4 octobre 1958 fonde la Ve République et organise le fonctionnement des institutions françaises.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAyX1EyNA==">Cours : Constitution</a><br><a href="#U0NSX0dMT18wMDMy">Glossaire : Constitution</a></td></tr>
`endif`
`if @err_CSP_V02_Q25 == 1`
<tr><td data-label="Question"><strong>25.</strong> Le régime politique de la France est :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDJfUTI1">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Une République.</td><td data-label="Explication courte">La France est une République indivisible, laïque, démocratique et sociale, conformément à l&#x27;article 1er de la Constitution.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAyX1EyNQ==">Cours : Régime français</a></td></tr>
`endif`
`if @err_CSP_V02_Q26 == 1`
<tr><td data-label="Question"><strong>26.</strong> Quel est le rôle de l&#x27;autorité judiciaire ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDJfUTI2">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Rendre la justice et veiller au respect de la loi.</td><td data-label="Explication courte">L&#x27;autorité judiciaire est chargée de trancher les litiges, de protéger les libertés individuelles et de sanctionner les infractions conformément à la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAyX1EyNg==">Cours : Justice</a><br><a href="#U0NSX0dMT18wMDc3">Glossaire : Justice</a><br><a href="#U0NSX0dMT18wMTc0">Glossaire : Respect</a></td></tr>
`endif`
`if @err_CSP_V02_Q27 == 1`
<tr><td data-label="Question"><strong>27.</strong> Quel pouvoir détient un juge ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDJfUTI3">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Le pouvoir judiciaire.</td><td data-label="Explication courte">Le juge exerce le pouvoir judiciaire. Il applique la loi de manière indépendante et prend des décisions de justice.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAyX1EyNw==">Cours : Juge</a><br><a href="#U0NSX0dMT18wMTgw">Glossaire : Juge</a><br><a href="#U0NSX0dMT18wMTYz">Glossaire : Pouvoir judiciaire</a></td></tr>
`endif`
`if @err_CSP_V02_Q28 == 1`
<tr><td data-label="Question"><strong>28.</strong> L&#x27;autorité judiciaire est exercée par :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDJfUTI4">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Les juges.</td><td data-label="Explication courte">Les juges rendent la justice de manière indépendante. Ils appliquent la loi et prennent des décisions en fonction des affaires qui leur sont soumises.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAyX1EyOA==">Cours : Autorité judiciaire</a></td></tr>
`endif`
</tbody></table>
