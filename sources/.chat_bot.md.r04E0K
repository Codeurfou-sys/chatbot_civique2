`if @lastErr27 == 1`
<tr><td data-label="Question"><strong>27.</strong> Quel est le rôle du maire ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTI3X0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Il dirige la commune, applique les décisions du conseil municipal et assure notamment l&#x27;état civil.</td><td data-label="Explication courte">Le maire est l&#x27;exécutif de la commune. Il met en œuvre les décisions du conseil municipal, gère les services municipaux et exerce certaines missions pour le compte de l&#x27;État (l&#x27;inscription des naissances)</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1EyN19MQVNU">Cours : Maire</a><br><a href="#U0NSX0dMT18wMDg3">Glossaire : Maire</a><br><a href="#U0NSX0dMT18wMDI5">Glossaire : Conseil municipal</a></td></tr>
`endif`
`if @lastErr28 == 1`
