`if @lastErr1 == 1`
<tr><td data-label="Question"><strong>1.</strong> Quel droit est garanti par la laïcité ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTAxX0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — La liberté de choisir ou non une religion.</td><td data-label="Explication courte">La liberté de conscience qui protège toutes les convictions, religieuses ou non religieuses. C&#x27;est un principe fondamental de la République française.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1EwMV9MQVNU">Cours : Laïcité</a><br><a href="#U0NSX0dMT18wMDgw">Glossaire : Laïcité</a><br><a href="#U0NSX0dMT18wMTc1">Glossaire : Religion</a></td></tr>
`endif`
`if @lastErr2 == 1`
<tr><td data-label="Question"><strong>2.</strong> Pourquoi le principe de laïcité doit-il être respecté à l&#x27;école ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTAyX0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Pour garantir à tous les élèves la liberté de conscience, l&#x27;égalité et le respect des convictions de chacun.</td><td data-label="Explication courte">L&#x27;école publique est un lieu où tous les élèves apprennent ensemble, quelles que soient leurs convictions. La laïcité garantit un climat de respect, d&#x27;égalité et de neutralité.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1EwMl9MQVNU">Cours : Laïcité</a><br><a href="#U0NSX0dMT18wMDgw">Glossaire : Laïcité</a><br><a href="#U0NSX0dMT18wMDgz">Glossaire : Liberté de conscience</a></td></tr>
`endif`
`if @lastErr3 == 1`
<tr><td data-label="Question"><strong>3.</strong> Qu&#x27;est-ce que la laïcité ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTAzX0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Un principe qui garantit la liberté de conscience, la neutralité de l&#x27;État et le respect de toutes les convictions.</td><td data-label="Explication courte">La laïcité est l&#x27;un des principes fondamentaux de la République française. Elle protège la liberté de conscience de chacun et garantit que l&#x27;État reste neutre à l&#x27;égard des religions.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1EwM19MQVNU">Cours : Laïcité</a><br><a href="#U0NSX0dMT18wMDgw">Glossaire : Laïcité</a><br><a href="#U0NSX0dMT18wMDgz">Glossaire : Liberté de conscience</a></td></tr>
`endif`
`if @lastErr4 == 1`
<tr><td data-label="Question"><strong>4.</strong> Un enfant peut-il refuser d&#x27;aller à l&#x27;école pour une raison religieuse ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTA0X0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Non, l&#x27;instruction est obligatoire et les convictions religieuses ne permettent pas d&#x27;y déroger.</td><td data-label="Explication courte">La République garantit la liberté de conscience tout en imposant l&#x27;instruction obligatoire. Les convictions religieuses ne dispensent pas un enfant de cette obligation.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1EwNF9MQVNU">Cours : École</a><br><a href="#U0NSX0dMT18wMDQ4">Glossaire : École</a></td></tr>
`endif`
`if @lastErr5 == 1`
<tr><td data-label="Question"><strong>5.</strong> Les dirigeants sont élus par les citoyens dans :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTA1X0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Une démocratie.</td><td data-label="Explication courte">Dans une démocratie, les citoyens élisent leurs représentants.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1EwNV9MQVNU">Cours : Démocratie</a><br><a href="#U0NSX0dMT18wMDQw">Glossaire : Démocratie</a></td></tr>
`endif`
`if @lastErr6 == 1`
<tr><td data-label="Question"><strong>6.</strong> A-t-on le droit de ne pas respecter une loi ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTA2X0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Non, tout le monde doit respecter la loi.</td><td data-label="Explication courte">Le respect de la loi est un devoir fondamental. Les lois garantissent les droits, les libertés et la vie en société.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1EwNl9MQVNU">Cours : A-t-on le droit de ne pas respecter une loi ?</a></td></tr>
`endif`
`if @lastErr7 == 1`
<tr><td data-label="Question"><strong>7.</strong> Qui doit respecter la loi ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTA3X0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Toutes les personnes présentes sur le territoire français.</td><td data-label="Explication courte">La loi s&#x27;applique à toutes les personnes vivant ou se rendant sur le territoire français. Chacun doit la respecter afin de garantir la sécurité, les droits et les libertés de tous.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1EwN19MQVNU">Cours : Qui doit respecter la loi ?</a></td></tr>
`endif`
`if @lastErr8 == 1`
<tr><td data-label="Question"><strong>8.</strong> Quel est le rôle de l&#x27;autorité judiciaire ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTA4X0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Rendre la justice et veiller au respect de la loi.</td><td data-label="Explication courte">L&#x27;autorité judiciaire est chargée de trancher les litiges, de protéger les libertés individuelles et de sanctionner les infractions conformément à la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1EwOF9MQVNU">Cours : Justice</a><br><a href="#U0NSX0dMT18wMDc3">Glossaire : Justice</a><br><a href="#U0NSX0dMT18wMTc0">Glossaire : Respect</a></td></tr>
`endif`
`if @lastErr9 == 1`
<tr><td data-label="Question"><strong>9.</strong> Quel pouvoir détient un juge ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDlfUTA5X0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Le pouvoir judiciaire.</td><td data-label="Explication courte">Le juge exerce le pouvoir judiciaire. Il applique la loi de manière indépendante et prend des décisions de justice.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA5X1EwOV9MQVNU">Cours : Juge</a><br><a href="#U0NSX0dMT18wMTgw">Glossaire : Juge</a><br><a href="#U0NSX0dMT18wMTYz">Glossaire : Pouvoir judiciaire</a></td></tr>
