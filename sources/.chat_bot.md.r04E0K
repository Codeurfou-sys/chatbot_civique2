`endif`
`if @err_NAT_V02_Q36 == 1`
<tr><td data-label="Question"><strong>36.</strong> Où siège la Commission européenne ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTM2">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — À Bruxelles.</td><td data-label="Explication courte">La Commission européenne est installée à Bruxelles. Elle propose les lois européennes, veille à leur application et représente l&#x27;intérêt général de l&#x27;Union européenne.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1EzNg==">Cours : Commission européenne</a><br><a href="#U0NSX0dMT18wMDIz">Glossaire : Commission européenne</a></td></tr>
`endif`
`if @err_NAT_V02_Q37 == 1`
<tr><td data-label="Question"><strong>37.</strong> Quelle île française est située en Méditerranée ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTM3">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — La Corse.</td><td data-label="Explication courte">La Corse est une île française située en Méditerranée. Elle constitue une collectivité territoriale unique et fait partie intégrante de la République française.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1EzNw==">Cours : Musée du Louvre</a><br><a href="#U0NSX0dMT18wMDk1">Glossaire : Musée du Louvre</a><br><a href="#U0NSX0dMT18wMjAz">Glossaire : Méditerranée</a></td></tr>
`endif`
`if @err_NAT_V02_Q38 == 1`
<tr><td data-label="Question"><strong>38.</strong> Qu&#x27;est-ce que les droits fondamentaux ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTM4">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Les droits essentiels garantis à toute personne.</td><td data-label="Explication courte">Les droits fondamentaux sont les droits et libertés indispensables reconnus à toute personne. Ils sont protégés par la Constitution, les lois françaises et les textes internationaux.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1EzOA==">Cours : Droits fondamentaux</a><br><a href="#U0NSX0dMT18wMDQ3">Glossaire : Droits fondamentaux</a></td></tr>
`endif`
`if @err_NAT_V02_Q39 == 1`
