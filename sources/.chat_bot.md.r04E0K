`if @err_CSP_V08_Q30 == 1`
<tr><td data-label="Question"><strong>30.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTMw">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Le drapeau.</td><td data-label="Explication courte">Le drapeau tricolore, bleu, blanc et rouge, est l&#x27;un des principaux symboles officiels de la République française.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EzMA==">Cours : Drapeau français</a><br><a href="#U0NSX0dMT18wMDQ2">Glossaire : Drapeau français</a></td></tr>
`endif`
`if @err_CSP_V08_Q31 == 1`
<tr><td data-label="Question"><strong>31.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTMx">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Un écrivain français.</td><td data-label="Explication courte">Albert Camus est un écrivain et philosophe français, prix Nobel de littérature en 1957.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EzMQ==">Cours : George Sand</a></td></tr>
`endif`
`if @err_CSP_V08_Q32 == 1`
<tr><td data-label="Question"><strong>32.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTMy">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Non, tout le monde doit respecter la loi.</td><td data-label="Explication courte">Le respect de la loi est un devoir fondamental. Les lois garantissent les droits, les libertés et la vie en société.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EzMg==">Cours : Que lui répondez-vous ?</a></td></tr>
`endif`
`if @err_CSP_V08_Q33 == 1`
<tr><td data-label="Question"><strong>33.</strong> Quel numéro composez-vous pour joindre le SAMU ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTMz">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — 15.</td><td data-label="Explication courte">Le 15 permet de joindre le SAMU (Service d&#x27;aide médicale urgente).</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EzMw==">Cours : SAMU</a><br><a href="#U0NSX0dMT18wMTUz">Glossaire : SAMU</a><br><a href="#U0NSX0dMT18wMTUx">Glossaire : Urgence</a></td></tr>
`endif`
`if @err_CSP_V08_Q34 == 1`
<tr><td data-label="Question"><strong>34.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTM0">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Voter, être candidat à une élection et participer à la vie démocratique.</td><td data-label="Explication courte">La citoyenneté française donne des droits civiques, notamment le droit de vote et d&#x27;éligibilité, tout en impliquant le respect des devoirs du citoyen.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EzNA==">Cours : Citoyenneté</a><br><a href="#U0NSX0dMT18wMDIw">Glossaire : Citoyenneté</a><br><a href="#U0NSX0dMT18wMDQw">Glossaire : Démocratie</a></td></tr>
`endif`
`if @err_CSP_V08_Q35 == 1`
<tr><td data-label="Question"><strong>35.</strong> Que prévoit l&#x27;autorité parentale ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTM1">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — D&#x27;assurer la protection, l&#x27;éducation et l&#x27;entretien de l&#x27;enfant.</td><td data-label="Explication courte">L&#x27;autorité parentale regroupe les droits et les devoirs des parents dans l&#x27;intérêt de leur enfant, jusqu&#x27;à sa majorité ou son émancipation.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EzNQ==">Cours : Autorité parentale</a><br><a href="#U0NSX0dMT18wMTcw">Glossaire : Autorité parentale</a></td></tr>
`endif`
`if @err_CSP_V08_Q36 == 1`
<tr><td data-label="Question"><strong>36.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTM2">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Le général Charles de Gaulle.</td><td data-label="Explication courte">En 1958, le général Charles de Gaulle fonde la Ve République avec l&#x27;adoption d&#x27;une nouvelle Constitution.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EzNg==">Cours : Révolution française</a><br><a href="#U0NSX0dMT18wMTE5">Glossaire : Révolution française</a><br><a href="#U0NSX0dMT18wMjMw">Glossaire : Charles de Gaulle</a></td></tr>
`endif`
`if @err_CSP_V08_Q37 == 1`
<tr><td data-label="Question"><strong>37.</strong> Que répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTM3">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Le président de la République et le gouvernement.</td><td data-label="Explication courte">Le pouvoir exécutif est exercé conjointement par le président de la République et le gouvernement composé du 1er ministre, des ministres et des secrétaires d&#x27;Etat.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EzNw==">Cours : Président de la République</a><br><a href="#U0NSX0dMT18wMTA5">Glossaire : Président de la République</a><br><a href="#U0NSX0dMT18wMTM3">Glossaire : Vote</a></td></tr>
`endif`
`if @err_CSP_V08_Q38 == 1`
<tr><td data-label="Question"><strong>38.</strong> Pourquoi peuvent-elles l&#x27;être ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTM4">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Pour protéger les droits des autres, l&#x27;ordre public et la sécurité.</td><td data-label="Explication courte">Les libertés sont essentielles dans une démocratie, mais elles s&#x27;exercent dans le respect de la loi et des droits de chacun.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EzOA==">Cours : Ordre public</a><br><a href="#U0NSX0dMT18wMDk5">Glossaire : Ordre public</a></td></tr>
`endif`
`if @err_CSP_V08_Q39 == 1`
<tr><td data-label="Question"><strong>39.</strong> Qu&#x27;est-ce qu&#x27;un préfet ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDhfUTM5">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Un préfet est un haut fonctionnaire qui représente l&#x27;Etat dans un département ou une région.</td><td data-label="Explication courte">Le préfet représente l&#x27;État dans le département. Il veille notamment à l&#x27;application des lois. Il maintient la sécurité et l&#x27;ordre public en dirigeant les forces de l&#x27;ordre.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA4X1EzOQ==">Cours : Commune</a><br><a href="#U0NSX0dMT18wMDI0">Glossaire : Commune</a><br><a href="#U0NSX0dMT18wMTA2">Glossaire : Préfet</a></td></tr>
