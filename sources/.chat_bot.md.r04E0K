`if @lastErr11 == 1`
<tr><td data-label="Question"><strong>11.</strong> À l&#x27;école, un enfant en situation de handicap :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwN19RMTFfTEFTVA==">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — A le droit d&#x27;être scolarisé avec les autres élèves lorsque cela est possible, avec les accompagnements nécessaires.</td><td data-label="Explication courte">L&#x27;école française favorise l&#x27;école inclusive. Les élèves en situation de handicap ont le droit d&#x27;être scolarisés avec les autres élèves lorsque cela est possible, avec les aménagements et accompagnements nécessaires.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDdfUTExX0xBU1Q=">Cours : Handicap</a><br><a href="#U0NSX0dMT18wMTQ3">Glossaire : Handicap</a><br><a href="#U0NSX0dMT18wMDQ4">Glossaire : École</a></td></tr>
`endif`
`if @lastErr12 == 1`
