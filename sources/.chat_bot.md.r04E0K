`if @lastErr1 == 1`
<tr><td data-label="Question"><strong>1.</strong> Quelle est la devise de la République française ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDVfUTAxX0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Liberté, Égalité, Fraternité.</td><td data-label="Explication courte">La devise de la République française est « Liberté, Égalité, Fraternité ». Elle exprime les valeurs fondamentales de la République.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA1X1EwMV9MQVNU">Cours : Devise de la République</a><br><a href="#U0NSX0dMT18wMDQ0">Glossaire : Devise de la République</a><br><a href="#U0NSX0dMT18wMjE3">Glossaire : Devise</a></td></tr>
`endif`
`if @lastErr2 == 1`
<tr><td data-label="Question"><strong>2.</strong> Qu&#x27;est-ce que la liberté d&#x27;association ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDVfUTAyX0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — La liberté de créer une association, d&#x27;y adhérer ou de ne pas y adhérer.</td><td data-label="Explication courte">La liberté d&#x27;association est une liberté fondamentale garantie par la loi. Elle permet à chacun de participer librement à la vie associative.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA1X1EwMl9MQVNU">Cours : Liberté d’association</a><br><a href="#U0NSX0dMT18wMjE0">Glossaire : Liberté d’association</a></td></tr>
`endif`
`if @lastErr3 == 1`
<tr><td data-label="Question"><strong>3.</strong> Qu&#x27;est-ce qu&#x27;une liberté ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDVfUTAzX0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Le droit de faire ce que la loi autorise, dans le respect des droits des autres.</td><td data-label="Explication courte">Les libertés sont garanties par la République, mais elles s&#x27;exercent dans le respect des lois et des droits d&#x27;autrui.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA1X1EwM19MQVNU">Cours : Respect</a><br><a href="#U0NSX0dMT18wMTc0">Glossaire : Respect</a></td></tr>
`endif`
`if @lastErr4 == 1`
<tr><td data-label="Question"><strong>4.</strong> Selon la Constitution, la France est une République...<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDVfUTA0X0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Indivisible, laïque, démocratique et sociale.</td><td data-label="Explication courte">L&#x27;article 1er de la Constitution énonce que « La France est une République indivisible, laïque, démocratique et sociale. »</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA1X1EwNF9MQVNU">Cours : Constitution</a><br><a href="#U0NSX0dMT18wMDMy">Glossaire : Constitution</a><br><a href="#U0NSX0dMT18wMDQw">Glossaire : Démocratie</a></td></tr>
`endif`
`if @lastErr5 == 1`
<tr><td data-label="Question"><strong>5.</strong> Quelle collectivité territoriale gère les collèges publics ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDVfUTA1X0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Le département.</td><td data-label="Explication courte">Les collèges publics relèvent de la compétence des départements, qui assurent notamment leur construction, leur entretien et leur équipement.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA1X1EwNV9MQVNU">Cours : Collège</a><br><a href="#U0NSX0dMT18wMDIy">Glossaire : Collège</a><br><a href="#U0NSX0dMT18wMDQx">Glossaire : Département</a></td></tr>
`endif`
`if @lastErr6 == 1`
<tr><td data-label="Question"><strong>6.</strong> Qui gère les écoles maternelles et élémentaires publiques ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDVfUTA2X0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — La commune.</td><td data-label="Explication courte">Les communes sont responsables de la construction, de l&#x27;entretien et du fonctionnement des écoles maternelles et élémentaires publiques.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA1X1EwNl9MQVNU">Cours : École</a><br><a href="#U0NSX0dMT18wMDQ4">Glossaire : École</a><br><a href="#U0NSX0dMT18wMDI0">Glossaire : Commune</a></td></tr>
`endif`
`if @lastErr7 == 1`
<tr><td data-label="Question"><strong>7.</strong> Comment le maire est-il élu ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDVfUTA3X0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Par les conseillers municipaux.</td><td data-label="Explication courte">Après les élections municipales, les conseillers municipaux se réunissent pour élire le maire parmi eux.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjA1X1EwN19MQVNU">Cours : Maire</a><br><a href="#U0NSX0dMT18wMDg3">Glossaire : Maire</a></td></tr>
