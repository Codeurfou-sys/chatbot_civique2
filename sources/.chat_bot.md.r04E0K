`endif`
`if @err_CR_V05_Q11 == 1`
<tr><td data-label="Question"><strong>11.</strong> Qu&#x27;est-ce que la Constitution ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMTE=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Le texte fondamental qui organise les institutions de la République et fixe les règles de leur fonctionnement.</td><td data-label="Explication courte">La Constitution est la norme juridique la plus importante en France. Elle définit les principes de la République, les droits fondamentaux et l&#x27;organisation des pouvoirs publics.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTEx">Cours : Constitution</a><br><a href="#U0NSX0dMT18wMDMy">Glossaire : Constitution</a></td></tr>
`endif`
`if @err_CR_V05_Q12 == 1`
<tr><td data-label="Question"><strong>12.</strong> Qui peut demander à avorter ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMTI=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Toute femme enceinte qui remplit les conditions prévues par la loi.</td><td data-label="Explication courte">En France, une femme enceinte peut demander une interruption volontaire de grossesse (IVG) dans les conditions fixées par la loi. Cette décision lui appartient.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTEy">Cours : Qui peut demander à avorter ?</a></td></tr>
`endif`
`if @err_CR_V05_Q13 == 1`
<tr><td data-label="Question"><strong>13.</strong> Une femme majeure de nationalité française a-t-elle le droit de voter aux élections ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMTM=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Oui.</td><td data-label="Explication courte">Depuis 1944, les femmes disposent du droit de vote en France. Elles peuvent participer aux élections dans les mêmes conditions que les hommes.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTEz">Cours : Naturalisation</a><br><a href="#U0NSX0dMT18wMDk3">Glossaire : Naturalisation</a><br><a href="#U0NSX0dMT18wMDIw">Glossaire : Citoyenneté</a></td></tr>
`endif`
`if @err_CR_V05_Q14 == 1`
<tr><td data-label="Question"><strong>14.</strong> Concernant l&#x27;utilisation des réseaux sociaux, quelle proposition est correcte ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMTQ=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Les réseaux sociaux sont soumis aux lois françaises.</td><td data-label="Explication courte">Les réseaux sociaux ne sont pas une zone de non-droit. Les propos injurieux, diffamatoires, discriminatoires ou incitant à la haine sont interdits et peuvent être sanctionnés.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTE0">Cours : Réseaux sociaux</a><br><a href="#U0NSX0dMT18wMTkx">Glossaire : Réseaux sociaux</a></td></tr>
`endif`
`if @err_CR_V05_Q15 == 1`
<tr><td data-label="Question"><strong>15.</strong> Quel musée est situé à Paris ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMTU=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Le musée du Louvre.</td><td data-label="Explication courte">Le musée du Louvre est situé à Paris. C&#x27;est l&#x27;un des plus grands musées du monde et il abrite notamment la Joconde.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTE1">Cours : Musée du Louvre</a><br><a href="#U0NSX0dMT18wMDk1">Glossaire : Musée du Louvre</a><br><a href="#U0NSX0dMT18wMTMw">Glossaire : Tour Eiffel</a></td></tr>
`endif`
`if @err_CR_V05_Q16 == 1`
<tr><td data-label="Question"><strong>16.</strong> Qui était Auguste Rodin ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMTY=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Un sculpteur français.</td><td data-label="Explication courte">Auguste Rodin est l&#x27;un des plus grands sculpteurs français. Parmi ses œuvres les plus connues figure Le Penseur.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTE2">Cours : Auguste Rodin</a></td></tr>
`endif`
`if @err_CR_V05_Q17 == 1`
<tr><td data-label="Question"><strong>17.</strong> Quel est le classement de la langue française parmi les langues les plus parlées dans le monde ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMTc=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Cinquième.</td><td data-label="Explication courte">Le français est aujourd&#x27;hui considéré comme la cinquième langue la plus parlée dans le monde. Ce classement peut évoluer au fil du temps.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTE3">Cours : Francophonie</a><br><a href="#U0NSX0dMT18wMDYx">Glossaire : Francophonie</a></td></tr>
`endif`
`if @err_CR_V05_Q18 == 1`
<tr><td data-label="Question"><strong>18.</strong> Quelle cathédrale célèbre a été en partie détruite par un incendie en 2019 ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMTg=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Notre-Dame de Paris.</td><td data-label="Explication courte">La cathédrale Notre-Dame de Paris est l&#x27;un des monuments les plus emblématiques de la France.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTE4">Cours : Musée du Louvre</a><br><a href="#U0NSX0dMT18wMDk1">Glossaire : Musée du Louvre</a><br><a href="#U0NSX0dMT18wMTMw">Glossaire : Tour Eiffel</a></td></tr>
`endif`
`if @err_CR_V05_Q19 == 1`
<tr><td data-label="Question"><strong>19.</strong> Qui était une écrivaine française célèbre ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMTk=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — George Sand.</td><td data-label="Explication courte">La France compte de nombreuses écrivaines célèbres. George Sand, Marguerite Yourcenar et Simone de Beauvoir figurent parmi les plus connues.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTE5">Cours : George Sand</a></td></tr>
`endif`
`if @err_CR_V05_Q20 == 1`
<tr><td data-label="Question"><strong>20.</strong> Qui était un célèbre musicien français ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMjA=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Hector Berlioz.</td><td data-label="Explication courte">La France a vu naître de grands compositeurs comme Hector Berlioz, Georges Bizet, Claude Debussy ou Maurice Ravel, dont les œuvres sont connues dans le monde entier.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTIw">Cours : Berlioz</a></td></tr>
`endif`
`if @err_CR_V05_Q21 == 1`
<tr><td data-label="Question"><strong>21.</strong> Qui était Auguste Renoir ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMjE=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Un peintre français.</td><td data-label="Explication courte">Auguste Renoir est un peintre français du XIXᵉ siècle, célèbre pour ses œuvres impressionnistes représentant des scènes de la vie quotidienne et des portraits.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTIx">Cours : Auguste Renoir</a></td></tr>
`endif`
`if @err_CR_V05_Q22 == 1`
<tr><td data-label="Question"><strong>22.</strong> Quelle fête est française ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMjI=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Le 14 juillet.</td><td data-label="Explication courte">Le 14 juillet est la fête nationale française. Elle commémore la prise de la Bastille en 1789 et la Fête de la Fédération de 1790.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTIy">Cours : Fête nationale</a><br><a href="#U0NSX0dMT18wMDU3">Glossaire : Fête nationale</a></td></tr>
`endif`
`if @err_CR_V05_Q23 == 1`
<tr><td data-label="Question"><strong>23.</strong> Quel monument parisien est l&#x27;un des symboles de la France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMjM=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — La tour Eiffel.</td><td data-label="Explication courte">Construite pour l&#x27;Exposition universelle de 1889, la tour Eiffel est aujourd&#x27;hui l&#x27;un des monuments les plus connus au monde et un symbole de la France.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTIz">Cours : Tour Eiffel</a><br><a href="#U0NSX0dMT18wMTMw">Glossaire : Tour Eiffel</a></td></tr>
`endif`
`if @err_CR_V05_Q24 == 1`
<tr><td data-label="Question"><strong>24.</strong> Quelles sont les conditions pour toucher les allocations chômage ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMjQ=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Avoir travaillé et remplir les conditions prévues par la réglementation.</td><td data-label="Explication courte">Les allocations chômage sont versées aux personnes qui remplissent les conditions prévues par la réglementation, notamment une durée minimale d&#x27;activité et une inscription auprès de France Travail.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTI0">Cours : Quelles sont les conditions pour toucher les allocations chômage ?</a></td></tr>
`endif`
`if @err_CR_V05_Q25 == 1`
<tr><td data-label="Question"><strong>25.</strong> Qu&#x27;est-ce que l&#x27;école maternelle ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMjU=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — L&#x27;école qui accueille les jeunes enfants avant l&#x27;école élémentaire.</td><td data-label="Explication courte">L&#x27;école maternelle constitue la première étape de la scolarité. Elle favorise le développement, la socialisation et les premiers apprentissages.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTI1">Cours : École</a><br><a href="#U0NSX0dMT18wMDQ4">Glossaire : École</a></td></tr>
`endif`
`if @err_CR_V05_Q26 == 1`
<tr><td data-label="Question"><strong>26.</strong> Comment s&#x27;appelle le diplôme passé par les élèves à la fin du collège ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMjY=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Le diplôme national du brevet.</td><td data-label="Explication courte">Le diplôme national du brevet évalue les connaissances et compétences acquises à la fin du collège.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTI2">Cours : Collège</a><br><a href="#U0NSX0dMT18wMDIy">Glossaire : Collège</a></td></tr>
`endif`
`if @err_CR_V05_Q27 == 1`
<tr><td data-label="Question"><strong>27.</strong> Les parents d&#x27;élèves ont le droit de :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMjc=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Participer aux réunions organisées par l&#x27;école et échanger avec les enseignants.</td><td data-label="Explication courte">Les parents sont des partenaires de l&#x27;école. Ils peuvent rencontrer les enseignants, participer aux réunions et suivre la scolarité de leur enfant, dans le respect du fonctionnement de l&#x27;établissement.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTI3">Cours : École</a><br><a href="#U0NSX0dMT18wMDQ4">Glossaire : École</a></td></tr>
`endif`
`if @err_CR_V05_Q28 == 1`
<tr><td data-label="Question"><strong>28.</strong> Qui peut manger à la cantine scolaire ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMjg=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Tous les élèves inscrits, selon les règles de la commune ou de l&#x27;établissement.</td><td data-label="Explication courte">La cantine scolaire est un service proposé aux élèves. Les modalités d&#x27;inscription sont fixées par la commune ou l&#x27;établissement, dans le respect du principe d&#x27;égalité d&#x27;accès.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTI4">Cours : Commune</a><br><a href="#U0NSX0dMT18wMDI0">Glossaire : Commune</a></td></tr>
`endif`
</tbody></table>
`endif`
