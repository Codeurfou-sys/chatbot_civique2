`if @err_NAT_V02_Q01 == 1`
<tr><td data-label="Question"><strong>1.</strong> À partir de quel âge devient-on électeur en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTAx">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — 18 ans.</td><td data-label="Explication courte">En France, toute personne remplissant les conditions prévues par la loi devient électeur à partir de 18 ans.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1EwMQ==">Cours : Élection</a><br><a href="#U0NSX0dMT18wMDUw">Glossaire : Élection</a></td></tr>
`endif`
`if @err_NAT_V02_Q02 == 1`
<tr><td data-label="Question"><strong>2.</strong> Le vote est-il obligatoire en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTAy">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Non, c&#x27;est un droit, pas une obligation.</td><td data-label="Explication courte">En France, le vote est un droit civique, mais il n&#x27;est pas obligatoire. Chaque électeur est libre de participer ou non aux élections.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1EwMg==">Cours : Vote</a><br><a href="#U0NSX0dMT18wMTM3">Glossaire : Vote</a></td></tr>
`endif`
`if @err_NAT_V02_Q03 == 1`
<tr><td data-label="Question"><strong>3.</strong> A-t-on le droit de ne pas respecter une loi que l&#x27;on juge injuste ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTAz">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Non, chacun doit respecter la loi.</td><td data-label="Explication courte">L&#x27;État de droit repose sur le respect des lois par tous. Personne n&#x27;est au-dessus de la loi. En cas de désaccord, il existe des voies légales pour la contester.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1EwMw==">Cours : Juge</a><br><a href="#U0NSX0dMT18wMTgw">Glossaire : Juge</a></td></tr>
`endif`
`if @err_NAT_V02_Q04 == 1`
<tr><td data-label="Question"><strong>4.</strong> Que signifie être libre, en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTA0">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Chacun est libre tant qu&#x27;il respecte les droits des autres.</td><td data-label="Explication courte">Les libertés sont garanties par la République, mais elles ne sont pas absolues. Elles s&#x27;exercent dans le respect des droits des autres et de la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1EwNA==">Cours : Liberté</a></td></tr>
`endif`
`if @err_NAT_V02_Q05 == 1`
<tr><td data-label="Question"><strong>5.</strong> Que dit l&#x27;article 1er de la Constitution à propos de la France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTA1">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — La France est une République indivisible, laïque, démocratique et sociale.</td><td data-label="Explication courte">L&#x27;article 1er de la Constitution définit les principes fondamentaux de la République française : « La France est une République indivisible, laïque, démocratique et sociale. » Cette formulation est à connaître par cœur pour l&#x27;examen.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1EwNQ==">Cours : Constitution</a><br><a href="#U0NSX0dMT18wMDMy">Glossaire : Constitution</a><br><a href="#U0NSX0dMT18wMDQw">Glossaire : Démocratie</a></td></tr>
`endif`
`if @err_NAT_V02_Q06 == 1`
<tr><td data-label="Question"><strong>6.</strong> Que garantit la liberté de la presse ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTA2">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — La liberté d&#x27;informer et d&#x27;être informé.</td><td data-label="Explication courte">La liberté de la presse permet aux médias d&#x27;informer le public tout en respectant les lois, notamment celles qui protègent les personnes contre la diffamation, l&#x27;injure ou la provocation à la haine.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1EwNg==">Cours : Liberté de la presse</a></td></tr>
`endif`
`if @err_NAT_V02_Q07 == 1`
<tr><td data-label="Question"><strong>7.</strong> Que permet la liberté de circulation ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTA3">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Se déplacer librement, dans le respect de la loi.</td><td data-label="Explication courte">La liberté de circulation est une liberté fondamentale. Elle permet de se déplacer librement, sous réserve des règles prévues par la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1EwNw==">Cours : Liberté de circulation</a><br><a href="#U0NSX0dMT18wMjE1">Glossaire : Liberté de circulation</a><br><a href="#U0NSX0dMT18wMTc0">Glossaire : Respect</a></td></tr>
`endif`
`if @err_NAT_V02_Q08 == 1`
<tr><td data-label="Question"><strong>8.</strong> Qui est l&#x27;auteur des grandes lois scolaires de la IIIᵉ République rendant l&#x27;école gratuite, laïque et obligatoire ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTA4">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Jules Ferry.</td><td data-label="Explication courte">Jules Ferry est l&#x27;auteur des grandes lois scolaires de la IIIᵉ République. Elles garantissent l&#x27;accès de tous les enfants à une école publique gratuite, laïque et obligatoire.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1EwOA==">Cours : Laïcité</a><br><a href="#U0NSX0dMT18wMDgw">Glossaire : Laïcité</a><br><a href="#U0NSX0dMT18wMDQ4">Glossaire : École</a></td></tr>
`endif`
`if @err_NAT_V02_Q09 == 1`
<tr><td data-label="Question"><strong>9.</strong> Quel roi de France a été guillotiné pendant la Révolution française ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTA5">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Louis XVI.</td><td data-label="Explication courte">Louis XVI est le dernier roi de l&#x27;Ancien Régime. Il est guillotiné le 21 janvier 1793 pendant la Révolution française.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1EwOQ==">Cours : Révolution française</a><br><a href="#U0NSX0dMT18wMTE5">Glossaire : Révolution française</a><br><a href="#U0NSX0dMT18wMjI4">Glossaire : Révolution</a></td></tr>
`endif`
`if @err_NAT_V02_Q10 == 1`
<tr><td data-label="Question"><strong>10.</strong> En quelle année a débuté la Révolution française ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTEw">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — 1789.</td><td data-label="Explication courte">La Révolution française débute en 1789. Cette année marque notamment la prise de la Bastille le 14 juillet et l&#x27;adoption de la Déclaration des droits de l&#x27;Homme et du Citoyen.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1ExMA==">Cours : Révolution française</a><br><a href="#U0NSX0dMT18wMTE5">Glossaire : Révolution française</a><br><a href="#U0NSX0dMT18wMjI4">Glossaire : Révolution</a></td></tr>
`endif`
`if @err_NAT_V02_Q11 == 1`
<tr><td data-label="Question"><strong>11.</strong> En quelle année Napoléon Bonaparte est-il devenu empereur des Français ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTEx">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — 1804.</td><td data-label="Explication courte">Napoléon Bonaparte devient empereur des Français en 1804. Son sacre a lieu le 2 décembre 1804 à Notre-Dame de Paris.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1ExMQ==">Cours : Napoléon Bonaparte</a><br><a href="#U0NSX0dMT18wMjMx">Glossaire : Napoléon Bonaparte</a></td></tr>
`endif`
`if @err_NAT_V02_Q12 == 1`
<tr><td data-label="Question"><strong>12.</strong> À quelle date le général de Gaulle a-t-il lancé son appel à la Résistance depuis Londres ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTEy">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Le 18 juin 1940.</td><td data-label="Explication courte">Le 18 juin 1940, depuis Londres, le général de Gaulle lance un appel à poursuivre le combat contre l&#x27;Allemagne nazie. Cet appel est devenu le symbole de la Résistance française.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1ExMg==">Cours : Résistance</a><br><a href="#U0NSX0dMT18wMTkz">Glossaire : Résistance</a><br><a href="#U0NSX0dMT18wMTIx">Glossaire : Seconde Guerre mondiale</a></td></tr>
`endif`
`if @err_NAT_V02_Q13 == 1`
<tr><td data-label="Question"><strong>13.</strong> Qu&#x27;est-ce que la Shoah ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTEz">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — L&#x27;extermination des Juifs d&#x27;Europe par le régime nazi.</td><td data-label="Explication courte">La Shoah désigne l&#x27;extermination systématique d&#x27;environ six millions de Juifs par le régime nazi entre 1941 et 1945. Son étude participe au devoir de mémoire et à la lutte contre l&#x27;antisémitisme et le racisme.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1ExMw==">Cours : Shoah</a><br><a href="#U0NSX0dMT18wMTk0">Glossaire : Shoah</a></td></tr>
`endif`
`if @err_NAT_V02_Q14 == 1`
<tr><td data-label="Question"><strong>14.</strong> Laquelle de ces œuvres a été écrite par Victor Hugo ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTE0">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Les Misérables.</td><td data-label="Explication courte">Victor Hugo est l&#x27;un des plus grands écrivains français. Parmi ses œuvres les plus célèbres figurent Les Misérables et Notre-Dame de Paris.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1ExNA==">Cours : Victor Hugo</a></td></tr>
`endif`
`if @err_NAT_V02_Q15 == 1`
<tr><td data-label="Question"><strong>15.</strong> Citez un pays ayant été colonisé par la France.<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTE1">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Algérie.</td><td data-label="Explication courte">La France a constitué un vaste empire colonial, notamment en Afrique, en Asie et dans les Caraïbes.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1ExNQ==">Cours : Empire colonial français</a></td></tr>
`endif`
`if @err_NAT_V02_Q16 == 1`
<tr><td data-label="Question"><strong>16.</strong> Depuis quelle année les Français élisent-ils le président de la République au suffrage universel direct ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTE2">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — 1962.</td><td data-label="Explication courte">Le référendum de 1962, voulu par le général de Gaulle, instaure l&#x27;élection du président de la République au suffrage universel direct.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1ExNg==">Cours : Président de la République</a><br><a href="#U0NSX0dMT18wMTA5">Glossaire : Président de la République</a><br><a href="#U0NSX0dMT18wMTI3">Glossaire : Suffrage universel</a></td></tr>
`endif`
`if @err_NAT_V02_Q17 == 1`
<tr><td data-label="Question"><strong>17.</strong> À quel moment la naissance d&#x27;un enfant doit-elle être déclarée ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTE3">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Lors de sa naissance.</td><td data-label="Explication courte">La naissance d&#x27;un enfant doit obligatoirement être déclarée au service de l&#x27;état civil afin qu&#x27;un acte de naissance soit établi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1ExNw==">Cours : Naissance</a><br><a href="#U0NSX0dMT18wMTY3">Glossaire : Naissance</a></td></tr>
`endif`
`if @err_NAT_V02_Q18 == 1`
<tr><td data-label="Question"><strong>18.</strong> Dans quel délai la naissance d&#x27;un enfant doit-elle être déclarée à la mairie ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTE4">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Dans les cinq jours suivant la naissance.</td><td data-label="Explication courte">En France, la déclaration de naissance doit être réalisée dans les cinq jours suivant la naissance auprès de la mairie du lieu de naissance.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1ExOA==">Cours : Mairie</a><br><a href="#U0NSX0dMT18wMDg4">Glossaire : Mairie</a><br><a href="#U0NSX0dMT18wMTY3">Glossaire : Naissance</a></td></tr>
`endif`
`if @err_NAT_V02_Q19 == 1`
<tr><td data-label="Question"><strong>19.</strong> Quel numéro permet de joindre directement la police en cas d&#x27;urgence ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTE5">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — 17.</td><td data-label="Explication courte">Le 17 permet de contacter la police ou la gendarmerie en cas d&#x27;urgence nécessitant leur intervention. Le 112 fonctionne aussi dans toute l&#x27;Union européenne, mais le numéro national dédié à la police reste le 17.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1ExOQ==">Cours : Police</a><br><a href="#U0NSX0dMT18wMTA0">Glossaire : Police</a><br><a href="#U0NSX0dMT18wMTUx">Glossaire : Urgence</a></td></tr>
`endif`
`if @err_NAT_V02_Q20 == 1`
<tr><td data-label="Question"><strong>20.</strong> Quel numéro permet de joindre directement le SAMU en cas d&#x27;urgence médicale ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTIw">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — 15.</td><td data-label="Explication courte">Le 15 permet de contacter le SAMU pour toute urgence médicale nécessitant une intervention rapide.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1EyMA==">Cours : SAMU</a><br><a href="#U0NSX0dMT18wMTUz">Glossaire : SAMU</a><br><a href="#U0NSX0dMT18wMTUx">Glossaire : Urgence</a></td></tr>
`endif`
`if @err_NAT_V02_Q21 == 1`
<tr><td data-label="Question"><strong>21.</strong> Où les parents doivent-ils d&#x27;abord s&#x27;adresser pour inscrire leur enfant à l&#x27;école publique ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTIx">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — À la mairie.</td><td data-label="Explication courte">Pour une école publique, les parents effectuent d&#x27;abord l&#x27;inscription auprès de la mairie, puis présentent les documents demandés par l&#x27;établissement scolaire.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1EyMQ==">Cours : École</a><br><a href="#U0NSX0dMT18wMDQ4">Glossaire : École</a><br><a href="#U0NSX0dMT18wMDg4">Glossaire : Mairie</a></td></tr>
`endif`
`if @err_NAT_V02_Q22 == 1`
<tr><td data-label="Question"><strong>22.</strong> La liberté d&#x27;association est :<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTIy">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Le droit de créer une association, d&#x27;y adhérer ou non.</td><td data-label="Explication courte">La liberté d&#x27;association est une liberté fondamentale. Chacun est libre de créer une association, d&#x27;y adhérer ou de ne pas y adhérer.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1EyMg==">Cours : Liberté d’association</a><br><a href="#U0NSX0dMT18wMjE0">Glossaire : Liberté d’association</a></td></tr>
`endif`
`if @err_NAT_V02_Q23 == 1`
<tr><td data-label="Question"><strong>23.</strong> La liberté d&#x27;expression sur les réseaux sociaux en France est :<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTIz">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Uniquement réservée aux journalistes pour informer les citoyens.</td><td data-label="Explication courte">La liberté d&#x27;expression s&#x27;applique aussi sur Internet et les réseaux sociaux. Cependant, elle ne permet pas d&#x27;insulter, de diffamer, de harceler ou d&#x27;inciter à la haine ou à la violence.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1EyMw==">Cours : Liberté d’expression</a><br><a href="#U0NSX0dMT18wMjEz">Glossaire : Liberté d’expression</a><br><a href="#U0NSX0dMT18wMTkx">Glossaire : Réseaux sociaux</a></td></tr>
`endif`
`if @err_NAT_V02_Q24 == 1`
<tr><td data-label="Question"><strong>24.</strong> Quel prénom évoque un symbole de la République ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTI0">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Marianne.</td><td data-label="Explication courte">Marianne est la représentation symbolique de la République française. Elle incarne les valeurs de liberté, d&#x27;égalité et de fraternité.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1EyNA==">Cours : Marianne</a><br><a href="#U0NSX0dMT18wMDg5">Glossaire : Marianne</a></td></tr>
`endif`
`if @err_NAT_V02_Q25 == 1`
<tr><td data-label="Question"><strong>25.</strong> Citez un symbole qui représente officiellement la République française.<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTI1">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Le drapeau tricolore.</td><td data-label="Explication courte">Les principaux symboles officiels de la République sont le drapeau tricolore, Marianne, la Marseillaise et la devise « Liberté, Égalité, Fraternité ». Le coq, la tour Eiffel et le béret n&#x27;en font pas partie.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1EyNQ==">Cours : Drapeau français</a><br><a href="#U0NSX0dMT18wMDQ2">Glossaire : Drapeau français</a></td></tr>
`endif`
`if @err_NAT_V02_Q26 == 1`
<tr><td data-label="Question"><strong>26.</strong> Parmi ces responsables, lequel est élu (et non nommé) ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTI2">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Le maire.</td><td data-label="Explication courte">Le maire est un élu local. Les autres (préfet et procureur) sont nommés par l&#x27;État. Le Premier ministre est nommé par le président de la République.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1EyNg==">Cours : Maire</a><br><a href="#U0NSX0dMT18wMDg3">Glossaire : Maire</a></td></tr>
`endif`
`if @err_NAT_V02_Q27 == 1`
<tr><td data-label="Question"><strong>27.</strong> Quel est le rôle du maire ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTI3">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Il dirige la commune, applique les décisions du conseil municipal et assure notamment l&#x27;état civil.</td><td data-label="Explication courte">Le maire est l&#x27;exécutif de la commune. Il met en œuvre les décisions du conseil municipal, gère les services municipaux et exerce certaines missions pour le compte de l&#x27;État (l&#x27;inscription des naissances)</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1EyNw==">Cours : Maire</a><br><a href="#U0NSX0dMT18wMDg3">Glossaire : Maire</a><br><a href="#U0NSX0dMT18wMDI5">Glossaire : Conseil municipal</a></td></tr>
`endif`
`if @err_NAT_V02_Q28 == 1`
<tr><td data-label="Question"><strong>28.</strong> Où peut-on demander son inscription sur les listes électorales sans effectuer de démarche en ligne ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDJfUTI4">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — À la mairie de sa commune d&#x27;habitation.</td><td data-label="Explication courte">Les personnes qui ne souhaitent pas effectuer leurs démarches en ligne peuvent demander leur inscription sur les listes électorales directement auprès de la mairie de leur domicile.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAyX1EyOA==">Cours : Listes électorales</a><br><a href="#U0NSX0dMT18wMTU4">Glossaire : Listes électorales</a><br><a href="#U0NSX0dMT18wMDI0">Glossaire : Commune</a></td></tr>
`endif`
</tbody></table>
`endif`
