`endif`
`if @err_CSP_V02_Q32 == 1`
<tr><td data-label="Question"><strong>32.</strong> À qui doit-il s&#x27;adresser en premier ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDJfUTMy">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Son médecin traitant.</td><td data-label="Explication courte">Le médecin traitant est l&#x27;interlocuteur privilégié pour assurer le suivi médical et orienter le patient si nécessaire vers un spécialiste ou vers les urgences.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAyX1EzMg==">Cours : Médecin traitant</a><br><a href="#U0NSX0dMT18wMDky">Glossaire : Médecin traitant</a></td></tr>
`endif`
`if @err_CSP_V02_Q33 == 1`
<tr><td data-label="Question"><strong>33.</strong> Quelle proposition est correcte ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDJfUTMz">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Les libertés individuelles peuvent être limitées pour protéger les droits des autres, l&#x27;ordre public et la sécurité.</td><td data-label="Explication courte">En France, les libertés sont protégées, mais elles s&#x27;exercent dans le respect de la loi, des droits des autres et de l&#x27;ordre public.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAyX1EzMw==">Cours : Ordre public</a><br><a href="#U0NSX0dMT18wMDk5">Glossaire : Ordre public</a></td></tr>
`endif`
`if @err_CSP_V02_Q34 == 1`
<tr><td data-label="Question"><strong>34.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDJfUTM0">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Le Parlement.</td><td data-label="Explication courte">Le pouvoir législatif appartient au Parlement, qui comprend l&#x27;Assemblée nationale et le Sénat. Il vote les lois.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAyX1EzNA==">Cours : Parlement</a><br><a href="#U0NSX0dMT18wMTAx">Glossaire : Parlement</a></td></tr>
`endif`
`if @err_CSP_V02_Q35 == 1`
<tr><td data-label="Question"><strong>35.</strong> D&#x27;après vous, que risque une personne qui ne respecte pas la loi ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDJfUTM1">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Une sanction prévue par la loi.</td><td data-label="Explication courte">Le non-respect de la loi peut entraîner différentes sanctions décidées par la justice, selon la gravité de l&#x27;infraction.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAyX1EzNQ==">Cours : Sanction</a><br><a href="#U0NSX0dMT18wMjI2">Glossaire : Sanction</a></td></tr>
`endif`
`if @err_CSP_V02_Q36 == 1`
<tr><td data-label="Question"><strong>36.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDJfUTM2">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Une écrivaine et philosophe française.</td><td data-label="Explication courte">Simone de Beauvoir est une écrivaine et philosophe française. Son œuvre a marqué la réflexion sur l&#x27;égalité entre les femmes et les hommes.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAyX1EzNg==">Cours : Baudelaire</a></td></tr>
`endif`
`if @err_CSP_V02_Q37 == 1`
<tr><td data-label="Question"><strong>37.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDJfUTM3">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Le président de la République.</td><td data-label="Explication courte">Le président de la République nomme le Premier ministre. Celui-ci dirige ensuite l&#x27;action du gouvernement.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAyX1EzNw==">Cours : Premier ministre</a><br><a href="#U0NSX0dMT18wMTA3">Glossaire : Premier ministre</a><br><a href="#U0NSX0dMT18wMDkz">Glossaire : Ministre</a></td></tr>
`endif`
`if @err_CSP_V02_Q38 == 1`
<tr><td data-label="Question"><strong>38.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDJfUTM4">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — L&#x27;extermination des Juifs d&#x27;Europe par le régime nazi pendant la Seconde Guerre mondiale.</td><td data-label="Explication courte">La Shoah est l&#x27;un des plus grands crimes contre l&#x27;humanité de l&#x27;histoire, avec l&#x27;assassinat de près de six millions de Juifs par le régime nazi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAyX1EzOA==">Cours : Seconde Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTIx">Glossaire : Seconde Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTk0">Glossaire : Shoah</a></td></tr>
`endif`
`if @err_CSP_V02_Q39 == 1`
<tr><td data-label="Question"><strong>39.</strong> Une femme peut-elle créer son entreprise ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDJfUTM5">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Oui, aucune restriction n&#x27;existe. Elle peut créer son entreprise dans n&#x27;importe quel secteur d&#x27;activité.</td><td data-label="Explication courte">En France, les femmes et les hommes disposent des mêmes droits pour créer une entreprise.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAyX1EzOQ==">Cours : Entreprise</a><br><a href="#U0NSX0dMT18wMTQz">Glossaire : Entreprise</a></td></tr>
