#### Connaissances
<table class="v13-errors"><thead><tr><th>Question</th><th>Réponse correcte</th><th>Explication courte</th><th>Notion à revoir</th></tr></thead><tbody>
`if @err_CSP_V01_Q01 == 1`
<tr><td data-label="Question"><strong>1.</strong> À quoi correspond la date du 14 juillet ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTAx">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — La fête nationale française.</td><td data-label="Explication courte">Le 14 juillet est la fête nationale française. Cette journée rappelle un événement majeur de la Révolution française et célèbre les valeurs de la République.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1EwMQ==">Cours : Fête nationale</a><br><a href="#U0NSX0dMT18wMDU3">Glossaire : Fête nationale</a></td></tr>
`endif`
`if @err_CSP_V01_Q02 == 1`
<tr><td data-label="Question"><strong>2.</strong> Quel est l&#x27;un des symboles officiels de la République française ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTAy">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Marianne.</td><td data-label="Explication courte">Les symboles de la République représentent l&#x27;identité de la France et ses valeurs : le drapeau tricolore, Marianne, la Marseillaise et la devise. Le coq est un symbole traditionnel, mais non officiel.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1EwMg==">Cours : Marianne</a><br><a href="#U0NSX0dMT18wMDg5">Glossaire : Marianne</a></td></tr>
`endif`
`if @err_CSP_V01_Q03 == 1`
<tr><td data-label="Question"><strong>3.</strong> Le principe d&#x27;égalité signifie que :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTAz">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Toutes les personnes sont égales devant la loi et bénéficient des mêmes droits.</td><td data-label="Explication courte">L&#x27;égalité garantit que chaque personne bénéficie des mêmes droits et est traitée de la même manière par la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1EwMw==">Cours : Égalité</a><br><a href="#U0NSX0dMT18wMDQ5">Glossaire : Égalité</a></td></tr>
`endif`
`if @err_CSP_V01_Q04 == 1`
<tr><td data-label="Question"><strong>4.</strong> « Liberté, Égalité, Fraternité », c&#x27;est :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTA0">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — La devise de la République française.</td><td data-label="Explication courte">La devise « Liberté, Égalité, Fraternité » exprime les trois valeurs fondamentales de la République française. Elle figure notamment sur les bâtiments publics.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1EwNA==">Cours : Devise de la République</a><br><a href="#U0NSX0dMT18wMDQ0">Glossaire : Devise de la République</a><br><a href="#U0NSX0dMT18wMDYy">Glossaire : Fraternité</a></td></tr>
`endif`
`if @err_CSP_V01_Q05 == 1`
<tr><td data-label="Question"><strong>5.</strong> Qui nomme le Premier ministre ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTA1">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Le président de la République.</td><td data-label="Explication courte">Le président de la République nomme le Premier ministre. Celui-ci dirige ensuite l&#x27;action du gouvernement.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1EwNQ==">Cours : Premier ministre</a><br><a href="#U0NSX0dMT18wMTA3">Glossaire : Premier ministre</a><br><a href="#U0NSX0dMT18wMDkz">Glossaire : Ministre</a></td></tr>
`endif`
`if @err_CSP_V01_Q06 == 1`
<tr><td data-label="Question"><strong>6.</strong> Le Parlement est composé :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTA2">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — De l&#x27;Assemblée nationale et du Sénat.</td><td data-label="Explication courte">Le Parlement français est composé de deux chambres : l&#x27;Assemblée nationale et le Sénat. Ensemble, elles examinent et votent les lois.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1EwNg==">Cours : Parlement</a><br><a href="#U0NSX0dMT18wMTAx">Glossaire : Parlement</a><br><a href="#U0NSX0dMT18wMDA0">Glossaire : Assemblée nationale</a></td></tr>
`endif`
`if @err_CSP_V01_Q07 == 1`
<tr><td data-label="Question"><strong>7.</strong> Qu&#x27;est-ce que le pouvoir exécutif ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTA3">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Il met en œuvre les lois et dirige l&#x27;action du gouvernement.</td><td data-label="Explication courte">Le pouvoir exécutif est chargé de mettre en œuvre les lois votées par le Parlement et d&#x27;assurer la conduite des affaires de l&#x27;État.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1EwNw==">Cours : Pouvoir exécutif</a><br><a href="#U0NSX0dMT18wMTYx">Glossaire : Pouvoir exécutif</a><br><a href="#U0NSX0dMT18wMDY2">Glossaire : Gouvernement</a></td></tr>
`endif`
`if @err_CSP_V01_Q08 == 1`
<tr><td data-label="Question"><strong>8.</strong> Les dirigeants sont élus par les citoyens dans :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTA4">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Une démocratie.</td><td data-label="Explication courte">Dans une démocratie, les citoyens élisent leurs représentants.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1EwOA==">Cours : Démocratie</a><br><a href="#U0NSX0dMT18wMDQw">Glossaire : Démocratie</a></td></tr>
`endif`
`if @err_CSP_V01_Q09 == 1`
<tr><td data-label="Question"><strong>9.</strong> A-t-on le droit de ne pas respecter une loi ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTA5">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Non, tout le monde doit respecter la loi.</td><td data-label="Explication courte">Le respect de la loi est un devoir fondamental. Les lois garantissent les droits, les libertés et la vie en société.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1EwOQ==">Cours : A-t-on le droit de ne pas respecter une loi ?</a></td></tr>
`endif`
`if @err_CSP_V01_Q10 == 1`
<tr><td data-label="Question"><strong>10.</strong> Qui doit respecter la loi ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTEw">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Toutes les personnes présentes sur le territoire français.</td><td data-label="Explication courte">La loi s&#x27;applique à toutes les personnes vivant ou se rendant sur le territoire français. Chacun doit la respecter afin de garantir la sécurité, les droits et les libertés de tous.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1ExMA==">Cours : Qui doit respecter la loi ?</a></td></tr>
`endif`
`if @err_CSP_V01_Q11 == 1`
<tr><td data-label="Question"><strong>11.</strong> Comment s&#x27;appelle la Constitution actuelle de la France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTEx">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — La Constitution de la Ve République.</td><td data-label="Explication courte">La Constitution de la Ve République est le texte fondamental qui organise les institutions françaises et définit leur fonctionnement.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1ExMQ==">Cours : Constitution</a><br><a href="#U0NSX0dMT18wMDMy">Glossaire : Constitution</a></td></tr>
`endif`
`if @err_CSP_V01_Q12 == 1`
<tr><td data-label="Question"><strong>12.</strong> Comment s&#x27;appelle le texte qui énonce les droits et devoirs des personnes résidant en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTEy">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — La Déclaration des droits de l&#x27;homme et du citoyen de 1789.</td><td data-label="Explication courte">Adoptée en 1789 pendant la Révolution française, la Déclaration des droits de l&#x27;homme et du citoyen est le texte fondateur qui énonce les grands principes des droits et des devoirs en France.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1ExMg==">Cours : Carte de résident</a><br><a href="#U0NSX0dMT18wMDEw">Glossaire : Carte de résident</a><br><a href="#U0NSX0dMT18wMDQ3">Glossaire : Droits fondamentaux</a></td></tr>
`endif`
`if @err_CSP_V01_Q13 == 1`
<tr><td data-label="Question"><strong>13.</strong> Concernant les droits individuels, quelle proposition est correcte ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTEz">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Les droits individuels sont garantis à chacun dans le respect de la loi.</td><td data-label="Explication courte">Les droits individuels sont protégés en France. Ils s&#x27;exercent dans le respect de la loi et des droits des autres.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1ExMw==">Cours : Respect</a><br><a href="#U0NSX0dMT18wMTc0">Glossaire : Respect</a></td></tr>
`endif`
`if @err_CSP_V01_Q14 == 1`
<tr><td data-label="Question"><strong>14.</strong> De quelle année date la Déclaration des droits de l&#x27;homme et du citoyen ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTE0">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — 1789.</td><td data-label="Explication courte">La Déclaration des droits de l&#x27;homme et du citoyen a été adoptée en 1789 pendant la Révolution française. Elle constitue l&#x27;un des textes fondateurs de la République.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1ExNA==">Cours : Droits fondamentaux</a><br><a href="#U0NSX0dMT18wMDQ3">Glossaire : Droits fondamentaux</a><br><a href="#U0NSX0dMT18wMDM4">Glossaire : Déclaration des droits de l&#x27;homme et du citoyen</a></td></tr>
`endif`
`if @err_CSP_V01_Q15 == 1`
<tr><td data-label="Question"><strong>15.</strong> En quelle année a débuté la Révolution française ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTE1">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — 1789.</td><td data-label="Explication courte">La Révolution française débute en 1789. Elle marque une étape majeure de l&#x27;histoire de France avec la fin de l&#x27;Ancien Régime et la naissance de nouveaux principes comme la liberté et l&#x27;égalité.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1ExNQ==">Cours : Révolution française</a><br><a href="#U0NSX0dMT18wMTE5">Glossaire : Révolution française</a><br><a href="#U0NSX0dMT18wMjI4">Glossaire : Révolution</a></td></tr>
`endif`
`if @err_CSP_V01_Q16 == 1`
<tr><td data-label="Question"><strong>16.</strong> Qui était Napoléon Ier ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTE2">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Un empereur français.</td><td data-label="Explication courte">Napoléon Bonaparte devient Napoléon Ier en 1804. Il marque profondément l&#x27;histoire de France par ses réformes et ses conquêtes.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1ExNg==">Cours : Napoléon Ier</a></td></tr>
`endif`
`if @err_CSP_V01_Q17 == 1`
<tr><td data-label="Question"><strong>17.</strong> Lequel de ces personnages historiques est français ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTE3">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Napoléon Bonaparte.</td><td data-label="Explication courte">Napoléon Bonaparte est une figure majeure de l&#x27;histoire de France. Les autres personnages appartiennent à l&#x27;histoire du Royaume-Uni, de l&#x27;Italie (Gênes) et de l&#x27;Autriche.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1ExNw==">Cours : Napoléon Bonaparte</a><br><a href="#U0NSX0dMT18wMjMx">Glossaire : Napoléon Bonaparte</a></td></tr>
`endif`
`if @err_CSP_V01_Q18 == 1`
<tr><td data-label="Question"><strong>18.</strong> Dans quelle République est-on aujourd&#x27;hui ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTE4">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — La Ve République.</td><td data-label="Explication courte">La France est aujourd&#x27;hui sous la Ve République, instaurée en 1958 avec la Constitution voulue par le général de Gaulle.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1ExOA==">Cours : République actuelle</a></td></tr>
`endif`
`if @err_CSP_V01_Q19 == 1`
<tr><td data-label="Question"><strong>19.</strong> Qu&#x27;est-ce que la Shoah ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTE5">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — L&#x27;extermination des Juifs d&#x27;Europe par le régime nazi pendant la Seconde Guerre mondiale.</td><td data-label="Explication courte">La Shoah est l&#x27;un des plus grands crimes contre l&#x27;humanité de l&#x27;histoire. Elle a entraîné l&#x27;assassinat de près de six millions de Juifs par le régime nazi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1ExOQ==">Cours : Seconde Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTIx">Glossaire : Seconde Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTk0">Glossaire : Shoah</a></td></tr>
`endif`
`if @err_CSP_V01_Q20 == 1`
<tr><td data-label="Question"><strong>20.</strong> Recherchez un pays du monde qui a été colonisé par la France.<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTIw">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — L&#x27;Algérie.</td><td data-label="Explication courte">Pendant plusieurs siècles, la France a constitué un vaste empire colonial en Afrique, en Asie, dans les Caraïbes et en Océanie (Algérie, Sénégal, Madagascar, Indochine...).</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1EyMA==">Cours : Empire colonial français</a></td></tr>
`endif`
`if @err_CSP_V01_Q21 == 1`
<tr><td data-label="Question"><strong>21.</strong> Qui a rendu l&#x27;école gratuite, laïque et obligatoire ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTIx">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Jules Ferry.</td><td data-label="Explication courte">Les lois Jules Ferry (1881-1882) rendent l&#x27;école primaire gratuite, laïque et obligatoire.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1EyMQ==">Cours : Laïcité</a><br><a href="#U0NSX0dMT18wMDgw">Glossaire : Laïcité</a><br><a href="#U0NSX0dMT18wMDQ4">Glossaire : École</a></td></tr>
`endif`
`if @err_CSP_V01_Q22 == 1`
<tr><td data-label="Question"><strong>22.</strong> Quand a eu lieu la Seconde Guerre mondiale ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTIy">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — 1939-1945.</td><td data-label="Explication courte">La Seconde Guerre mondiale oppose de nombreux pays entre 1939 et 1945. Elle se termine en Europe le 8 mai 1945.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1EyMg==">Cours : Seconde Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTIx">Glossaire : Seconde Guerre mondiale</a></td></tr>
`endif`
`if @err_CSP_V01_Q23 == 1`
<tr><td data-label="Question"><strong>23.</strong> Quand a eu lieu la Première Guerre mondiale ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDFfUTIz">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — 1914-1918.</td><td data-label="Explication courte">La Première Guerre mondiale se déroule de 1914 à 1918. Elle prend fin avec l&#x27;armistice du 11 novembre 1918.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAxX1EyMw==">Cours : Première Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTA4">Glossaire : Première Guerre mondiale</a></td></tr>
`endif`
