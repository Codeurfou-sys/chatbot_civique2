`if @err_NAT_V10_Q31 == 1`
<tr><td data-label="Question"><strong>31.</strong> Qui gère les écoles maternelles et élémentaires publiques ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMTBfUTMx">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — La commune.</td><td data-label="Explication courte">Les communes sont responsables de la construction, de l&#x27;entretien et du fonctionnement des écoles maternelles et élémentaires publiques.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjEwX1EzMQ==">Cours : École</a><br><a href="#U0NSX0dMT18wMDQ4">Glossaire : École</a><br><a href="#U0NSX0dMT18wMDI0">Glossaire : Commune</a></td></tr>
`endif`
`if @err_NAT_V10_Q32 == 1`
<tr><td data-label="Question"><strong>32.</strong> Où est-il autorisé de fumer, alors que c&#x27;est interdit dans de nombreux lieux publics fermés ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMTBfUTMy">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Chez soi.</td><td data-label="Explication courte">En France, il est interdit de fumer dans de nombreux lieux publics fermés afin de protéger la santé de tous. En revanche, il est autorisé de fumer à son domicile.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjEwX1EzMg==">Cours : Majorité numérique</a></td></tr>
`endif`
`if @err_NAT_V10_Q33 == 1`
<tr><td data-label="Question"><strong>33.</strong> Que dit la loi de 1905 ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMTBfUTMz">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Elle sépare les Églises et l&#x27;État et garantit la liberté de conscience.</td><td data-label="Explication courte">La loi de 1905 établit la séparation des Églises et de l&#x27;État. Elle garantit la liberté de conscience et assure que la République ne reconnaît ni ne salarie aucun culte, sous réserve des exceptions prévues par la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjEwX1EzMw==">Cours : Liberté de conscience</a><br><a href="#U0NSX0dMT18wMDgz">Glossaire : Liberté de conscience</a></td></tr>
`endif`
`if @err_NAT_V10_Q34 == 1`
<tr><td data-label="Question"><strong>34.</strong> Quel terme désigne précisément la haine ou les préjugés contre les Juifs ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMTBfUTM0">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — L&#x27;antisémitisme.</td><td data-label="Explication courte">L&#x27;antisémitisme désigne la haine, les préjugés ou les discriminations dirigés contre les personnes juives. En France, il est interdit par la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjEwX1EzNA==">Cours : Haine envers les Juifs</a></td></tr>
`endif`
`if @err_NAT_V10_Q35 == 1`
<tr><td data-label="Question"><strong>35.</strong> Que commémore le 11 novembre, jour férié en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMTBfUTM1">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — L&#x27;Armistice de la Première Guerre mondiale (1918).</td><td data-label="Explication courte">Le 11 novembre commémore l&#x27;Armistice signé en 1918, qui met fin aux combats de la Première Guerre mondiale.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjEwX1EzNQ==">Cours : Jour férié</a><br><a href="#U0NSX0dMT18wMjM4">Glossaire : Jour férié</a><br><a href="#U0NSX0dMT18wMTk2">Glossaire : Esclavage</a></td></tr>
`endif`
`if @err_NAT_V10_Q36 == 1`
