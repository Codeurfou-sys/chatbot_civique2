`if @lastErr26 == 1`
<tr><td data-label="Question"><strong>26.</strong> Quel est le rôle de l&#x27;autorité judiciaire ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDJfUTI2X0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Rendre la justice et veiller au respect de la loi.</td><td data-label="Explication courte">L&#x27;autorité judiciaire est chargée de trancher les litiges, de protéger les libertés individuelles et de sanctionner les infractions conformément à la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAyX1EyNl9MQVNU">Cours : Justice</a><br><a href="#U0NSX0dMT18wMDc3">Glossaire : Justice</a><br><a href="#U0NSX0dMT18wMTc0">Glossaire : Respect</a></td></tr>
`endif`
`if @lastErr27 == 1`
