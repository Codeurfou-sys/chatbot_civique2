`endif`
`if @err_CR_V04_Q25 == 1`
<tr><td data-label="Question"><strong>25.</strong> Quelle ville française fait partie des 10 plus grandes métropoles du pays ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMjU=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Lyon.</td><td data-label="Explication courte">La France compte plusieurs grandes métropoles qui concentrent une grande partie de la population, des emplois et des activités économiques.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTI1">Cours : Quelle ville française fait partie des 10 plus grandes métropoles du pays ?</a></td></tr>
`endif`
`if @err_CR_V04_Q26 == 1`
<tr><td data-label="Question"><strong>26.</strong> Lequel de ces départements de France est le plus touristique ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMjY=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Paris.</td><td data-label="Explication courte">Paris est le département français qui accueille le plus grand nombre de visiteurs grâce à son patrimoine, ses musées et ses monuments.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTI2">Cours : Département</a><br><a href="#U0NSX0dMT18wMDQx">Glossaire : Département</a><br><a href="#U0NSX0dMT18wMDk1">Glossaire : Musée du Louvre</a></td></tr>
`endif`
`if @err_CR_V04_Q27 == 1`
<tr><td data-label="Question"><strong>27.</strong> Quand peut-on visiter gratuitement des lieux culturels en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMjc=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Lors des Journées européennes du patrimoine.</td><td data-label="Explication courte">Chaque année, les Journées européennes du patrimoine permettent au public de visiter gratuitement de nombreux monuments et lieux habituellement fermés ou payants.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTI3">Cours : Journées européennes du patrimoine</a><br><a href="#U0NSX0dMT18wMDc2">Glossaire : Journées européennes du patrimoine</a><br><a href="#U0NSX0dMT18wMTAz">Glossaire : Patrimoine</a></td></tr>
`endif`
`if @err_CR_V04_Q28 == 1`
