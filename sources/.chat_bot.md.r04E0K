`if @err_CSP_V05_Q35 == 1`
<tr><td data-label="Question"><strong>35.</strong> Selon vous, à partir de quel âge a-t-on le droit de voter en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDVfUTM1">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — 18 ans.</td><td data-label="Explication courte">En France, le droit de vote est accordé à partir de 18 ans aux citoyens remplissant les conditions prévues par la loi. Ryan pourra donc voter s&#x27;il s&#x27;inscrit sur les listes électorales.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA1X1EzNQ==">Cours : Président de la République</a><br><a href="#U0NSX0dMT18wMTA5">Glossaire : Président de la République</a><br><a href="#U0NSX0dMT18wMTM3">Glossaire : Vote</a></td></tr>
`endif`
`if @err_CSP_V05_Q36 == 1`
<tr><td data-label="Question"><strong>36.</strong> Que lui conseillez-vous de faire ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDVfUTM2">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Alerter les secours ou les forces de l&#x27;ordre et demander de l&#x27;aide.</td><td data-label="Explication courte">Toute victime de violences doit être protégée.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA1X1EzNg==">Cours : Violence</a><br><a href="#U0NSX0dMT18wMTM2">Glossaire : Violence</a><br><a href="#U0NSX0dMT18wMDA1">Glossaire : Assistance à personne en danger</a></td></tr>
`endif`
`if @err_CSP_V05_Q37 == 1`
<tr><td data-label="Question"><strong>37.</strong> Que lui répondez-vous sur l&#x27;accès aux soins en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDVfUTM3">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Toute personne peut accéder aux soins selon les règles prévues par la loi.</td><td data-label="Explication courte">En France, l&#x27;accès aux soins est organisé pour permettre à chacun d&#x27;être soigné dans le respect des règles du système de santé.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA1X1EzNw==">Cours : Accès aux soins</a></td></tr>
`endif`
`if @err_CSP_V05_Q38 == 1`
<tr><td data-label="Question"><strong>38.</strong> Quelle définition choisissez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDVfUTM4">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Recruter, transporter ou exploiter des personnes par la contrainte, la violence, la menace ou la tromperie.</td><td data-label="Explication courte">La traite des êtres humains est un crime grave puni par la loi, qui peut prendre la forme de travail forcé, de prostitution ou d&#x27;autres formes d&#x27;exploitation.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA1X1EzOA==">Cours : Traite des êtres humains</a><br><a href="#U0NSX0dMT18wMTMx">Glossaire : Traite des êtres humains</a><br><a href="#U0NSX0dMT18wMTM2">Glossaire : Violence</a></td></tr>
