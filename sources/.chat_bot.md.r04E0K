`endif`
`if @err_CR_V02_Q07 == 1`
<tr><td data-label="Question"><strong>7.</strong> Que contient la Constitution ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMDc=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Les règles d&#x27;organisation des pouvoirs publics et les principes fondamentaux de la République.</td><td data-label="Explication courte">La Constitution est le texte juridique le plus important de la République française. Elle fixe les règles de fonctionnement des institutions et garantit les principes fondamentaux.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTA3">Cours : Constitution</a><br><a href="#U0NSX0dMT18wMDMy">Glossaire : Constitution</a></td></tr>
`endif`
`if @err_CR_V02_Q08 == 1`
<tr><td data-label="Question"><strong>8.</strong> Durant le mandat de quel président la peine de mort a-t-elle été abolie ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMDg=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — François Mitterrand.</td><td data-label="Explication courte">La peine de mort qui a été abolie en France en 1981, sous la présidence de François Mitterrand. La loi a été portée par le garde des Sceaux Robert Badinter.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTA4">Cours : Peine de mort</a><br><a href="#U0NSX0dMT18wMTg0">Glossaire : Peine de mort</a><br><a href="#U0NSX0dMT18wMTU0">Glossaire : Mandat</a></td></tr>
`endif`
`if @err_CR_V02_Q09 == 1`
<tr><td data-label="Question"><strong>9.</strong> Quel régime politique a été mis en place pendant la Révolution française en 1792 ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMDk=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — La Première République.</td><td data-label="Explication courte">Le 21 septembre 1792, la monarchie est abolie et la Première République est proclamée.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTA5">Cours : Révolution française</a><br><a href="#U0NSX0dMT18wMTE5">Glossaire : Révolution française</a><br><a href="#U0NSX0dMT18wMjI4">Glossaire : Révolution</a></td></tr>
`endif`
`if @err_CR_V02_Q10 == 1`
<tr><td data-label="Question"><strong>10.</strong> Qui était une figure de la Résistance française pendant la Seconde Guerre mondiale ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMTA=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Jean Moulin.</td><td data-label="Explication courte">Jean Moulin est l&#x27;une des principales figures de la Résistance française. Il a contribué à unifier les mouvements de résistance à la demande du général de Gaulle.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTEw">Cours : Seconde Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTIx">Glossaire : Seconde Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTkz">Glossaire : Résistance</a></td></tr>
`endif`
`if @err_CR_V02_Q11 == 1`
<tr><td data-label="Question"><strong>11.</strong> En 1944, qu&#x27;est-ce qui a changé pour les femmes ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMTE=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Elles ont obtenu le droit de vote et d&#x27;éligibilité.</td><td data-label="Explication courte">L&#x27;ordonnance du 21 avril 1944 accorde aux femmes le droit de vote et d&#x27;éligibilité. Elles votent pour la première fois en 1945.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTEx">Cours : Vote</a><br><a href="#U0NSX0dMT18wMTM3">Glossaire : Vote</a><br><a href="#U0NSX0dMT18wMTU3">Glossaire : Éligibilité</a></td></tr>
`endif`
`if @err_CR_V02_Q12 == 1`
<tr><td data-label="Question"><strong>12.</strong> Quelle organisation internationale a été créée en 1945 après la Seconde Guerre mondiale ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMTI=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — L&#x27;Organisation des Nations unies (ONU).</td><td data-label="Explication courte">L&#x27;ONU a été créée après la Seconde Guerre mondiale afin de maintenir la paix, promouvoir les droits humains et encourager la coopération internationale.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTEy">Cours : Seconde Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTIx">Glossaire : Seconde Guerre mondiale</a></td></tr>
`endif`
`if @err_CR_V02_Q13 == 1`
<tr><td data-label="Question"><strong>13.</strong> Quelle peine a été supprimée en 1981 ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMTM=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — La peine de mort.</td><td data-label="Explication courte">La peine de mort a été abolie en France en 1981 grâce à la loi portée par Robert Badinter, sous la présidence de François Mitterrand.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTEz">Cours : Peine de mort</a><br><a href="#U0NSX0dMT18wMTg0">Glossaire : Peine de mort</a></td></tr>
`endif`
`if @err_CR_V02_Q14 == 1`
<tr><td data-label="Question"><strong>14.</strong> En quelle année l&#x27;euro est-il devenu la monnaie utilisée en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMTQ=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — 2002.</td><td data-label="Explication courte">L&#x27;euro est devenu la monnaie utilisée en France le 1er janvier 2002, avec la mise en circulation des pièces et des billets.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTE0">Cours : Euro</a><br><a href="#U0NSX0dMT18wMDU1">Glossaire : Euro</a></td></tr>
`endif`
`if @err_CR_V02_Q15 == 1`
<tr><td data-label="Question"><strong>15.</strong> En quelle année a commencé la Première Guerre mondiale ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMTU=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — 1914.</td><td data-label="Explication courte">La Première Guerre mondiale débute en 1914 et se termine en 1918.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTE1">Cours : Première Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTA4">Glossaire : Première Guerre mondiale</a></td></tr>
`endif`
`if @err_CR_V02_Q16 == 1`
<tr><td data-label="Question"><strong>16.</strong> Où a eu lieu le débarquement en 1944 ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMTY=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — En Normandie.</td><td data-label="Explication courte">Le 6 juin 1944, les forces alliées débarquent en Normandie. Cet événement marque le début de la libération de la France occupée.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTE2">Cours : Normandie</a></td></tr>
`endif`
`if @err_CR_V02_Q17 == 1`
<tr><td data-label="Question"><strong>17.</strong> Quelle est l&#x27;une des conditions pour passer l&#x27;examen du permis de conduire ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMTc=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Avoir l&#x27;âge minimum requis.</td><td data-label="Explication courte">Pour passer le permis de conduire, il faut notamment respecter l&#x27;âge minimum prévu par la réglementation et satisfaire aux autres conditions fixées par la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTE3">Cours : Permis de conduire</a></td></tr>
`endif`
`if @err_CR_V02_Q18 == 1`
<tr><td data-label="Question"><strong>18.</strong> Un bail locatif est valide s&#x27;il est :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMTg=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Écrit et signé par le propriétaire et le locataire.</td><td data-label="Explication courte">Le contrat de location (bail) doit être établi par écrit et signé par le propriétaire et le locataire afin de fixer les droits et obligations de chacun.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTE4">Cours : Bail</a><br><a href="#U0NSX0dMT18wMDA3">Glossaire : Bail</a><br><a href="#U0NSX0dMT18wMDg0">Glossaire : Locataire</a></td></tr>
`endif`
`if @err_CR_V02_Q19 == 1`
<tr><td data-label="Question"><strong>19.</strong> Où peut-on déposer un lave-vaisselle cassé ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMTk=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Dans une déchèterie ou un point de collecte prévu pour les encombrants.</td><td data-label="Explication courte">Les appareils électroménagers usagés doivent être déposés dans une déchèterie ou repris par un distributeur lors de l&#x27;achat d&#x27;un appareil neuf. Ils ne doivent pas être abandonnés sur la voie publique.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTE5">Cours : Déchèterie</a><br><a href="#U0NSX0dMT18wMTg4">Glossaire : Déchèterie</a></td></tr>
`endif`
`if @err_CR_V02_Q20 == 1`
<tr><td data-label="Question"><strong>20.</strong> Quel numéro d&#x27;urgence permet d&#x27;appeler la police ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMjA=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — 17.</td><td data-label="Explication courte">Le 17 permet de joindre la police ou la gendarmerie en cas d&#x27;urgence. Le 112 est le numéro d&#x27;urgence européen, utilisable dans toute l&#x27;Union européenne.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTIw">Cours : Police</a><br><a href="#U0NSX0dMT18wMTA0">Glossaire : Police</a><br><a href="#U0NSX0dMT18wMTUx">Glossaire : Urgence</a></td></tr>
`endif`
`if @err_CR_V02_Q21 == 1`
<tr><td data-label="Question"><strong>21.</strong> Concernant l&#x27;accès aux soins, quelle proposition est correcte ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMjE=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Toute personne peut accéder aux soins en France.</td><td data-label="Explication courte">En France, chacun peut accéder aux soins. Les modalités de prise en charge dépendent de la situation de la personne, mais l&#x27;accès aux soins est un principe fondamental.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTIx">Cours : Santé</a></td></tr>
`endif`
`if @err_CR_V02_Q22 == 1`
<tr><td data-label="Question"><strong>22.</strong> Sur quel site internet peut-on retrouver les symboles de la République française ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMjI=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Sur le site de l&#x27;Élysée.</td><td data-label="Explication courte">Le site officiel de la Présidence de la République présente les symboles de la République française, notamment le drapeau, Marianne, la Marseillaise et la devise.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTIy">Cours : Sur quel site internet peut-on retrouver les symboles de la République française ?</a></td></tr>
`endif`
`if @err_CR_V02_Q23 == 1`
<tr><td data-label="Question"><strong>23.</strong> Complétez ces paroles de la Marseillaise : « Aux armes [...] ! Formez vos bataillons. »<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMjM=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Citoyens.</td><td data-label="Explication courte">La Marseillaise est l&#x27;hymne national français. Chaque citoyen est invité à connaître ses paroles et leur signification.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTIz">Cours : La Marseillaise</a><br><a href="#U0NSX0dMT18wMDc4">Glossaire : La Marseillaise</a></td></tr>
`endif`
`if @err_CR_V02_Q24 == 1`
<tr><td data-label="Question"><strong>24.</strong> Complétez les paroles de la Marseillaise : « Allons enfants de la Patrie [...] »<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMjQ=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Le jour de gloire est arrivé.</td><td data-label="Explication courte">Ces paroles ouvrent la Marseillaise, l&#x27;hymne national de la République française.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTI0">Cours : La Marseillaise</a><br><a href="#U0NSX0dMT18wMDc4">Glossaire : La Marseillaise</a></td></tr>
`endif`
`if @err_CR_V02_Q25 == 1`
<tr><td data-label="Question"><strong>25.</strong> En application de la liberté individuelle, quelle proposition est correcte ? Une personne peut :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMjU=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Choisir sa religion ou ne pas en avoir.</td><td data-label="Explication courte">En France, chacun est libre de pratiquer une religion, d&#x27;en changer ou de ne pas avoir de religion. Cette liberté est protégée par la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTI1">Cours : Liberté de conscience</a><br><a href="#U0NSX0dMT18wMDgz">Glossaire : Liberté de conscience</a><br><a href="#U0NSX0dMT18wMTc1">Glossaire : Religion</a></td></tr>
`endif`
`if @err_CR_V02_Q26 == 1`
<tr><td data-label="Question"><strong>26.</strong> Est-ce que le vote est obligatoire ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMjY=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Non.</td><td data-label="Explication courte">En France, le vote est un droit civique. Il est libre : chacun peut choisir de voter ou de s&#x27;abstenir.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTI2">Cours : Vote</a><br><a href="#U0NSX0dMT18wMTM3">Glossaire : Vote</a></td></tr>
`endif`
`if @err_CR_V02_Q27 == 1`
<tr><td data-label="Question"><strong>27.</strong> À la fin de son mandat, le président de la République peut-il décider de rester au pouvoir ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMjc=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Non.</td><td data-label="Explication courte">Le mandat présidentiel est limité dans le temps. En démocratie, le renouvellement des mandats s&#x27;effectue par l&#x27;élection.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTI3">Cours : Président de la République</a><br><a href="#U0NSX0dMT18wMTA5">Glossaire : Président de la République</a><br><a href="#U0NSX0dMT18wMTU0">Glossaire : Mandat</a></td></tr>
`endif`
`if @err_CR_V02_Q28 == 1`
<tr><td data-label="Question"><strong>28.</strong> Qui dirige l&#x27;action du gouvernement ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwMl9RMjg=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Le Premier ministre.</td><td data-label="Explication courte">Selon la Constitution, le Premier ministre dirige l&#x27;action du gouvernement et veille à l&#x27;exécution des lois.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDJfUTI4">Cours : Gouvernement</a><br><a href="#U0NSX0dMT18wMDY2">Glossaire : Gouvernement</a><br><a href="#U0NSX0dMT18wMTA3">Glossaire : Premier ministre</a></td></tr>
`endif`
</tbody></table>
`endif`
