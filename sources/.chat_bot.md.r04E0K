`if @err_CR_V05_Q05 == 1`
<tr><td data-label="Question"><strong>5.</strong> Quel est le régime politique de la France aujourd&#x27;hui ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNV9RMDU=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Une République.</td><td data-label="Explication courte">La France est une République indivisible, laïque, démocratique et sociale, conformément à l&#x27;article 1er de la Constitution.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDVfUTA1">Cours : France</a></td></tr>
`endif`
`if @err_CR_V05_Q06 == 1`
