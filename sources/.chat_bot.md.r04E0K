`if @err_NAT_V10_Q03 == 1`
<tr><td data-label="Question"><strong>3.</strong> Citez une condition nécessaire pour voter à l&#x27;élection présidentielle.<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMTBfUTAz">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Être de nationalité française.</td><td data-label="Explication courte">Pour voter à l&#x27;élection présidentielle, plusieurs conditions doivent être remplies, notamment être français, majeur, inscrit sur une liste électorale et disposer de ses droits civils et politiques.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjEwX1EwMw==">Cours : Élection présidentielle</a><br><a href="#U0NSX0dMT18wMjIx">Glossaire : Élection présidentielle</a><br><a href="#U0NSX0dMT18wMTM3">Glossaire : Vote</a></td></tr>
`endif`
`if @err_NAT_V10_Q04 == 1`
<tr><td data-label="Question"><strong>4.</strong> Qu&#x27;est-ce que le devoir de mémoire ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMTBfUTA0">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Se souvenir des événements tragiques du passé afin de transmettre leur histoire et d&#x27;éviter qu&#x27;ils ne se reproduisent.</td><td data-label="Explication courte">Le devoir de mémoire est une valeur importante en France.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjEwX1EwNA==">Cours : Devoir</a><br><a href="#U0NSX0dMT18wMjA5">Glossaire : Devoir</a></td></tr>
`endif`
`if @err_NAT_V10_Q05 == 1`
<tr><td data-label="Question"><strong>5.</strong> Quelle est l&#x27;une des conséquences si un juge prononce une privation des droits civils et politiques pendant 5 ans à l&#x27;encontre d&#x27;une personne ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMTBfUTA1">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Elle ne peut plus voter ni être candidate à une élection.</td><td data-label="Explication courte">Dans certains cas prévus par la loi, un juge peut prononcer une privation des droits civils et politiques.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjEwX1EwNQ==">Cours : Juge</a><br><a href="#U0NSX0dMT18wMTgw">Glossaire : Juge</a><br><a href="#U0NSX0dMT18wMTM3">Glossaire : Vote</a></td></tr>
`endif`
`if @err_NAT_V10_Q06 == 1`
<tr><td data-label="Question"><strong>6.</strong> Quel est l&#x27;objectif du droit de grève ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMTBfUTA2">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Défendre les intérêts professionnels des salariés.</td><td data-label="Explication courte">Le droit de grève est une liberté reconnue par la Constitution. Il permet aux salariés de cesser collectivement le travail afin de défendre leurs intérêts professionnels.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjEwX1EwNg==">Cours : Grève</a><br><a href="#U0NSX0dMT18wMTQ2">Glossaire : Grève</a></td></tr>
`endif`
`if @err_NAT_V10_Q07 == 1`
<tr><td data-label="Question"><strong>7.</strong> Au nom de quoi certaines libertés peuvent-elles être limitées par la loi ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMTBfUTA3">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — L&#x27;intérêt général.</td><td data-label="Explication courte">Certaines libertés peuvent être limitées afin de protéger l&#x27;intérêt général, par exemple pour assurer la sécurité, la santé publique ou les droits d&#x27;autrui. Le confinement lié au COVID-19 en est un exemple parfait.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjEwX1EwNw==">Cours : Intérêt général</a><br><a href="#U0NSX0dMT18wMTcz">Glossaire : Intérêt général</a></td></tr>
`endif`
`if @err_NAT_V10_Q08 == 1`
<tr><td data-label="Question"><strong>8.</strong> Quel fleuve traverse Paris ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMTBfUTA4">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — La Seine.</td><td data-label="Explication courte">La Seine traverse Paris avant de se jeter dans la Manche au Havre. Les quais de Seine sont inscrits au patrimoine mondial de l&#x27;UNESCO.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjEwX1EwOA==">Cours : Fleuve</a><br><a href="#U0NSX0dMT18wMjAy">Glossaire : Fleuve</a><br><a href="#U0NSX0dMT18wMDk1">Glossaire : Musée du Louvre</a></td></tr>
`endif`
`if @err_NAT_V10_Q09 == 1`
<tr><td data-label="Question"><strong>9.</strong> Parmi ces textes, lequel a été adopté sous Napoléon Ier ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMTBfUTA5">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Le Code civil de 1804.</td><td data-label="Explication courte">Le Code civil, promulgué en 1804 sous Napoléon Ier, rassemble les principales règles du droit civil français (famille, propriété, contrats...). Il constitue l&#x27;un des fondements du droit français actuel.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjEwX1EwOQ==">Cours : Code civil</a></td></tr>
`endif`
`if @err_NAT_V10_Q10 == 1`
<tr><td data-label="Question"><strong>10.</strong> Lequel de ces noms est celui d&#x27;un président de la Ve République ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMTBfUTEw">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Georges Pompidou.</td><td data-label="Explication courte">Depuis la création de la Ve République en 1958, plusieurs présidents de la République se sont succédé, dont Charles de Gaulle, Georges Pompidou, Valéry Giscard d&#x27;Estaing, François Mitterrand, Jacques Chirac, Nicolas Sarkozy, François Hollande et Emmanuel Macron.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjEwX1ExMA==">Cours : Président de la République</a><br><a href="#U0NSX0dMT18wMTA5">Glossaire : Président de la République</a></td></tr>
`endif`
`if @err_NAT_V10_Q11 == 1`
<tr><td data-label="Question"><strong>11.</strong> Que célèbre la fête nationale française du 14 juillet ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMTBfUTEx">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — La prise de la Bastille.</td><td data-label="Explication courte">Le 14 juillet est la fête nationale française. Elle commémore la prise de la Bastille (1789) et symbolise les valeurs de la République.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjEwX1ExMQ==">Cours : Fête nationale</a><br><a href="#U0NSX0dMT18wMDU3">Glossaire : Fête nationale</a><br><a href="#U0NSX0dMT18wMjI5">Glossaire : Bastille</a></td></tr>
`endif`
`if @err_NAT_V10_Q12 == 1`
<tr><td data-label="Question"><strong>12.</strong> Quel était l&#x27;objectif des lois scolaires de la IIIe République ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMTBfUTEy">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Rendre l&#x27;école gratuite, laïque et obligatoire.</td><td data-label="Explication courte">Les lois de Jules Ferry (1881-1882) rendent progressivement l&#x27;école primaire gratuite, laïque et obligatoire.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjEwX1ExMg==">Cours : Laïcité</a><br><a href="#U0NSX0dMT18wMDgw">Glossaire : Laïcité</a><br><a href="#U0NSX0dMT18wMDQ4">Glossaire : École</a></td></tr>
