`if @lastErr2 == 1`
<tr><td data-label="Question"><strong>2.</strong> Quand a eu lieu la Seconde Guerre mondiale ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDNfUTAyX0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — 1939 -1945.</td><td data-label="Explication courte">La Seconde Guerre mondiale s&#x27;est déroulée de 1939 à 1945. Elle a profondément marqué la France, l&#x27;Europe et le monde.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAzX1EwMl9MQVNU">Cours : Seconde Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTIx">Glossaire : Seconde Guerre mondiale</a></td></tr>
`endif`
`if @lastErr3 == 1`
<tr><td data-label="Question"><strong>3.</strong> Quand a eu lieu la Première Guerre mondiale ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDNfUTAzX0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — 1914-1918.</td><td data-label="Explication courte">La Première Guerre mondiale oppose principalement les puissances alliées aux Empires centraux entre 1914 et 1918.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAzX1EwM19MQVNU">Cours : Première Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTA4">Glossaire : Première Guerre mondiale</a></td></tr>
`endif`
`if @lastErr4 == 1`
<tr><td data-label="Question"><strong>4.</strong> Sous quel président, la peine de mort a-t-elle été abolie en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDNfUTA0X0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — François Mitterrand.</td><td data-label="Explication courte">La peine de mort est abolie en 1981, sous la présidence de François Mitterrand, grâce au projet défendu par le garde des Sceaux Robert Badinter.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAzX1EwNF9MQVNU">Cours : Peine de mort</a><br><a href="#U0NSX0dMT18wMTg0">Glossaire : Peine de mort</a><br><a href="#U0NSX0dMT18wMTA5">Glossaire : Président de la République</a></td></tr>
`endif`
`if @lastErr5 == 1`
<tr><td data-label="Question"><strong>5.</strong> Que commémore le 8 mai, jour férié en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDNfUTA1X0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — La victoire des Alliés sur l&#x27;Allemagne nazie en 1945.</td><td data-label="Explication courte">Le 8 mai est un jour férié en France. Il commémore la victoire des Alliés en 1945 et rend hommage aux combattants de la Seconde Guerre mondiale.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAzX1EwNV9MQVNU">Cours : Jour férié</a><br><a href="#U0NSX0dMT18wMjM4">Glossaire : Jour férié</a></td></tr>
`endif`
`if @lastErr6 == 1`
<tr><td data-label="Question"><strong>6.</strong> Quelle est la première étape de la construction européenne, créée en 1951 ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDNfUTA2X0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — La Communauté européenne du charbon et de l&#x27;acier (CECA).</td><td data-label="Explication courte">Créée en 1951, la CECA constitue la première étape de la construction européenne. Elle réunit six États fondateurs afin de favoriser la paix et la coopération économique.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAzX1EwNl9MQVNU">Cours : CECA</a><br><a href="#U0NSX0dMT18wMjA1">Glossaire : CECA</a></td></tr>
`endif`
`if @lastErr7 == 1`
<tr><td data-label="Question"><strong>7.</strong> Qui était une figure de la Résistance française pendant la Seconde Guerre mondiale ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDNfUTA3X0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Jean Moulin.</td><td data-label="Explication courte">Jean Moulin est chargé par le général de Gaulle d&#x27;unifier les mouvements de Résistance. Arrêté en 1943, il meurt sous la torture sans avoir livré d&#x27;informations.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAzX1EwN19MQVNU">Cours : Seconde Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTIx">Glossaire : Seconde Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTkz">Glossaire : Résistance</a></td></tr>
`endif`
`if @lastErr8 == 1`
<tr><td data-label="Question"><strong>8.</strong> Que commémore le 11 novembre, jour férié en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDNfUTA4X0xBU1Q=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — L&#x27;Armistice de la Première Guerre mondiale.</td><td data-label="Explication courte">Le 11 novembre commémore l&#x27;Armistice signé en 1918, qui met fin aux combats de la Première Guerre mondiale.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAzX1EwOF9MQVNU">Cours : Jour férié</a><br><a href="#U0NSX0dMT18wMjM4">Glossaire : Jour férié</a><br><a href="#U0NSX0dMT18wMTA4">Glossaire : Première Guerre mondiale</a></td></tr>
