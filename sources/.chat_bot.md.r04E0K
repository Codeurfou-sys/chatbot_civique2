`endif`
`if @err_NAT_V03_Q03 == 1`
<tr><td data-label="Question"><strong>3.</strong> Quand a eu lieu la Première Guerre mondiale ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDNfUTAz">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — 1914-1918.</td><td data-label="Explication courte">La Première Guerre mondiale oppose principalement les puissances alliées aux Empires centraux entre 1914 et 1918.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAzX1EwMw==">Cours : Première Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTA4">Glossaire : Première Guerre mondiale</a></td></tr>
`endif`
`if @err_NAT_V03_Q04 == 1`
<tr><td data-label="Question"><strong>4.</strong> Sous quel président, la peine de mort a-t-elle été abolie en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDNfUTA0">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — François Mitterrand.</td><td data-label="Explication courte">La peine de mort est abolie en 1981, sous la présidence de François Mitterrand, grâce au projet défendu par le garde des Sceaux Robert Badinter.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAzX1EwNA==">Cours : Peine de mort</a><br><a href="#U0NSX0dMT18wMTg0">Glossaire : Peine de mort</a><br><a href="#U0NSX0dMT18wMTA5">Glossaire : Président de la République</a></td></tr>
`endif`
`if @err_NAT_V03_Q05 == 1`
<tr><td data-label="Question"><strong>5.</strong> Que commémore le 8 mai, jour férié en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDNfUTA1">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — La victoire des Alliés sur l&#x27;Allemagne nazie en 1945.</td><td data-label="Explication courte">Le 8 mai est un jour férié en France. Il commémore la victoire des Alliés en 1945 et rend hommage aux combattants de la Seconde Guerre mondiale.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAzX1EwNQ==">Cours : Jour férié</a><br><a href="#U0NSX0dMT18wMjM4">Glossaire : Jour férié</a></td></tr>
`endif`
`if @err_NAT_V03_Q06 == 1`
<tr><td data-label="Question"><strong>6.</strong> Quelle est la première étape de la construction européenne, créée en 1951 ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDNfUTA2">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — La Communauté européenne du charbon et de l&#x27;acier (CECA).</td><td data-label="Explication courte">Créée en 1951, la CECA constitue la première étape de la construction européenne. Elle réunit six États fondateurs afin de favoriser la paix et la coopération économique.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAzX1EwNg==">Cours : CECA</a><br><a href="#U0NSX0dMT18wMjA1">Glossaire : CECA</a></td></tr>
`endif`
`if @err_NAT_V03_Q07 == 1`
<tr><td data-label="Question"><strong>7.</strong> Qui était une figure de la Résistance française pendant la Seconde Guerre mondiale ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDNfUTA3">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Jean Moulin.</td><td data-label="Explication courte">Jean Moulin est chargé par le général de Gaulle d&#x27;unifier les mouvements de Résistance. Arrêté en 1943, il meurt sous la torture sans avoir livré d&#x27;informations.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAzX1EwNw==">Cours : Seconde Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTIx">Glossaire : Seconde Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTkz">Glossaire : Résistance</a></td></tr>
`endif`
`if @err_NAT_V03_Q08 == 1`
<tr><td data-label="Question"><strong>8.</strong> Que commémore le 11 novembre, jour férié en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDNfUTA4">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — L&#x27;Armistice de la Première Guerre mondiale.</td><td data-label="Explication courte">Le 11 novembre commémore l&#x27;Armistice signé en 1918, qui met fin aux combats de la Première Guerre mondiale.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAzX1EwOA==">Cours : Jour férié</a><br><a href="#U0NSX0dMT18wMjM4">Glossaire : Jour férié</a><br><a href="#U0NSX0dMT18wMTA4">Glossaire : Première Guerre mondiale</a></td></tr>
`endif`
`if @err_NAT_V03_Q09 == 1`
<tr><td data-label="Question"><strong>9.</strong> Depuis quelle année l&#x27;esclavage est-il définitivement aboli en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDNfUTA5">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — 1848.</td><td data-label="Explication courte">L&#x27;esclavage est définitivement aboli en France par le décret du 27 avril 1848.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAzX1EwOQ==">Cours : Esclavage</a><br><a href="#U0NSX0dMT18wMTk2">Glossaire : Esclavage</a><br><a href="#U0NSX0dMT18wMTMx">Glossaire : Traite des êtres humains</a></td></tr>
`endif`
`if @err_NAT_V03_Q10 == 1`
<tr><td data-label="Question"><strong>10.</strong> Après un divorce, qui exerce l&#x27;autorité parentale sur les enfants ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDNfUTEw">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Les deux parents, sauf décision contraire du juge.</td><td data-label="Explication courte">Le divorce ne met pas fin à l&#x27;autorité parentale. En règle générale, les deux parents continuent à prendre ensemble les décisions importantes concernant leur enfant.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAzX1ExMA==">Cours : Autorité parentale</a><br><a href="#U0NSX0dMT18wMTcw">Glossaire : Autorité parentale</a><br><a href="#U0NSX0dMT18wMTY4">Glossaire : Divorce</a></td></tr>
`endif`
`if @err_NAT_V03_Q11 == 1`
<tr><td data-label="Question"><strong>11.</strong> Quel dispositif permet, sous conditions de ressources, de prendre en charge les frais de justice, notamment les honoraires d&#x27;avocat ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDNfUTEx">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — L&#x27;aide juridictionnelle.</td><td data-label="Explication courte">L&#x27;aide juridictionnelle permet, sous conditions de ressources, de prendre en charge tout ou partie des frais de justice, notamment les honoraires d&#x27;un avocat.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAzX1ExMQ==">Cours : Avocat</a><br><a href="#U0NSX0dMT18wMTgx">Glossaire : Avocat</a><br><a href="#U0NSX0dMT18wMDc3">Glossaire : Justice</a></td></tr>
`endif`
`if @err_NAT_V03_Q12 == 1`
<tr><td data-label="Question"><strong>12.</strong> Qui peut demander le divorce en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDNfUTEy">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — L&#x27;un des deux époux ou les deux ensemble.</td><td data-label="Explication courte">En France, un divorce peut être demandé par l&#x27;un des époux ou être engagé d&#x27;un commun accord selon les modalités prévues par la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAzX1ExMg==">Cours : Divorce</a><br><a href="#U0NSX0dMT18wMTY4">Glossaire : Divorce</a></td></tr>
`endif`
`if @err_NAT_V03_Q13 == 1`
<tr><td data-label="Question"><strong>13.</strong> Auprès de quel organisme demander le remboursement principal de ses frais de santé ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDNfUTEz">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — La Caisse Primaire d&#x27;Assurance Maladie (CPAM ou appelée aussi Assurance maladie).</td><td data-label="Explication courte">L&#x27;Assurance maladie prend en charge une partie des dépenses de santé. Une mutuelle peut ensuite compléter ce remboursement.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAzX1ExMw==">Cours : Assurance maladie</a><br><a href="#U0NSX0dMT18wMDA2">Glossaire : Assurance maladie</a><br><a href="#U0NSX0dMT18wMDM2">Glossaire : CPAM</a></td></tr>
`endif`
`if @err_NAT_V03_Q14 == 1`
<tr><td data-label="Question"><strong>14.</strong> En France, la contraception est :<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDNfUTE0">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Un choix personnel et un droit, accessible aux femmes comme aux hommes.</td><td data-label="Explication courte">La contraception est un droit et dépend du choix de chacun.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAzX1ExNA==">Cours : Contraception</a></td></tr>
`endif`
`if @err_NAT_V03_Q15 == 1`
<tr><td data-label="Question"><strong>15.</strong> Où peut-on voir la devise de la République ?<br><a href="#U0NSX0NPUlJfREVUQUlMX05BVF9WMDNfUTE1">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Sur les bâtiments publics, notamment les mairies et les écoles.</td><td data-label="Explication courte">La devise « Liberté, Égalité, Fraternité » est visible sur de nombreux bâtiments publics, notamment les mairies et les établissements scolaires.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9OQVRfVjAzX1ExNQ==">Cours : Devise de la République</a><br><a href="#U0NSX0dMT18wMDQ0">Glossaire : Devise de la République</a><br><a href="#U0NSX0dMT18wMjE3">Glossaire : Devise</a></td></tr>
