`if @err_CSP_V03_Q31 == 1`
<tr><td data-label="Question"><strong>31.</strong> Quelle proposition est correcte ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDNfUTMx">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Les partis politiques concourent à l&#x27;expression du suffrage.</td><td data-label="Explication courte">L&#x27;article 4 de la Constitution précise que les partis et groupements politiques concourent à l&#x27;expression du suffrage.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAzX1EzMQ==">Cours : Député</a><br><a href="#U0NSX0dMT18wMDQy">Glossaire : Député</a><br><a href="#U0NSX0dMT18wMTI3">Glossaire : Suffrage universel</a></td></tr>
`endif`
`if @err_CSP_V03_Q32 == 1`
<tr><td data-label="Question"><strong>32.</strong> Quelle réponse donnez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDNfUTMy">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Dans les cinq jours suivant la naissance.</td><td data-label="Explication courte">La naissance d&#x27;un enfant doit être déclarée à la mairie dans les cinq jours qui suivent sa naissance afin d&#x27;établir son acte de naissance.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAzX1EzMg==">Cours : État civil</a><br><a href="#U0NSX0dMT18wMTY2">Glossaire : État civil</a><br><a href="#U0NSX0dMT18wMDg4">Glossaire : Mairie</a></td></tr>
`endif`
`if @err_CSP_V03_Q33 == 1`
<tr><td data-label="Question"><strong>33.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDNfUTMz">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Vert, blanc et rouge.</td><td data-label="Explication courte">Le drapeau tricolore bleu, blanc, rouge est l&#x27;un des symboles officiels de la République française.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAzX1EzMw==">Cours : Drapeau français</a><br><a href="#U0NSX0dMT18wMDQ2">Glossaire : Drapeau français</a></td></tr>
`endif`
`if @err_CSP_V03_Q34 == 1`
<tr><td data-label="Question"><strong>34.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDNfUTM0">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — C&#x27;est le nom donné à l&#x27;hymne national.</td><td data-label="Explication courte">La Marseillaise est l&#x27;hymne national français depuis la Révolution française, chanté lors des cérémonies officielles.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAzX1EzNA==">Cours : La Marseillaise</a><br><a href="#U0NSX0dMT18wMDc4">Glossaire : La Marseillaise</a></td></tr>
`endif`
`if @err_CSP_V03_Q35 == 1`
<tr><td data-label="Question"><strong>35.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDNfUTM1">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Un peintre français du XXᵉ siècle.</td><td data-label="Explication courte">Marc Chagall est un peintre français du XXᵉ siècle, reconnu pour son univers poétique et coloré.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAzX1EzNQ==">Cours : Retenez</a></td></tr>
`endif`
`if @err_CSP_V03_Q36 == 1`
<tr><td data-label="Question"><strong>36.</strong> Que devez-vous faire ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDNfUTM2">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Porter assistance à la personne en danger et alerter les secours.</td><td data-label="Explication courte">Chacun a le devoir de porter assistance à une personne en danger, dans la mesure de ses possibilités, et d&#x27;alerter rapidement les secours.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAzX1EzNg==">Cours : Assistance à personne en danger</a><br><a href="#U0NSX0dMT18wMDA1">Glossaire : Assistance à personne en danger</a><br><a href="#U0NSX0dMT18wMTUy">Glossaire : Secours</a></td></tr>
`endif`
`if @err_CSP_V03_Q37 == 1`
<tr><td data-label="Question"><strong>37.</strong> Qui dirige la commune ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDNfUTM3">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Le maire.</td><td data-label="Explication courte">Le maire est le responsable de la commune. Il met en œuvre les décisions du conseil municipal.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAzX1EzNw==">Cours : Président de la République</a><br><a href="#U0NSX0dMT18wMTA5">Glossaire : Président de la République</a><br><a href="#U0NSX0dMT18wMDI0">Glossaire : Commune</a></td></tr>
`endif`
`if @err_CSP_V03_Q38 == 1`
<tr><td data-label="Question"><strong>38.</strong> En quelle année a-t-elle débuté ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDNfUTM4">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — 1789.</td><td data-label="Explication courte">La Révolution française débute en 1789. Elle marque une étape majeure de l&#x27;histoire de France.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAzX1EzOA==">Cours : Révolution française</a><br><a href="#U0NSX0dMT18wMTE5">Glossaire : Révolution française</a><br><a href="#U0NSX0dMT18wMjI4">Glossaire : Révolution</a></td></tr>
`endif`
`if @err_CSP_V03_Q39 == 1`
<tr><td data-label="Question"><strong>39.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDNfUTM5">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Avoir la nationalité d&#x27;un Etat membre de l&#x27;Union européenne.</td><td data-label="Explication courte">Pour voter aux élections européennes en France, il faut notamment être inscrit sur les listes électorales, être ressortissant d&#x27;un Etat membre de l&#x27;UE, avoir 18 ans, résider en France.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAzX1EzOQ==">Cours : Élections européennes</a><br><a href="#U0NSX0dMT18wMTYw">Glossaire : Élections européennes</a><br><a href="#U0NSX0dMT18wMTM3">Glossaire : Vote</a></td></tr>
`endif`
`if @err_CSP_V03_Q40 == 1`
<tr><td data-label="Question"><strong>40.</strong> Que lui répondez-vous sur le travail non déclaré ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDNfUTQw">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Interdit par la loi.</td><td data-label="Explication courte">Le travail non déclaré est interdit. Il prive notamment le salarié de ses droits sociaux (assurance maladie, retraite, chômage...).</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjAzX1E0MA==">Cours : Travail non déclaré</a></td></tr>
`endif`
