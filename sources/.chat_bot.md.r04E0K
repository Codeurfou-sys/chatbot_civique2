`if @err_CSP_V06_Q01 == 1`
<tr><td data-label="Question"><strong>1.</strong> Est-ce que le président de la République a tous les pouvoirs ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTAx">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Non, les pouvoirs sont séparés entre exécutif, législatif et judiciaire.</td><td data-label="Explication courte">Le président de la République exerce une partie du pouvoir exécutif. Il ne possède pas tous les pouvoirs, car la Constitution organise une séparation entre les pouvoirs exécutif, législatif et judiciaire.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EwMQ==">Cours : Président de la République</a><br><a href="#U0NSX0dMT18wMTA5">Glossaire : Président de la République</a></td></tr>
`endif`
`if @err_CSP_V06_Q02 == 1`
<tr><td data-label="Question"><strong>2.</strong> Qui est le préfet ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTAy">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Le représentant de l&#x27;État dans un département ou une région.</td><td data-label="Explication courte">Le préfet est nommé par le gouvernement. Il représente l&#x27;État et veille notamment à l&#x27;application des lois.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EwMg==">Cours : Préfet</a><br><a href="#U0NSX0dMT18wMTA2">Glossaire : Préfet</a><br><a href="#U0NSX0dMT18wMDQx">Glossaire : Département</a></td></tr>
`endif`
`if @err_CSP_V06_Q03 == 1`
<tr><td data-label="Question"><strong>3.</strong> Quel est le rôle du Parlement ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTAz">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Il vote les lois et contrôle l&#x27;action du gouvernement.</td><td data-label="Explication courte">Le Parlement est composé de l&#x27;Assemblée nationale et du Sénat. Il vote les lois et contrôle l&#x27;action du gouvernement.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EwMw==">Cours : Parlement</a><br><a href="#U0NSX0dMT18wMTAx">Glossaire : Parlement</a><br><a href="#U0NSX0dMT18wMDY2">Glossaire : Gouvernement</a></td></tr>
`endif`
`if @err_CSP_V06_Q04 == 1`
<tr><td data-label="Question"><strong>4.</strong> Que permet la citoyenneté française ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTA0">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Voter, être candidat à une élection et participer à la vie démocratique.</td><td data-label="Explication courte">La citoyenneté française donne des droits civiques, notamment le droit de vote et d&#x27;éligibilité, mais implique également le respect des devoirs du citoyen.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EwNA==">Cours : Citoyenneté</a><br><a href="#U0NSX0dMT18wMDIw">Glossaire : Citoyenneté</a><br><a href="#U0NSX0dMT18wMDQw">Glossaire : Démocratie</a></td></tr>
`endif`
`if @err_CSP_V06_Q05 == 1`
<tr><td data-label="Question"><strong>5.</strong> Que risque une personne qui ne respecte pas la loi ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTA1">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Une sanction prévue par la loi.</td><td data-label="Explication courte">Le non-respect de la loi peut entraîner différentes sanctions décidées par la justice, selon la gravité de l&#x27;infraction.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EwNQ==">Cours : Sanction</a><br><a href="#U0NSX0dMT18wMjI2">Glossaire : Sanction</a></td></tr>
`endif`
`if @err_CSP_V06_Q06 == 1`
<tr><td data-label="Question"><strong>6.</strong> Quel est le rôle de la gendarmerie ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTA2">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Veiller à la sécurité des personnes et des biens et faire respecter la loi.</td><td data-label="Explication courte">La gendarmerie nationale assure des missions de sécurité publique, notamment dans les zones rurales et périurbaines.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EwNg==">Cours : Gendarmerie</a><br><a href="#U0NSX0dMT18wMDY1">Glossaire : Gendarmerie</a></td></tr>
`endif`
`if @err_CSP_V06_Q07 == 1`
<tr><td data-label="Question"><strong>7.</strong> Quel est le rôle de la police ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTA3">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Protéger les personnes et les biens et faire respecter la loi.</td><td data-label="Explication courte">La Police nationale exerce principalement ses missions dans les zones urbaines. Elle agit pour prévenir les infractions, protéger la population et faire respecter la loi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EwNw==">Cours : Police</a><br><a href="#U0NSX0dMT18wMTA0">Glossaire : Police</a></td></tr>
`endif`
`if @err_CSP_V06_Q08 == 1`
<tr><td data-label="Question"><strong>8.</strong> Dans quelle ville se trouve la tour Eiffel ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTA4">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Paris.</td><td data-label="Explication courte">La tour Eiffel se trouve à Paris. Elle a été construite pour l&#x27;Exposition universelle de 1889.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EwOA==">Cours : Tour Eiffel</a><br><a href="#U0NSX0dMT18wMTMw">Glossaire : Tour Eiffel</a><br><a href="#U0NSX0dMT18wMDk1">Glossaire : Musée du Louvre</a></td></tr>
`endif`
`if @err_CSP_V06_Q09 == 1`
<tr><td data-label="Question"><strong>9.</strong> Quand célèbre-t-on Noël ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTA5">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Le 25 décembre.</td><td data-label="Explication courte">Noël est célébré chaque année le 25 décembre. En France, cette date est un jour férié.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EwOQ==">Cours : Noël</a></td></tr>
`endif`
`if @err_CSP_V06_Q10 == 1`
<tr><td data-label="Question"><strong>10.</strong> En quelle année a débuté la Révolution française ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTEw">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — 1789.</td><td data-label="Explication courte">La Révolution française débute en 1789. Elle marque une étape majeure de l&#x27;histoire de France avec la fin de l&#x27;Ancien Régime et la naissance de nouveaux principes comme la liberté et l&#x27;égalité.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1ExMA==">Cours : Révolution française</a><br><a href="#U0NSX0dMT18wMTE5">Glossaire : Révolution française</a><br><a href="#U0NSX0dMT18wMjI4">Glossaire : Révolution</a></td></tr>
`endif`
`if @err_CSP_V06_Q11 == 1`
<tr><td data-label="Question"><strong>11.</strong> Qui était Napoléon Ier ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTEx">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Un empereur français.</td><td data-label="Explication courte">Napoléon Bonaparte devient Napoléon Ier en 1804. Il marque profondément l&#x27;histoire de France par ses réformes et ses conquêtes.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1ExMQ==">Cours : Napoléon Ier</a></td></tr>
`endif`
`if @err_CSP_V06_Q12 == 1`
<tr><td data-label="Question"><strong>12.</strong> Lequel de ces personnages historiques est français ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTEy">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Napoléon Bonaparte.</td><td data-label="Explication courte">Napoléon Bonaparte est une figure majeure de l&#x27;histoire de France. Les autres personnages appartiennent à l&#x27;histoire du Royaume-Uni, de l&#x27;Italie (Gênes) et de l&#x27;Autriche.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1ExMg==">Cours : Napoléon Bonaparte</a><br><a href="#U0NSX0dMT18wMjMx">Glossaire : Napoléon Bonaparte</a></td></tr>
`endif`
`if @err_CSP_V06_Q13 == 1`
<tr><td data-label="Question"><strong>13.</strong> Dans quelle République est-on aujourd&#x27;hui ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTEz">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — La Ve République.</td><td data-label="Explication courte">La France est aujourd&#x27;hui sous la Ve République, instaurée en 1958 avec la Constitution voulue par le général de Gaulle.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1ExMw==">Cours : République actuelle</a></td></tr>
`endif`
`if @err_CSP_V06_Q14 == 1`
<tr><td data-label="Question"><strong>14.</strong> Qu&#x27;est-ce que la Shoah ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTE0">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — L&#x27;extermination des Juifs d&#x27;Europe par le régime nazi pendant la Seconde Guerre mondiale.</td><td data-label="Explication courte">La Shoah est l&#x27;un des plus grands crimes contre l&#x27;humanité de l&#x27;histoire. Elle a entraîné l&#x27;assassinat de près de six millions de Juifs par le régime nazi.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1ExNA==">Cours : Seconde Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTIx">Glossaire : Seconde Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTk0">Glossaire : Shoah</a></td></tr>
`endif`
`if @err_CSP_V06_Q15 == 1`
<tr><td data-label="Question"><strong>15.</strong> Recherchez un pays du monde qui a été colonisé par la France.<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTE1">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — L&#x27;Algérie.</td><td data-label="Explication courte">Pendant plusieurs siècles, la France a constitué un vaste empire colonial en Afrique, en Asie, dans les Caraïbes et en Océanie (Algérie, Sénégal, Madagascar, Indochine...).</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1ExNQ==">Cours : Empire colonial français</a></td></tr>
`endif`
`if @err_CSP_V06_Q16 == 1`
<tr><td data-label="Question"><strong>16.</strong> Qui a rendu l&#x27;école gratuite, laïque et obligatoire ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTE2">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Jules Ferry.</td><td data-label="Explication courte">Les lois Jules Ferry (1881-1882) rendent l&#x27;école primaire gratuite, laïque et obligatoire.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1ExNg==">Cours : Laïcité</a><br><a href="#U0NSX0dMT18wMDgw">Glossaire : Laïcité</a><br><a href="#U0NSX0dMT18wMDQ4">Glossaire : École</a></td></tr>
`endif`
`if @err_CSP_V06_Q17 == 1`
<tr><td data-label="Question"><strong>17.</strong> Pour qui l&#x27;école est-elle obligatoire ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTE3">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Pour tous les enfants de 3 à 16 ans résidant en France.</td><td data-label="Explication courte">L&#x27;instruction est obligatoire pour tous les enfants, français ou étrangers, âgés de 3 à 16 ans et résidant en France.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1ExNw==">Cours : École</a><br><a href="#U0NSX0dMT18wMDQ4">Glossaire : École</a><br><a href="#U0NSX0dMT18wMDEw">Glossaire : Carte de résident</a></td></tr>
`endif`
`if @err_CSP_V06_Q18 == 1`
<tr><td data-label="Question"><strong>18.</strong> Quel diplôme obtient-on à la fin du lycée ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTE4">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Le baccalauréat.</td><td data-label="Explication courte">Le baccalauréat est le diplôme qui marque la fin des études au lycée et permet notamment de poursuivre des études supérieures.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1ExOA==">Cours : Lycée</a><br><a href="#U0NSX0dMT18wMDg2">Glossaire : Lycée</a></td></tr>
`endif`
`if @err_CSP_V06_Q19 == 1`
<tr><td data-label="Question"><strong>19.</strong> Dans quels établissements scolaires vont les élèves après l&#x27;école élémentaire ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTE5">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Le collège.</td><td data-label="Explication courte">Après l&#x27;école élémentaire, les élèves poursuivent leur scolarité au collège. De la sixième à la troisième.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1ExOQ==">Cours : École</a><br><a href="#U0NSX0dMT18wMDQ4">Glossaire : École</a><br><a href="#U0NSX0dMT18wMDIy">Glossaire : Collège</a></td></tr>
`endif`
`if @err_CSP_V06_Q20 == 1`
<tr><td data-label="Question"><strong>20.</strong> Un enfant inscrit à l&#x27;école :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTIw">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Doit fréquenter régulièrement l&#x27;école.</td><td data-label="Explication courte">L&#x27;inscription à l&#x27;école implique une fréquentation régulière. Les absences doivent être justifiées.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EyMA==">Cours : École</a><br><a href="#U0NSX0dMT18wMDQ4">Glossaire : École</a></td></tr>
`endif`
`if @err_CSP_V06_Q21 == 1`
<tr><td data-label="Question"><strong>21.</strong> Les enfants qui ne parlent pas français :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTIx">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Peuvent être accueillis à l&#x27;école et bénéficier d&#x27;un accompagnement pour apprendre le français.</td><td data-label="Explication courte">Tous les enfants résidant en France ont droit à l&#x27;instruction. Des dispositifs spécifiques existent pour accompagner les élèves qui ne maîtrisent pas encore le français.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EyMQ==">Cours : École</a><br><a href="#U0NSX0dMT18wMDQ4">Glossaire : École</a></td></tr>
`endif`
`if @err_CSP_V06_Q22 == 1`
<tr><td data-label="Question"><strong>22.</strong> Quelle est la langue officielle de la République française ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTIy">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Le français.</td><td data-label="Explication courte">L&#x27;article 2 de la Constitution précise que « la langue de la République est le français ». C&#x27;est la langue utilisée par les administrations, les services publics et les institutions.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EyMg==">Cours : Quelle est la langue officielle de la République française ?</a></td></tr>
`endif`
`if @err_CSP_V06_Q23 == 1`
<tr><td data-label="Question"><strong>23.</strong> Quelle est la place de la langue française dans la République ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTIz">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Le français est la langue officielle de la République.</td><td data-label="Explication courte">Le français est la langue officielle de la République. Il est utilisé dans les administrations, les lois, les tribunaux et les services publics.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EyMw==">Cours : Francophonie</a><br><a href="#U0NSX0dMT18wMDYx">Glossaire : Francophonie</a></td></tr>
`endif`
`if @err_CSP_V06_Q24 == 1`
<tr><td data-label="Question"><strong>24.</strong> Quelle liberté permet à chacun d&#x27;exprimer ses idées ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTI0">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — La liberté d&#x27;expression.</td><td data-label="Explication courte">La liberté d&#x27;expression qui permet à chacun d&#x27;exprimer ses opinions et ses idées. Elle s&#x27;exerce dans le respect de la loi et des droits des autres.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EyNA==">Cours : Liberté d’expression</a><br><a href="#U0NSX0dMT18wMjEz">Glossaire : Liberté d’expression</a></td></tr>
`endif`
`if @err_CSP_V06_Q25 == 1`
<tr><td data-label="Question"><strong>25.</strong> Quelle proposition est correcte ? La liberté d&#x27;expression :<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTI1">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Permet d&#x27;exprimer ses idées et ses opinions, dans le respect de la loi et des droits des autres.</td><td data-label="Explication courte">La liberté d&#x27;expression est une liberté fondamentale. Elle permet à chacun d&#x27;exprimer ses idées et ses opinions, mais elle n&#x27;autorise pas les insultes, les menaces, la diffamation, l&#x27;incitation à la haine ou les propos discriminatoires.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EyNQ==">Cours : Liberté d’expression</a><br><a href="#U0NSX0dMT18wMjEz">Glossaire : Liberté d’expression</a><br><a href="#U0NSX0dMT18wMTc0">Glossaire : Respect</a></td></tr>
`endif`
`if @err_CSP_V06_Q26 == 1`
<tr><td data-label="Question"><strong>26.</strong> Combien y a-t-il de départements en France ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTI2">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — 101.</td><td data-label="Explication courte">La France compte 101 départements : 96 en métropole et 5 départements d&#x27;outre-mer.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EyNg==">Cours : Département</a><br><a href="#U0NSX0dMT18wMDQx">Glossaire : Département</a></td></tr>
`endif`
`if @err_CSP_V06_Q27 == 1`
<tr><td data-label="Question"><strong>27.</strong> Qui représente l&#x27;État dans un département ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTI3">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Le préfet.</td><td data-label="Explication courte">Le préfet représente l&#x27;État dans le département. Il veille notamment à l&#x27;application des lois et coordonne les services de l&#x27;État.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EyNw==">Cours : Département</a><br><a href="#U0NSX0dMT18wMDQx">Glossaire : Département</a><br><a href="#U0NSX0dMT18wMTA2">Glossaire : Préfet</a></td></tr>
`endif`
`if @err_CSP_V06_Q28 == 1`
<tr><td data-label="Question"><strong>28.</strong> Qui dirige la commune ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NTUF9WMDZfUTI4">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Le maire.</td><td data-label="Explication courte">Le maire est le responsable de la commune. Il met en œuvre les décisions du conseil municipal et gère les affaires de la commune.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DU1BfVjA2X1EyOA==">Cours : Commune</a><br><a href="#U0NSX0dMT18wMDI0">Glossaire : Commune</a><br><a href="#U0NSX0dMT18wMDg3">Glossaire : Maire</a></td></tr>
`endif`
</tbody></table>
`endif`
