`endif`
`if @err_CR_V08_Q18 == 1`
<tr><td data-label="Question"><strong>18.</strong> Quel est le rôle de la police ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwOF9RMTg=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Protéger les personnes, faire respecter la loi et maintenir l&#x27;ordre public.</td><td data-label="Explication courte">La police assure la sécurité des personnes et des biens, fait respecter la loi et contribue au maintien de l&#x27;ordre public.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDhfUTE4">Cours : Police</a><br><a href="#U0NSX0dMT18wMTA0">Glossaire : Police</a><br><a href="#U0NSX0dMT18wMDk5">Glossaire : Ordre public</a></td></tr>
`endif`
`if @err_CR_V08_Q19 == 1`
<tr><td data-label="Question"><strong>19.</strong> Quel est un exemple d&#x27;assistance à personne en danger ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwOF9RMTk=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Porter secours ou appeler les services d&#x27;urgence.</td><td data-label="Explication courte">En France, porter assistance à une personne en danger est une obligation prévue par la loi, lorsque cela est possible sans risque pour soi-même ou pour les autres.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDhfUTE5">Cours : Assistance à personne en danger</a><br><a href="#U0NSX0dMT18wMDA1">Glossaire : Assistance à personne en danger</a><br><a href="#U0NSX0dMT18wMTUy">Glossaire : Secours</a></td></tr>
`endif`
`if @err_CR_V08_Q20 == 1`
<tr><td data-label="Question"><strong>20.</strong> Quel exemple illustre une limitation de liberté pour protéger l&#x27;intérêt général ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwOF9RMjA=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — L&#x27;interdiction de conduire après avoir consommé de l&#x27;alcool.</td><td data-label="Explication courte">Certaines libertés peuvent être limitées pour protéger l&#x27;intérêt général. L&#x27;interdiction de conduire sous l&#x27;emprise de l&#x27;alcool protège la sécurité de tous.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDhfUTIw">Cours : Intérêt général</a><br><a href="#U0NSX0dMT18wMTcz">Glossaire : Intérêt général</a></td></tr>
`endif`
`if @err_CR_V08_Q21 == 1`
<tr><td data-label="Question"><strong>21.</strong> Quelle est l&#x27;attitude à avoir lorsque l&#x27;on est témoin de violences ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwOF9RMjE=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Alerter les secours, la police ou la gendarmerie.</td><td data-label="Explication courte">Face à des violences, il est important d&#x27;agir en alertant les secours ou les forces de l&#x27;ordre, sans se mettre soi-même en danger.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDhfUTIx">Cours : Violence</a><br><a href="#U0NSX0dMT18wMTM2">Glossaire : Violence</a><br><a href="#U0NSX0dMT18wMDA1">Glossaire : Assistance à personne en danger</a></td></tr>
`endif`
`if @err_CR_V08_Q22 == 1`
<tr><td data-label="Question"><strong>22.</strong> Quel continent a été le plus concerné par la décolonisation française après la Seconde Guerre mondiale ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwOF9RMjI=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — L&#x27;Afrique.</td><td data-label="Explication courte">Après la Seconde Guerre mondiale, de nombreux territoires français situés en Afrique accèdent progressivement à l&#x27;indépendance.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDhfUTIy">Cours : Seconde Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTIx">Glossaire : Seconde Guerre mondiale</a></td></tr>
`endif`
`if @err_CR_V08_Q23 == 1`
<tr><td data-label="Question"><strong>23.</strong> Que fête-t-on le 8 mai ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwOF9RMjM=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — La fin de la seconde guerre mondiale.</td><td data-label="Explication courte">Le 8 mai est un jour férié en France. Il commémore la victoire des Alliés sur l&#x27;Allemagne nazie en 1945 et rend hommage aux combattants et aux victimes de la Seconde Guerre mondiale.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDhfUTIz">Cours : Seconde Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTIx">Glossaire : Seconde Guerre mondiale</a></td></tr>
`endif`
`if @err_CR_V08_Q24 == 1`
<tr><td data-label="Question"><strong>24.</strong> Citez une mer ou un océan qui borde la France métropolitaine.<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwOF9RMjQ=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — La mer Méditerranée.</td><td data-label="Explication courte">La France métropolitaine est bordée par quatre espaces maritimes : la Manche, la mer du Nord, l&#x27;océan Atlantique et la mer Méditerranée.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDhfUTI0">Cours : France métropolitaine</a><br><a href="#U0NSX0dMT18wMDU4">Glossaire : France métropolitaine</a><br><a href="#U0NSX0dMT18wMjAz">Glossaire : Méditerranée</a></td></tr>
`endif`
`if @err_CR_V08_Q25 == 1`
<tr><td data-label="Question"><strong>25.</strong> Quel pays a une frontière terrestre avec la France métropolitaine ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwOF9RMjU=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Espagne.</td><td data-label="Explication courte">La France métropolitaine partage une frontière terrestre avec huit pays.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDhfUTI1">Cours : France métropolitaine</a><br><a href="#U0NSX0dMT18wMDU4">Glossaire : France métropolitaine</a></td></tr>
`endif`
`if @err_CR_V08_Q26 == 1`
<tr><td data-label="Question"><strong>26.</strong> Quelle ville française est un port maritime ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwOF9RMjY=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Marseille.</td><td data-label="Explication courte">Marseille est le plus grand port maritime français et l&#x27;un des plus importants ports de la mer Méditerranée.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDhfUTI2">Cours : Provence-Alpes-Côte d&#x27;Azur</a><br><a href="#U0NSX0dMT18wMTE0">Glossaire : Provence-Alpes-Côte d&#x27;Azur</a></td></tr>
`endif`
`if @err_CR_V08_Q27 == 1`
<tr><td data-label="Question"><strong>27.</strong> Quelle mer se situe entre la France et l&#x27;Angleterre ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwOF9RMjc=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — La Manche.</td><td data-label="Explication courte">La Manche sépare la France de l&#x27;Angleterre. Elle est traversée notamment par le tunnel sous la Manche.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDhfUTI3">Cours : Quelle mer se situe entre la France et l&#x27;Angleterre ?</a></td></tr>
`endif`
`if @err_CR_V08_Q28 == 1`
<tr><td data-label="Question"><strong>28.</strong> Qu&#x27;est-ce que la France d&#x27;outre-mer ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwOF9RMjg=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Les territoires français situés en dehors de l&#x27;Europe.</td><td data-label="Explication courte">La France d&#x27;outre-mer regroupe les départements, régions, collectivités et territoires français situés en dehors de l&#x27;Europe, comme la Guadeloupe, La Réunion ou la Polynésie française.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDhfUTI4">Cours : Outre-mer</a><br><a href="#U0NSX0dMT18wMTAw">Glossaire : Outre-mer</a></td></tr>
`endif`
</tbody></table>
`endif`
