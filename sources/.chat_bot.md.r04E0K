`if @err_CR_V06_Q31 == 1`
<tr><td data-label="Question"><strong>31.</strong> Quelle est cette population ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMzE=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — 68 millions.</td><td data-label="Explication courte">En 2025, la France compte environ 68 millions d&#x27;habitants. Ce chiffre peut évoluer légèrement au fil des années.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTMx">Cours : Population France</a></td></tr>
`endif`
`if @err_CR_V06_Q32 == 1`
<tr><td data-label="Question"><strong>32.</strong> Quel tribunal traite ce type de litige ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMzI=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Le conseil de prud&#x27;hommes.</td><td data-label="Explication courte">Le conseil de prud&#x27;hommes est un tribunal spécialisé qui traite les litiges individuels liés au contrat de travail entre salariés et employeurs.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTMy">Cours : Justice</a><br><a href="#U0NSX0dMT18wMDc3">Glossaire : Justice</a></td></tr>
`endif`
`if @err_CR_V06_Q33 == 1`
<tr><td data-label="Question"><strong>33.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMzM=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Tous les cinq ans.</td><td data-label="Explication courte">Les citoyens des États membres de l&#x27;Union européenne élisent leurs députés européens tous les cinq ans, une fréquence différente de celle des élections municipales ou sénatoriales françaises.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTMz">Cours : Élections européennes</a><br><a href="#U0NSX0dMT18wMTYw">Glossaire : Élections européennes</a><br><a href="#U0NSX0dMT18wMDUw">Glossaire : Élection</a></td></tr>
`endif`
`if @err_CR_V06_Q34 == 1`
<tr><td data-label="Question"><strong>34.</strong> Peut-il obtenir ce traitement prioritaire pour ce motif ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMzQ=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Non, il doit accéder au service dans les mêmes conditions que tous les usagers.</td><td data-label="Explication courte">Les usagers des services publics bénéficient d&#x27;un égal accès au service, sans discrimination ni traitement de faveur fondé sur des convictions religieuses.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTM0">Cours : Service public</a><br><a href="#U0NSX0dMT18wMTI1">Glossaire : Service public</a><br><a href="#U0NSX0dMT18wMDg4">Glossaire : Mairie</a></td></tr>
`endif`
`if @err_CR_V06_Q35 == 1`
<tr><td data-label="Question"><strong>35.</strong> Laquelle de ces villes est un port maritime ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMzU=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Marseille.</td><td data-label="Explication courte">Marseille est le plus grand port maritime français et l&#x27;un des plus importants ports de la mer Méditerranée.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTM1">Cours : Provence-Alpes-Côte d&#x27;Azur</a><br><a href="#U0NSX0dMT18wMTE0">Glossaire : Provence-Alpes-Côte d&#x27;Azur</a></td></tr>
`endif`
`if @err_CR_V06_Q36 == 1`
<tr><td data-label="Question"><strong>36.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMzY=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Le Premier ministre.</td><td data-label="Explication courte">Selon la Constitution, le Premier ministre dirige l&#x27;action du gouvernement et veille à l&#x27;exécution des lois. Le président de la République, lui, est le chef de l&#x27;État.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTM2">Cours : Gouvernement</a><br><a href="#U0NSX0dMT18wMDY2">Glossaire : Gouvernement</a><br><a href="#U0NSX0dMT18wMTA3">Glossaire : Premier ministre</a></td></tr>
`endif`
`if @err_CR_V06_Q37 == 1`
<tr><td data-label="Question"><strong>37.</strong> L&#x27;inscription à l&#x27;Assurance maladie est-elle facultative ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMzc=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Obligatoire.</td><td data-label="Explication courte">L&#x27;Assurance maladie est un élément essentiel du système de protection sociale français. Les personnes qui remplissent les conditions prévues doivent y être affiliées.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTM3">Cours : Assurance maladie</a><br><a href="#U0NSX0dMT18wMDA2">Glossaire : Assurance maladie</a></td></tr>
`endif`
`if @err_CR_V06_Q38 == 1`
<tr><td data-label="Question"><strong>38.</strong> Laquelle choisissez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMzg=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Le 14 juillet.</td><td data-label="Explication courte">Le 14 juillet est la fête nationale française. Elle commémore la prise de la Bastille en 1789 et la Fête de la Fédération de 1790.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTM4">Cours : Fête nationale</a><br><a href="#U0NSX0dMT18wMDU3">Glossaire : Fête nationale</a></td></tr>
`endif`
`if @err_CR_V06_Q39 == 1`
<tr><td data-label="Question"><strong>39.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RMzk=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — La volonté générale, exprimée par les représentants élus au Parlement.</td><td data-label="Explication courte">La Déclaration des droits de l&#x27;homme et du citoyen de 1789 affirme que « La loi est l&#x27;expression de la volonté générale ».</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTM5">Cours : Parlement</a><br><a href="#U0NSX0dMT18wMTAx">Glossaire : Parlement</a></td></tr>
`endif`
`if @err_CR_V06_Q40 == 1`
<tr><td data-label="Question"><strong>40.</strong> Quelle est l&#x27;attitude à adopter ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNl9RNDA=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Alerter les secours, la police ou la gendarmerie.</td><td data-label="Explication courte">Face à des violences, il est important d&#x27;agir en alertant les secours ou les forces de l&#x27;ordre, sans se mettre soi-même en danger en intervenant physiquement.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDZfUTQw">Cours : Violence</a><br><a href="#U0NSX0dMT18wMTM2">Glossaire : Violence</a><br><a href="#U0NSX0dMT18wMDA1">Glossaire : Assistance à personne en danger</a></td></tr>
