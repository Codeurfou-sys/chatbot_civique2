`if @err_CR_V04_Q30 == 1`
<tr><td data-label="Question"><strong>30.</strong> Quelle réponse donnez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMzA=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Liberté, Égalité, Fraternité.</td><td data-label="Explication courte">La devise de la République française est « Liberté, Égalité, Fraternité ». Elle exprime les valeurs fondamentales de la République et figure sur les frontons des bâtiments publics.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTMw">Cours : Devise</a><br><a href="#U0NSX0dMT18wMjE3">Glossaire : Devise</a><br><a href="#U0NSX0dMT18wMDQ0">Glossaire : Devise de la République</a></td></tr>
`endif`
`if @err_CR_V04_Q31 == 1`
<tr><td data-label="Question"><strong>31.</strong> Qu&#x27;est-ce qui a réellement changé pour les femmes en 1944 ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMzE=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Elles ont obtenu le droit de vote et d&#x27;éligibilité.</td><td data-label="Explication courte">L&#x27;ordonnance du 21 avril 1944 accorde aux femmes le droit de vote et d&#x27;éligibilité. Elles votent pour la première fois en 1945.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTMx">Cours : Vote</a><br><a href="#U0NSX0dMT18wMTM3">Glossaire : Vote</a><br><a href="#U0NSX0dMT18wMTU3">Glossaire : Éligibilité</a></td></tr>
`endif`
`if @err_CR_V04_Q32 == 1`
<tr><td data-label="Question"><strong>32.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMzI=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Oui, si elle donne procuration à une autre personne dans les conditions prévues par la loi.</td><td data-label="Explication courte">Le vote est personnel : on ne peut pas voter directement avec la carte électorale d&#x27;une autre personne.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTMy">Cours : Vote</a><br><a href="#U0NSX0dMT18wMTM3">Glossaire : Vote</a><br><a href="#U0NSX0dMT18wMTEx">Glossaire : Procuration</a></td></tr>
`endif`
`if @err_CR_V04_Q33 == 1`
<tr><td data-label="Question"><strong>33.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMzM=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — C&#x27;est interdit et passible d&#x27;une sanction.</td><td data-label="Explication courte">Jeter un mégot sur la voie publique est interdit, que quelqu&#x27;un observe la scène ou non. Ce geste pollue l&#x27;environnement et peut être sanctionné par une amende.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTMz">Cours : Sanction</a><br><a href="#U0NSX0dMT18wMjI2">Glossaire : Sanction</a></td></tr>
`endif`
`if @err_CR_V04_Q34 == 1`
<tr><td data-label="Question"><strong>34.</strong> Que garantit le principe de confidentialité dans le domaine de la santé ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMzQ=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Les informations médicales d&#x27;un patient sont protégées par le secret médical.</td><td data-label="Explication courte">Le secret médical protège la vie privée des patients. Les professionnels de santé doivent respecter la confidentialité des informations qu&#x27;ils connaissent dans l&#x27;exercice de leur métier, y compris vis-à-vis de l&#x27;employeur.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTM0">Cours : Confidentialité des informations médicales</a></td></tr>
`endif`
`if @err_CR_V04_Q35 == 1`
<tr><td data-label="Question"><strong>35.</strong> Quelle est la définition la plus complète ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMzU=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — La séparation des Églises et de l&#x27;État, garantissant la liberté de conscience.</td><td data-label="Explication courte">La laïcité repose sur la séparation des Églises et de l&#x27;État, instaurée par la loi de 1905.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTM1">Cours : Laïcité</a><br><a href="#U0NSX0dMT18wMDgw">Glossaire : Laïcité</a><br><a href="#U0NSX0dMT18wMDgz">Glossaire : Liberté de conscience</a></td></tr>
`endif`
`if @err_CR_V04_Q36 == 1`
<tr><td data-label="Question"><strong>36.</strong> Laquelle de ces citations est inscrite dans ce texte ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMzY=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — « Les hommes naissent et demeurent libres et égaux en droits. »</td><td data-label="Explication courte">L&#x27;article 1er de la Déclaration des droits de l&#x27;homme et du citoyen de 1789 affirme que tous les êtres humains naissent libres et égaux en droits.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTM2">Cours : Droits fondamentaux</a><br><a href="#U0NSX0dMT18wMDQ3">Glossaire : Droits fondamentaux</a><br><a href="#U0NSX0dMT18wMDM4">Glossaire : Déclaration des droits de l&#x27;homme et du citoyen</a></td></tr>
`endif`
`if @err_CR_V04_Q37 == 1`
<tr><td data-label="Question"><strong>37.</strong> De quel musée s&#x27;agit-il ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMzc=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Le musée du Louvre.</td><td data-label="Explication courte">Le musée du Louvre est situé à Paris. C&#x27;est l&#x27;un des plus grands musées du monde et il abrite notamment la Joconde.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTM3">Cours : Musée du Louvre</a><br><a href="#U0NSX0dMT18wMDk1">Glossaire : Musée du Louvre</a><br><a href="#U0NSX0dMT18wMTMw">Glossaire : Tour Eiffel</a></td></tr>
`endif`
`if @err_CR_V04_Q38 == 1`
<tr><td data-label="Question"><strong>38.</strong> Que répondez-vous pour corriger cette idée ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMzg=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Il n&#x27;est pas au-dessus des lois, mais bénéficie d&#x27;une inviolabilité durant son mandat, sauf exceptions prévues par la Constitution.</td><td data-label="Explication courte">Le président de la République n&#x27;est pas au-dessus des lois.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTM4">Cours : Président de la République</a><br><a href="#U0NSX0dMT18wMTA5">Glossaire : Président de la République</a><br><a href="#U0NSX0dMT18wMDM3">Glossaire : Crime</a></td></tr>
`endif`
`if @err_CR_V04_Q39 == 1`
<tr><td data-label="Question"><strong>39.</strong> De qui s&#x27;agit-il ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RMzk=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Jean Moulin.</td><td data-label="Explication courte">Jean Moulin est l&#x27;une des principales figures de la Résistance française. Il a contribué à unifier les mouvements de résistance à la demande du général de Gaulle.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTM5">Cours : Seconde Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTIx">Glossaire : Seconde Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTkz">Glossaire : Résistance</a></td></tr>
`endif`
`if @err_CR_V04_Q40 == 1`
<tr><td data-label="Question"><strong>40.</strong> Quel est le rôle du Défenseur des droits, que vous lui conseillez de contacter ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwNF9RNDA=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Il protège les droits et les libertés des personnes, notamment contre les discriminations.</td><td data-label="Explication courte">Le Défenseur des droits est une autorité indépendante qui aide les personnes dont les droits ne sont pas respectés et lutte notamment contre les discriminations, sans exercer de pouvoir judiciaire ou exécutif.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDRfUTQw">Cours : Quel est le rôle du Défenseur des droits, que vous lui conseillez de contacter ?</a></td></tr>
`endif`
