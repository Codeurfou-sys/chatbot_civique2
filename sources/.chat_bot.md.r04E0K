`if @err_CR_V07_Q29 == 1`
<tr><td data-label="Question"><strong>29.</strong> Quel continent choisissez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwN19RMjk=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — L&#x27;Afrique.</td><td data-label="Explication courte">Après la Seconde Guerre mondiale, de nombreux territoires français situés en Afrique accèdent progressivement à l&#x27;indépendance.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDdfUTI5">Cours : Seconde Guerre mondiale</a><br><a href="#U0NSX0dMT18wMTIx">Glossaire : Seconde Guerre mondiale</a></td></tr>
`endif`
`if @err_CR_V07_Q30 == 1`
<tr><td data-label="Question"><strong>30.</strong> Qui peut le demander ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwN19RMzA=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Le père ou la mère.</td><td data-label="Explication courte">Le congé parental permet à un parent, le père ou la mère, de réduire ou de suspendre temporairement son activité professionnelle pour s&#x27;occuper de son enfant.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDdfUTMw">Cours : Congé parental</a></td></tr>
`endif`
`if @err_CR_V07_Q31 == 1`
<tr><td data-label="Question"><strong>31.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwN19RMzE=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Le juge, dans le respect de la loi.</td><td data-label="Explication courte">La police ou la gendarmerie enquêtent sur les infractions et interpellent les suspects, mais c&#x27;est le juge qui décide de la sanction, dans le respect de la loi et après un procès équitable.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDdfUTMx">Cours : Juge</a><br><a href="#U0NSX0dMT18wMTgw">Glossaire : Juge</a><br><a href="#U0NSX0dMT18wMTc0">Glossaire : Respect</a></td></tr>
`endif`
`if @err_CR_V07_Q32 == 1`
<tr><td data-label="Question"><strong>32.</strong> Quel était ce surnom ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwN19RMzI=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Le Roi-Soleil.</td><td data-label="Explication courte">Louis XIV (1638-1715) est surnommé le Roi-Soleil. Son règne est l&#x27;un des plus longs de l&#x27;histoire de France et il a renforcé le pouvoir de la monarchie.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDdfUTMy">Cours : Château de Versailles</a><br><a href="#U0NSX0dMT18wMDE3">Glossaire : Château de Versailles</a></td></tr>
`endif`
`if @err_CR_V07_Q33 == 1`
<tr><td data-label="Question"><strong>33.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwN19RMzM=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Non, la France est fondée sur la séparation des pouvoirs.</td><td data-label="Explication courte">La France est une démocratie fondée sur la séparation des pouvoirs. Le président exerce des responsabilités importantes, mais ne détient pas tous les pouvoirs et ne peut pas modifier les lois seul.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDdfUTMz">Cours : Président de la République</a><br><a href="#U0NSX0dMT18wMTA5">Glossaire : Président de la République</a><br><a href="#U0NSX0dMT18wMjEx">Glossaire : Séparation des pouvoirs</a></td></tr>
`endif`
`if @err_CR_V07_Q34 == 1`
<tr><td data-label="Question"><strong>34.</strong> Qui peut demander à avorter, selon la loi française ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwN19RMzQ=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Toute femme enceinte qui remplit les conditions prévues par la loi.</td><td data-label="Explication courte">En France, une femme enceinte peut demander une interruption volontaire de grossesse (IVG) dans les conditions fixées par la loi. Cette décision lui appartient, sans avoir besoin de l&#x27;accord d&#x27;un tiers.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDdfUTM0">Cours : Qui peut demander à avorter, selon la loi française ?</a></td></tr>
`endif`
`if @err_CR_V07_Q35 == 1`
<tr><td data-label="Question"><strong>35.</strong> Que lui répondez-vous ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwN19RMzU=">Détails</a></td><td data-label="Réponse correcte"><strong>C</strong> — Elle peut exprimer ses opinions, mais dans le respect de la loi et des autres.</td><td data-label="Explication courte">La liberté d&#x27;expression est une liberté fondamentale, mais elle n&#x27;est pas absolue : elle permet d&#x27;exprimer ses idées à condition de respecter la loi (pas d&#x27;injure, de diffamation ni d&#x27;incitation à la haine) et les autres personnes.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDdfUTM1">Cours : Liberté d’expression</a><br><a href="#U0NSX0dMT18wMjEz">Glossaire : Liberté d’expression</a><br><a href="#U0NSX0dMT18wMTc0">Glossaire : Respect</a></td></tr>
`endif`
`if @err_CR_V07_Q36 == 1`
<tr><td data-label="Question"><strong>36.</strong> Comment ce vers se poursuit-il ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwN19RMzY=">Détails</a></td><td data-label="Réponse correcte"><strong>A</strong> — Le jour de gloire est arrivé.</td><td data-label="Explication courte">Ces paroles ouvrent la Marseillaise, l&#x27;hymne national de la République française : « Allons enfants de la Patrie, le jour de gloire est arrivé. » Les autres propositions n&#x27;ont aucun lien avec l&#x27;hymne.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDdfUTM2">Cours : La Marseillaise</a><br><a href="#U0NSX0dMT18wMDc4">Glossaire : La Marseillaise</a></td></tr>
`endif`
`if @err_CR_V07_Q37 == 1`
<tr><td data-label="Question"><strong>37.</strong> Quelle obligation concerne pourtant toutes les personnes résidant en France, quelle que soit leur nationalité ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwN19RMzc=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — Respecter la loi.</td><td data-label="Explication courte">Toutes les personnes vivant en France, quelle que soit leur nationalité, doivent respecter les lois françaises. Voter ou être citoyen sont des droits ou statuts, pas des obligations générales.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDdfUTM3">Cours : Carte de résident</a><br><a href="#U0NSX0dMT18wMDEw">Glossaire : Carte de résident</a><br><a href="#U0NSX0dMT18wMDIw">Glossaire : Citoyenneté</a></td></tr>
`endif`
`if @err_CR_V07_Q38 == 1`
<tr><td data-label="Question"><strong>38.</strong> Quelle est cette mer ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwN19RMzg=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — La Manche.</td><td data-label="Explication courte">La Manche sépare la France de l&#x27;Angleterre. Elle est traversée notamment par le tunnel sous la Manche.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDdfUTM4">Cours : Quelle est cette mer ?</a></td></tr>
`endif`
`if @err_CR_V07_Q39 == 1`
<tr><td data-label="Question"><strong>39.</strong> Qu&#x27;est-ce que l&#x27;Hôtel de Matignon exactement ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwN19RMzk=">Détails</a></td><td data-label="Réponse correcte"><strong>D</strong> — La résidence officielle et le lieu de travail du Premier ministre.</td><td data-label="Explication courte">L&#x27;Hôtel de Matignon, situé à Paris, est le lieu où le Premier ministre exerce ses principales fonctions. Le président de la République réside et travaille, lui, au palais de l&#x27;Élysée.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDdfUTM5">Cours : Premier ministre</a><br><a href="#U0NSX0dMT18wMTA3">Glossaire : Premier ministre</a><br><a href="#U0NSX0dMT18wMDkz">Glossaire : Ministre</a></td></tr>
`endif`
`if @err_CR_V07_Q40 == 1`
<tr><td data-label="Question"><strong>40.</strong> Quelles sont les conditions réelles pour en bénéficier ?<br><a href="#U0NSX0NPUlJfREVUQUlMX0NSX1YwN19RNDA=">Détails</a></td><td data-label="Réponse correcte"><strong>B</strong> — Avoir travaillé et remplir les conditions prévues par la réglementation.</td><td data-label="Explication courte">Les allocations chômage sont versées aux personnes qui remplissent les conditions prévues par la réglementation, notamment une durée minimale d&#x27;activité et une inscription auprès de France Travail.</td><td data-label="Notion à revoir"><a href="#U0NSX1JFVl9QT0lOVF9DUl9WMDdfUTQw">Cours : Quelles sont les conditions réelles pour en bénéficier ?</a></td></tr>
`endif`
